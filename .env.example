# PostgreSQL (Railway fornece automaticamente)
DATABASE_URL=postgresql://user:pass@host:port/dbname

# Discord OAuth (criar app em https://discord.com/developers/applications)
DISCORD_CLIENT_ID=seu_client_id
DISCORD_CLIENT_SECRET=seu_client_secret
DISCORD_CALLBACK_URL=https://seu-app.railway.app/auth/discord/callback

# Sessão
SESSION_SECRET=gerar_uma_string_aleatoria_longa

# API Key pro Roblox (gerar uma string aleatória)
ROBLOX_API_KEY=gerar_uma_chave_aleatoria_forte

# URL base do site
BASE_URL=https://seu-app.railway.app

# Porta (Railway define automaticamente)
PORT=3000
