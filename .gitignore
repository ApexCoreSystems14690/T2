*.blend1
*.fbx
*.obj
*.psd
*.kra
*.mp4
*.mov
*.mkv
*.wav
*.mp3
*.zip
*.7z
*.rar
mcp-remote-devices-blob-*

# [10/10] place/modelo do Roblox: backup de place NAO e codigo do site, pesa e pode
# carregar script com chave de producao (SiteConfig). Fica no PC ou no Drive.
*.rbxl
*.rbxlx
*.rbxm
*.rbxmx

# vault do Obsidian: a config da janela muda a cada abertura e suja todo commit.
# As NOTAS (.md) continuam versionadas.
**/.obsidian/
**/.trash/

# [30/09] backup dos perfis do ProfileService: sao DADOS DE JOGADOR (dinheiro,
# inventario, casas) tirados do DataStore por Open Cloud. Os scripts ficam no
# repo, os perfis NAO -- nem pra repo privado.
backup_perfis/perfis_*/
backup_perfis/*.json
backup_perfis/*.csv

# dump de banco: dado de jogador de producao. O seed.sql (dado de exemplo) fica.
*.dump
*.sqlite
*.sqlite3
*.db
backup*.sql
dump*.sql
*.sql.gz
