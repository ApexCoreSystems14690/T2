    function closeItem() { $('rmodal').classList.remove('active'); RITEM = null; }
    async function submitItem() {
      if (!RITEM) return;
      const item = $('ri-item').value.trim(), qtd = Number($('ri-qtd').value) || 1;
      if (!item) return showAlert('Escolha ou digite um item', 'error');
      try {
        const r = await api('POST', '/registro/item', { roblox_id: RITEM.roblox_id, item, qtd });
        showAlert(r.modo === 'online' ? (qtd + 'x ' + item + ' enviado agora') : (qtd + 'x ' + item + ' na fila — entrega quando logar'), 'success');
        closeItem();
        setTimeout(loadRegistro, 1500);
      } catch (e) { showAlert(e.message, 'error'); }
    }
    async function apagarUm(rid) {
      const p = (REG.players || []).find(x => Number(x.roblox_id) === Number(rid));
      if (!confirm('Apagar o registro de ' + ((p && p.nome) || rid) + '?')) return;
      try { const r = await api('POST', '/registro/apagar', { roblox_id: Number(rid) }); showAlert(r.apagados + ' registro(s) apagado(s)', 'success'); REG_SEL.delete(Number(rid)); loadRegistro(); } catch (e) { showAlert(e.message, 'error'); }
    }
    async function apagarLote() {
      const ids = Array.from(REG_SEL);
      if (!ids.length) return;
      if (!confirm('Apagar ' + ids.length + ' registro(s) selecionado(s)? Não tem volta.')) return;
      try { const r = await api('POST', '/registro/apagar', { roblox_ids: ids }); showAlert(r.apagados + ' registro(s) apagado(s)', 'success'); REG_SEL.clear(); loadRegistro(); } catch (e) { showAlert(e.message, 'error'); }
    }
    async function wipeGeral() {
      const t = prompt('WIPE GERAL — apaga TODO o registro de jogadores, a fila de itens e os logs do jogo. NÃO tem volta.\n\n(Isso NÃO reseta o dinheiro/inventário salvo no jogo — só o registro do painel.)\n\nDigite WIPE pra confirmar:');
      if (t !== 'WIPE') { if (t !== null) showAlert('Wipe cancelado (precisa digitar WIPE)', 'error'); return; }
      try {
        const r = await api('POST', '/registro/wipe', { confirm: 'WIPE' });
        showAlert('Wipe feito: ' + r.jogadores + ' jogadores, ' + r.fila + ' fila, ' + r.logs + ' logs apagados', 'success');
        REG_SEL.clear(); loadRegistro();
      } catch (e) { showAlert(e.message, 'error'); }
    }
    async function darItemTodos() {
      const item = ($('dt-item').value || '').trim(); const qtd = Number($('dt-qtd').value) || 1;
      if (!item) return showAlert('Escolha um item', 'error');
      const offline = $('dt-offline').checked;
      if (!confirm('Dar ' + qtd + 'x "' + item + '" pra TODOS' + (offline ? ' (online agora + offline no próximo login)' : ' os jogadores ONLINE agora') + '?')) return;
      try {
        const r = await api('POST', '/registro/dar-todos', { tipo: 'item_add', item, qtd, offline });
        showAlert('Item dado: ' + r.online + ' online' + (r.fila ? (' + ' + r.fila + ' na fila (offline)') : ''), 'success');
      } catch (e) { showAlert(e.message, 'error'); }
    }
    async function darCarroTodos() {
      const carro = ($('dt-carro').value || '').trim();
      if (!carro) return showAlert('Escolha um carro', 'error');
      if (!confirm('Dar o carro "' + carro + '" pra TODOS os jogadores ONLINE agora?\n\n(Carro só vai pros online — offline não tem fila de carro.)')) return;
      try {
        const r = await api('POST', '/registro/dar-todos', { tipo: 'carro_add', carro });
        showAlert('Carro dado a ' + r.online + ' jogador(es) online', 'success');
      } catch (e) { showAlert(e.message, 'error'); }
    }
  </script>
</body>
</html>
