    }
    (function () {
      const inp = $('cg-user'), list = $('cg-list');
      function render() {
        const q = inp.value.toLowerCase().trim();
        const us = USERS.filter(u => !q || [u.discord_username, u.roblox_username, u.roblox_id, u.id].some(v => v != null && String(v).toLowerCase().includes(q))).slice(0, 40);
        list.innerHTML = us.length ? us.map(u => '<div class="picker-item" data-id="' + u.id + '"><div>' + (u.is_placeholder ? '(sem Discord)' : esc(u.discord_username)) + '</div><div class="m">' + (u.roblox_username ? esc(u.roblox_username) + ' · ' : '') + (u.roblox_id || 'sem Roblox') + '</div></div>').join('') : '<div class="picker-item muted">Nenhum</div>';
        list.classList.add('open');
      }
      inp.addEventListener('focus', async () => { if (!USERS.length) USERS = (await api('GET', '/users')).users; render(); });
      inp.addEventListener('input', () => { CG_SEL = null; $('cg-picked').textContent = ''; render(); });
      list.addEventListener('mousedown', e => { const it = e.target.closest('.picker-item'); if (!it || !it.dataset.id) return; CG_SEL = USERS.find(u => String(u.id) === it.dataset.id); inp.value = CG_SEL.discord_username || CG_SEL.roblox_username || ('#' + CG_SEL.id); $('cg-picked').textContent = 'Selecionado: ' + inp.value + (CG_SEL.roblox_id ? ' (Roblox ' + CG_SEL.roblox_id + ')' : ' — sem Roblox vinculado, não funciona no jogo ainda'); list.classList.remove('open'); });
      document.addEventListener('click', e => { if (!e.target.closest('#panel-cargos .picker')) list.classList.remove('open'); });
    })();
    async function setCargo(remover) {
      if (!CG_SEL) return showAlert('Selecione um usuário', 'error');
      try {
        await api('POST', '/cargo', { user_id: CG_SEL.id, corp_id: Number($('cg-corp').value), rank_id: $('cg-rank').value || null, remover });
        showAlert(remover ? 'Removido da corporação' : 'Cargo definido', 'success');
        // se estiver online, manda o jogo recarregar a corp dele
        const on = STATE.players.find(p => CG_SEL.roblox_id && Number(p.userId) === Number(CG_SEL.roblox_id));
        if (on) { try { await api('POST', '/command', { tipo: 'corp_refresh', target_roblox_id: on.userId, target_name: on.name, payload: {} }); } catch {} }
      } catch (e) { showAlert(e.message, 'error'); }
