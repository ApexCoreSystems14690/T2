    <div class="modal">
      <h2 id="m-title">Comando</h2>
      <div class="sub" id="m-sub"></div>
      <div id="m-fields"></div>
      <div class="actions">
        <button class="btn sec" onclick="closeModal()">Cancelar</button>
        <button class="btn" id="m-ok" onclick="submitModal()">Executar</button>
      </div>
    </div>
  </div>

  <!-- MODAL REVERTER PD (16/10) -->
  <div class="modal-overlay" id="pdmodal">
    <div class="modal">
      <h2 id="pdm-title">Reverter PD</h2>
      <div class="sub" id="pdm-sub"></div>
      <div class="fg"><label>Motivo da reversão (fica no registro)</label><textarea id="pdm-motivo" rows="3" maxlength="300" placeholder="ex.: denúncia #12 — PD sem ação de RP antes"></textarea></div>
      <div class="actions">
        <button class="btn sec" onclick="$('pdmodal').classList.remove('active')">Cancelar</button>
        <button class="btn danger" id="pdm-ok" onclick="confirmaReverter()">Reverter</button>
      </div>
    </div>
  </div>

  <!-- MODAL DAR ITEM (registro) -->
  <div class="modal-overlay" id="rmodal">
    <div class="modal">
      <h2 id="ri-title">Dar item</h2>
      <div class="sub" id="ri-sub"></div>
      <div class="fg" style="margin-bottom:.7rem"><label>Item</label><input id="ri-item" list="ri-itens" autocomplete="off" placeholder="nome do item"><datalist id="ri-itens"></datalist></div>
      <div class="fg"><label>Quantidade</label><input id="ri-qtd" type="number" value="1" min="1" max="99"></div>
      <div class="actions">
        <button class="btn sec" onclick="closeItem()">Cancelar</button>
        <button class="btn" id="ri-ok" onclick="submitItem()">Dar item</button>
      </div>
    </div>
  </div>

  <div class="modal-overlay" id="pmodal">
    <div class="modal">
      <h2 id="pt-title">Patrimônio</h2>
      <div class="sub" id="pt-sub"></div>
      <div id="pt-body"></div>
      <div class="actions">
        <button class="btn sec" onclick="closePatrimonio()">Fechar</button>
      </div>
    </div>
  </div>

  <script>
    // ---------- util ----------
    const $ = id => document.getElementById(id);
    let alertT;
    function showAlert(msg, type) { const a = $('alert'); a.textContent = msg; a.className = 'alert ' + type; clearTimeout(alertT); alertT = setTimeout(() => a.className = 'alert', 3500); }
    async function api(method, path, body) {
      const r = await fetch('/api/admin' + path, { method, headers: { 'Content-Type': 'application/json' }, body: body ? JSON.stringify(body) : undefined });
      let j = null; try { j = await r.json(); } catch {}
      if (!r.ok) throw new Error((j && j.error) || ('HTTP ' + r.status));
      return j;
    }
    const esc = s => String(s == null ? '' : s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    const fmtN = n => (Number(n) || 0).toLocaleString('pt-BR');
    const fmtT = t => { const d = new Date(t); return d.toLocaleDateString('pt-BR') + ' ' + d.toLocaleTimeString('pt-BR'); };

    // ---------- CARGO DO ADMIN LOGADO (19/09) ----------
    // O painel esconde o que este cargo não pode fazer. Isso é CONFORTO: quem
    // barra de verdade é o servidor, que confere o poder em cada request.
    let EU = { cargo: null, nivel: 0, poderes: {}, CARGOS: {}, ORDEM: [], ATRIBUIVEIS: [], PODERES: {}, PODER_DO_COMANDO: {}, matriz: [] };
    const podeP = p => !!EU.poderes[p];
    const podeCmd = tipo => { const p = EU.PODER_DO_COMANDO[tipo]; return p ? !!EU.poderes[p] : false; };
    // botão só entra na linha se o cargo pode usar
    const btnSe = (tipo, html) => podeCmd(tipo) ? html : '';

    // Painéis e abas por poder. Aba sem nenhum poder some do topo.
    const PODER_DA_ABA = { jogadores: null, registro: 'ver_registro', servidor: 'servidor', logs: 'ver_registro', cargos: 'corp', usuarios: 'admins', historico: 'admins', analise: 'ver_registro', banidos: 'banir', pds: 'ver_registro', seguranca: 'ver_registro', testers: 'testers', royalties: 'royalties' };

    async function carregarEu() {
      EU = await api('GET', '/eu');
      const c = EU.CARGOS[EU.cargo] || {};
      const cx = document.getElementById('eu-cargo');
      if (cx) {
        cx.textContent = c.nome || 'admin';
        cx.style.background = (c.cor || '#6B7480') + '22';
        cx.style.color = c.cor || '#5B6573';
        cx.style.border = '1px solid ' + (c.cor || '#6B7480') + '55';
        cx.title = c.desc || '';
      }
      document.querySelectorAll('.tab').forEach(t => {
        const p = PODER_DA_ABA[t.dataset.tab];
        if (p && !podeP(p)) t.style.display = 'none';
      });
      document.querySelectorAll('[data-poder]').forEach(el => {
        if (!podeP(el.dataset.poder)) el.style.display = 'none';
      });
      // [25/09] o cartao do SSU so existe pro Diretor Geral pra cima; a primeira
      // leitura vem depois de saber o cargo, senao a chamada tomaria 403.
      if (podeP('ssu')) ssuCarrega();
      // [15/10] Economia: so o Dono (o back tambem barra com 403)
      if (EU.souDono) $('tab-economia').style.display = '';
      // [21/10] cargo lateral (Gestor testers): abre direto na aba dele
      if ((EU.CARGOS[EU.cargo] || {}).lateral && podeP('testers')) document.querySelector('.tab[data-tab="testers"]').click();
    }

    // ---------------------------------------------------------------- SSU
    // O painel NAO decide nada: pergunta ao site o estado e quais acoes cabem
    // agora, e desenha so essas. Assim nunca aparece botao que o back recusa.
    // [05/10] hora de Brasilia (UTC-3 fixo) a partir de um epoch. A SSU avulsa termina
    // num INSTANTE, nao numa hora da grade, entao os dois lugares que mostram o fim dela
    // precisam disso -- e repetir a conta em dois lugares e como nasce divergencia.
    function ssuHoraBRT(epoch) {
      const d = new Date((Number(epoch) - 3 * 3600) * 1000);
      return String(d.getUTCHours()).padStart(2, '0') + ':' + String(d.getUTCMinutes()).padStart(2, '0');
    }
    async function ssuCarrega() {
      const card = document.querySelector('[data-poder="ssu"]');
      if (!card || card.style.display === 'none') return;
      try {
        const r = await fetch('/api/admin/ssu');
        if (!r.ok) return;
        const d = await r.json();
        const e = d.estado || {};
        const cor = e.aberto ? '#1D7A45' : '#B23227';
        $('ssu-estado').innerHTML = '<span style="color:' + cor + '">'
          + (e.aberto ? '<span class="ponto ok"></span>Aberto' : '<span class="ponto"></span>Fechado') + '</span>'
          + (e.estendida ? ' <span class="muted" style="font-size:.8rem">(estendido)</span>' : '');
        let quando = '';
        if (e.aberto && e.sessao && e.sessao.avulsa) {
          // [05/10] SSU avulsa: o fim nao e hora de grade, e um instante. Mostro a hora dele.
          quando = 'SSU aberta pelo Dono · fecha às ' + ssuHoraBRT(e.sessao.fim);
        } else if (e.aberto && e.sessao) {
          quando = 'SSU de ' + e.sessao.dia + ' · fecha às '
            + (e.sessao.fechaHora >= 24 ? '00:00' : String(e.sessao.fechaHora).padStart(2, '0') + ':00');
        } else if (e.motivo === 'encerrada') {
          quando = 'Encerrado pela direção.';
          if (e.proxima) quando += ' Volta ' + e.proxima.dia + ' às ' + String(e.proxima.abreHora).padStart(2, '0') + ':00.';
        } else if (e.proxima) {
          quando = 'Abre ' + e.proxima.dia + ' às ' + String(e.proxima.abreHora).padStart(2, '0') + ':00.';
        }
        $('ssu-quando').textContent = quando;
        $('ssu-grade').innerHTML = (d.grade || []).map(l => '• ' + l).join('<br>');
        const a = d.acoes || {};
        // [05/10] 'Abrir SSU agora' so existe pro DONO -- o back tambem barra (403).
        $('ssu-abrir').style.display    = a.abrirAgora ? '' : 'none';
        $('ssu-iniciar').style.display  = a.iniciarAgora ? '' : 'none';
        $('ssu-encerrar').style.display = a.encerrar ? '' : 'none';
        $('ssu-reabrir').style.display  = a.reabrir  ? '' : 'none';
        $('ssu-estender').style.display = a.estender ? '' : 'none';
        if (a.estender && a.estenderAvulsaAte) {
          // avulsa: o fim e epoch, nao hora de grade
          $('ssu-estender').innerHTML = '<svg class="ic" aria-hidden="true"><use href="/icones.svg#relogio"/></svg>Estender até ' + ssuHoraBRT(a.estenderAvulsaAte);
        } else if (a.estender) {
          $('ssu-estender').innerHTML = '<svg class="ic" aria-hidden="true"><use href="/icones.svg#relogio"/></svg>Estender até '
            + String(a.estenderAte % 24).padStart(2, '0') + ':00';
        }
      } catch (err) {}
    }
    async function ssuAcao(acao) {
      const nomes = { encerrar: 'ENCERRAR o SSU agora', reabrir: 'REABRIR o SSU', estender: 'ESTENDER o SSU',
                      iniciar: 'INICIAR o SSU de hoje AGORA', abrir: 'ABRIR o SSU AGORA, fora da grade' };
      const aviso = acao === 'abrir'
        ? '?\n\nAbre o servidor por 3 horas a partir de agora, em qualquer dia. A grade não muda — dá pra estender de 1 em 1 hora ou encerrar quando quiser.'
        : '?\n\nIsso vale só pra sessão de hoje. A grade não muda.';
      if (!confirm(nomes[acao] + aviso)) return;
      $('ssu-msg').textContent = 'mandando…';
      try {
        const r = await fetch('/api/admin/ssu', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ acao }),
        });
        const d = await r.json();
        $('ssu-msg').textContent = r.ok
          ? ('Feito. ' + (d.servidores || 0) + ' servidor(es) avisado(s) na hora.')
          : ('Não deu: ' + (d.error || 'erro'));
      } catch (err) { $('ssu-msg').textContent = 'Não deu: sem resposta do site.'; }
      ssuCarrega();
    }
    setInterval(ssuCarrega, 30000);

    // ---------------------------------------------------------------- ANÁLISE
    // Aba pura de dados: média de players, pico, mínimo e crescimento por noite (SSU).
    let anCh1 = null, anCh2 = null;
    const nomeDiaCurto = ['dom', 'seg', 'ter', 'qua', 'qui', 'sex', 'sáb'];
    function fmtNoite(dstr) {
      const d = new Date(String(dstr).slice(0, 10) + 'T12:00:00');
      if (isNaN(d)) return String(dstr);
      return nomeDiaCurto[d.getDay()] + ' ' + String(d.getDate()).padStart(2, '0') + '/' + String(d.getMonth() + 1).padStart(2, '0');
    }
    function desenhaChart(inst, canvasId, tipo, labels, data, rotulo, cor) {
      if (inst) inst.destroy();
      if (typeof Chart === 'undefined') return null;
      return new Chart($(canvasId).getContext('2d'), {
        type: tipo,
        data: { labels, datasets: [{ label: rotulo, data, borderColor: cor,
          backgroundColor: tipo === 'bar' ? cor + 'bb' : cor + '22', fill: tipo === 'line',
          tension: .3, pointRadius: 0, borderWidth: 2, borderRadius: tipo === 'bar' ? 4 : 0 }] },
        options: {
          responsive: true, maintainAspectRatio: false, animation: false,
          plugins: { legend: { display: false }, tooltip: { intersect: false, mode: 'index' } },
          scales: {
            x: { ticks: { color: '#5B6573', maxRotation: 0, autoSkip: true, maxTicksLimit: 8, font: { size: 10 } }, grid: { color: '#D6DADF55' } },
            y: { beginAtZero: true, ticks: { color: '#5B6573', precision: 0, font: { size: 10 } }, grid: { color: '#D6DADF55' } },
          },
        },
      });
    }
    // [27/09] QUEM ENTROU EM SERVICO, por corporacao.
    // MEMBROS e distinto por pessoa; ENTRADAS conta batida de ponto. Os dois numeros
    // lado a lado sao o ponto do relatorio: 2 membros com 9 entradas e uma corp vazia
    // com gente entrando e saindo, nao uma corp cheia.
    const escTxt = t => String(t == null ? '' : t)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    function renderServico(sv) {
      sv = sv || {};
      const daNoite = sv.porCorpNoite || [], de7 = sv.porCorp7 || [];
      const tem = de7.length > 0;
      $('an-svc-vazio').style.display = tem ? 'none' : 'block';
      $('an-svc-wrap').style.display = tem ? '' : 'none';
      $('an-svc-sub').textContent = tem
        ? ('Membros distintos que pegaram farda no armário. Última noite com serviço: ' + (sv.noite ? fmtNoite(sv.noite) : '—'))
        : 'Membros distintos que pegaram farda no armário.';
      if (!tem) { $('an-svc-tbody').innerHTML = ''; return; }
      const porCorp = {};
      for (const r of daNoite) porCorp[r.corp] = r;
      $('an-svc-tbody').innerHTML = de7.map(r => {
        const n = porCorp[r.corp] || { membros: 0, entradas: 0 };
        return '<tr><td><b>' + escTxt(r.corp) + '</b></td><td><b>' + fmtN(n.membros) + '</b></td><td class="muted">'
          + fmtN(n.entradas) + '</td><td>' + fmtN(r.membros) + '</td></tr>';
      }).join('');
    }

    async function loadAnalise() {
      let d;
      try { d = await api('GET', '/analise'); } catch (e) { showAlert(e.message, 'error'); return; }
      const noitesDesc = d.noites || [];
      const temDado = (d.resumo && d.resumo.amostras_total > 0) || noitesDesc.length > 0;
      // online agora aparece sempre
      $('an-online').textContent = fmtN(d.online.jogadores);
      $('an-online-sub').textContent = fmtN(d.online.servidores) + ' servidor(es)';
      $('an-vazio').style.display = temDado ? 'none' : 'block';
      $('an-conteudo').style.display = 'block';
      // [27/09] serviço por corp é dado INDEPENDENTE dos snapshots: renderiza antes do
      // return antecipado, senão sumiria sempre que ainda não houvesse amostra de player.
      renderServico(d.servico);
      if (!temDado) {
        ['an-media7', 'an-pico', 'an-melhor', 'an-cresc'].forEach(id => $(id).textContent = '–');
        return;
      }
      $('an-pico').textContent = fmtN(d.resumo.pico_hist);
      const medias = noitesDesc.map(n => n.media);
      const ult7 = medias.slice(0, 7);
      const media7 = ult7.length ? Math.round(ult7.reduce((a, b) => a + b, 0) / ult7.length) : 0;
      $('an-media7').textContent = fmtN(media7);
      $('an-media7-sub').textContent = 'últimas ' + ult7.length + ' noite(s)';
      let melhor = noitesDesc[0] || { media: 0, dia: null };
      for (const n of noitesDesc) if (n.media > melhor.media) melhor = n;
      $('an-melhor').textContent = fmtN(melhor.media);
      $('an-melhor-sub').textContent = melhor.dia ? fmtNoite(melhor.dia) : '';
      // crescimento: média das 3 últimas noites vs 3 anteriores
      const a3 = medias.slice(0, 3), b3 = medias.slice(3, 6);
      const mA = a3.length ? a3.reduce((x, y) => x + y, 0) / a3.length : 0;
      const mB = b3.length ? b3.reduce((x, y) => x + y, 0) / b3.length : 0;
      if (b3.length >= 1 && mB > 0) {
        const pct = Math.round((mA / mB - 1) * 100);
        $('an-cresc').textContent = (pct >= 0 ? '+' : '') + pct + '%';
        $('an-cresc').style.color = pct >= 0 ? '#1D7A45' : '#B23227';
        $('an-cresc-sub').textContent = 'últimas 3 vs 3 anteriores';
      } else {
        $('an-cresc').textContent = '—'; $('an-cresc').style.color = '#5B6573';
        $('an-cresc-sub').textContent = 'precisa de mais noites';
      }
      // curva 24h
      const serie = d.serie || [];
      $('an-serie-vazio').style.display = serie.length ? 'none' : 'block';
      anCh1 = desenhaChart(anCh1, 'an-chart-serie', 'line',
        serie.map(p => new Date(p.t).toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' })),
        serie.map(p => p.jogadores), 'Jogadores', '#1D3F94');
      // média por noite (asc, últimas 14)
      const nn = noitesDesc.slice(0, 14).reverse();
      anCh2 = desenhaChart(anCh2, 'an-chart-noites', 'bar',
        nn.map(n => fmtNoite(n.dia)), nn.map(n => n.media), 'Média/noite', '#1D7A45');
      // tabela
      $('an-tbody').innerHTML = noitesDesc.map(n =>
        '<tr><td>' + fmtNoite(n.dia) + '</td><td><b>' + fmtN(n.media) + '</b></td><td>' + fmtN(n.pico) +
        '</td><td>' + fmtN(n.minimo) + '</td><td class="muted">' + fmtN(n.amostras) + '</td></tr>').join('')
        || '<tr><td colspan="5" class="empty">—</td></tr>';
    }

    // ---------------------------------------------------------------- BANIDOS
    // [05/10] O ban mora no DataStore do Roblox e o site nao le aquilo: esta tela mostra
    // o ESPELHO (game_bans). Por isso existe tambem o campo de Roblox ID solto -- pra
    // desbanir alguem que foi banido antes do espelho existir e por isso nao esta na lista.
    function bnFalta(seg) {
      seg = Math.max(0, Math.floor(Number(seg) || 0));
      if (seg >= 86400) return Math.floor(seg / 86400) + 'd ' + Math.floor((seg % 86400) / 3600) + 'h';
      if (seg >= 3600) return Math.floor(seg / 3600) + 'h ' + Math.floor((seg % 3600) / 60) + 'min';
      return Math.max(1, Math.ceil(seg / 60)) + 'min';
    }
    async function loadBans() {
      const hist = $('bn-hist') && $('bn-hist').checked ? '?historico=1' : '';
      const body = $('bn-body');
      try {
        const d = await api('GET', '/bans' + hist);
        const bans = d.bans || [];
        $('bn-conta').textContent = d.ativos + (d.ativos === 1 ? ' banido ativo' : ' banidos ativos');
        if (bans.length === 0) {
          body.innerHTML = '<tr><td colspan="7" class="empty">Ninguém banido por aqui ainda. Bans antigos (de antes deste registro) não aparecem — use o campo de Roblox ID acima.</td></tr>';
          return;
        }
        body.innerHTML = bans.map(b => {
          let ate, cor = '';
          if (b.desfeito_em) { ate = 'desbanido'; cor = 'color:#8A94A0'; }
          else if (b.permanente) { ate = 'PERMANENTE'; cor = 'color:#B23227'; }
          else if (b.vencido) { ate = 'já venceu'; cor = 'color:#8A94A0'; }
          else { ate = 'falta ' + bnFalta(b.falta); cor = 'color:#A86400'; }
          const quando = b.banido_em ? new Date(b.banido_em).toLocaleString('pt-BR') : '—';
          const acao = (!b.desfeito_em && podeP('banir'))
            ? '<button onclick="desbanir(' + b.roblox_id + ')"><svg class="ic" aria-hidden="true"><use href="/icones.svg#cadeado-aberto"/></svg>Desbanir</button>'
            : (b.desfeito_em ? '<span class="muted" style="font-size:.75rem">por ' + (b.desfeito_por || '—') + '</span>' : '');
          return '<tr' + (b.desfeito_em ? ' style="opacity:.55"' : '') + '>'
            + '<td>' + (b.nome || '<span class="muted">—</span>') + '</td>'
            + '<td class="muted">' + b.roblox_id + '</td>'
            + '<td>' + (b.motivo || '<span class="muted">—</span>') + '</td>'
            + '<td style="' + cor + '">' + ate + '</td>'
            + '<td class="muted">' + (b.banido_por || b.origem || '—') + '</td>'
            + '<td class="muted">' + quando + '</td>'
            + '<td>' + acao + '</td></tr>';
        }).join('');
      } catch (err) {
        body.innerHTML = '<tr><td colspan="7" class="empty">Não deu pra carregar.</td></tr>';
      }
    }
    async function desbanir(id) {
      if (!confirm('DESBANIR o Roblox ID ' + id + '?')) return;
      try {
        const d = await api('POST', '/command', { tipo: 'unban', payload: { roblox_id: id } });
        alert(d && d.error ? ('Não deu: ' + d.error) : (d && d.semServidor ? 'Desbanido. Vale na próxima vez que ele entrar.' : 'Desbanido.'));
      } catch (err) { alert('Não deu: ' + (err.message || 'erro')); }
      loadBans();
    }
    function desbanirPorId() {
      const v = parseInt(($('bn-id').value || '').trim(), 10);
      if (!v || v <= 0) return alert('Põe um Roblox ID válido.');
      desbanir(v);
    }

    // ---------- segurança (14/10) ----------
    async function loadSeg() {
      try {
        const d = await api('GET', '/seguranca?horas=' + ($('sg-horas').value || 24));
        $('sg-altban').checked = !!d.config.bloquear_alt_de_banido;
        $('sg-exige').checked = !!d.config.exige_vinculo;
        $('sg-altban').disabled = $('sg-exige').disabled = !podeP('banir');
        $('sg-vinc').textContent = (d.vinculos.verificados || 0) + ' verificadas de ' + (d.vinculos.vinculados || 0) + ' contas vinculadas';
        $('sg-alertas').innerHTML = d.alertas.map(a => '<tr><td>' + esc(a.jogador || '—') + '</td><td>' + a.n + '</td><td>' + (a.pico == null ? '—' : a.pico) + '</td><td>' + esc((a.regras || []).filter(Boolean).join(', ')) + '</td><td class="muted">' + fmtT(a.ultimo) + '</td></tr>').join('') || '<tr><td colspan="5" class="empty">Nada no período.</td></tr>';
        $('sg-origens').textContent = d.origens.map(o => o.origem + ': ' + o.n).join(' · ');
        $('sg-kicks').innerHTML = d.kicks.map(k => { const x = k.detalhe || {}; return '<tr><td class="muted" style="white-space:nowrap">' + fmtT(k.quando) + '</td><td>' + '<span class="pill ' + (k.tipo === 'ban' ? 'err' : 'warn') + '">' + esc(x.desfeito ? 'desban' : k.tipo) + '</span>' + '</td><td>' + esc(k.jogador || '—') + '</td><td>' + esc(x.origem || x.fonte || '—') + '</td><td style="font-size:.78rem">' + esc(String(x.motivo || x.regra || '').replace(/\n/g, ' ')) + '</td></tr>'; }).join('') || '<tr><td colspan="5" class="empty">Nada no período.</td></tr>';
        const al = await api('GET', '/seguranca/alts');
        $('sg-max').textContent = al.maxPorIp;
        $('sg-alts').innerHTML = al.grupos.length ? al.grupos.map(g => '<div style="background:#F4F5F7;border-radius:8px;padding:.5rem;margin-bottom:.4rem"><b>' + esc(g.rede) + '</b> <span class="muted">(' + g.n + ' contas)</span><br>' + g.contas.map(c => '<span class="pill ' + (c.banido ? 'err' : (c.verificado ? 'ok' : '')) + '" style="margin:.15rem">' + esc(c.nome || ('id ' + (c.roblox_id || '—'))) + ' · ' + esc(c.discord || '?') + (c.verificado ? ' (verificada)' : '') + (c.banido ? ' · BANIDO' : '') + '</span>').join('') + '</div>').join('') : '<span class="muted">Nenhuma rede com 2+ contas ainda.</span>';
      } catch (e) { showAlert('Segurança: ' + e.message, 'error'); }
    }
    async function salvaSegCfg() {
      try {
        await api('POST', '/seguranca/config', { bloquear_alt_de_banido: $('sg-altban').checked, exige_vinculo: $('sg-exige').checked });
        showAlert('Configuração de segurança salva — vale na próxima entrada de cada jogador', 'success');
      } catch (e) { showAlert(e.message, 'error'); loadSeg(); }
    }

    // ---------------------------------------------------------------- TESTERS (21/10)
    // Liberação temporária. O painel só monta o pedido; quem decide e registra é
    // o site (src/testers.js). Back barra com 403 quem não tem o poder 'testers'.
    let TST = { liberacoes: [], usuarios: [], corps_por_tipo: {} }, TS_SEL = null, TS_ITENS = [], TS_CARROS = [], TS_ABERTA = null;
    async function loadTesters() {
      try {
        TST = await api('GET', '/testers');
        for (const t of ['corp', 'faccao', 'empresa']) $('ts-n-' + t).textContent = '(' + (TST.corps_por_tipo[t] || 0) + ')';
        tsCatalogo();
        tsRenderLista();
      } catch (e) { showAlert('Testers: ' + e.message, 'error'); }
    }
    function tsCatalogo() {
      const it = cat('itens', []), cr = cat('carros', []);
      $('ts-n-itens').textContent = it.length ? '(' + it.length + ')' : '(precisa de um servidor online)';
      $('ts-n-carros').textContent = cr.length ? '(' + cr.length + ')' : '(precisa de um servidor online)';
      $('ts-dl-itens').innerHTML = it.map(x => '<option value="' + esc(x) + '">').join('');
      $('ts-dl-carros').innerHTML = cr.map(x => '<option value="' + esc(x) + '">').join('');
    }
    function tsAdd(tipo) {
      if (tipo === 'item') {
        const n = $('ts-item').value.trim(); if (!n) return;
        const q = Math.max(1, Math.min(99, parseInt($('ts-qtd').value) || 1));
        const ja = TS_ITENS.find(i => i.item === n);
        if (ja) ja.qtd = Math.min(99, ja.qtd + q); else TS_ITENS.push({ item: n, qtd: q });
        $('ts-item').value = '';
      } else {
        const n = $('ts-carro').value.trim(); if (!n) return;
        if (!TS_CARROS.includes(n)) TS_CARROS.push(n);
        $('ts-carro').value = '';
      }
      tsRenderEscolhidos();
    }
    function tsTira(tipo, i) { (tipo === 'item' ? TS_ITENS : TS_CARROS).splice(i, 1); tsRenderEscolhidos(); }
    function tsRenderEscolhidos() {
      const a = TS_ITENS.map((it, i) => '<span class="pill info" style="margin:.1rem">' + esc(it.item) + ' ×' + it.qtd + ' <a href="#" onclick="tsTira(\'item\',' + i + ');return false">✕</a></span>');
      const b = TS_CARROS.map((c, i) => '<span class="pill warn" style="margin:.1rem">' + esc(c) + ' <a href="#" onclick="tsTira(\'carro\',' + i + ');return false">✕</a></span>');
      $('ts-escolhidos').innerHTML = a.concat(b).join('');
    }
    (function () {
      const inp = $('ts-user'), list = $('ts-list');
      function tsRenderPicker() {
        const q = inp.value.toLowerCase().trim();
        const us = TST.usuarios.filter(u => !q || [u.discord_username, u.roblox_username, u.roblox_id, u.id].some(v => v != null && String(v).toLowerCase().includes(q))).slice(0, 40);
        list.innerHTML = us.length ? us.map(u => '<div class="picker-item" data-id="' + u.id + '"><div>' + (u.online ? '<span class="ponto ok"></span>' : '') + esc(u.roblox_username || u.discord_username || ('#' + u.id)) + '</div><div class="m">' + (u.roblox_id ? 'Roblox ' + u.roblox_id : 'sem Roblox vinculado') + (u.discord_username ? ' · ' + esc(u.discord_username) : '') + '</div></div>').join('') : '<div class="picker-item muted">Ninguém com esse nome</div>';
        list.classList.add('open');
      }
      inp.addEventListener('focus', async () => { if (!TST.usuarios.length) await loadTesters(); tsRenderPicker(); });
      inp.addEventListener('input', () => { TS_SEL = null; $('ts-picked').textContent = ''; tsRenderPicker(); });
      list.addEventListener('mousedown', e => {
        const it = e.target.closest('.picker-item'); if (!it || !it.dataset.id) return;
        TS_SEL = TST.usuarios.find(u => String(u.id) === it.dataset.id);
        inp.value = TS_SEL.roblox_username || TS_SEL.discord_username || ('#' + TS_SEL.id);
        $('ts-picked').textContent = TS_SEL.online ? 'online agora — recebe na hora' : 'offline — itens na fila, carros quando entrar';
        list.classList.remove('open');
      });
      document.addEventListener('click', e => { if (!e.target.closest('#panel-testers .picker')) list.classList.remove('open'); });
    })();
    async function tsLiberar() {
      if (!TS_SEL) return showAlert('Escolha o tester', 'error');
      const tipos = ['corp', 'faccao', 'empresa'].filter(t => $('ts-t-' + t).checked);
      let itens = TS_ITENS.slice(), carros = TS_CARROS.slice();
      if ($('ts-todos-itens').checked) for (const n of cat('itens', [])) if (!itens.some(i => i.item === n)) itens.push({ item: n, qtd: 1 });
      if ($('ts-todos-carros').checked) for (const c of cat('carros', [])) if (!carros.includes(c)) carros.push(c);
      const horas = Number($('ts-horas').value);
      const nCorps = tipos.reduce((s, t) => s + (TST.corps_por_tipo[t] || 0), 0);
      const nome = TS_SEL.roblox_username || TS_SEL.discord_username;
      if (!confirm('Liberar pra ' + nome + ' por ' + $('ts-horas').selectedOptions[0].text + '?\n\n' +
        nCorps + ' corps (cargo ' + ($('ts-nivel').value === 'alto' ? 'mais alto' : 'mais baixo') + ')\n' +
        itens.length + ' itens\n' + carros.length + ' carros\n' + ($('ts-noclip').checked ? 'Noclip + Modo Deus\n' : '') + '\nNo fim do prazo tudo volta sozinho.')) return;
      $('ts-go').disabled = true; $('ts-resumo').textContent = 'liberando…';
      try {
        const r = await api('POST', '/testers/conceder', { user_id: TS_SEL.id, horas, tipos, nivel: $('ts-nivel').value, itens, carros, noclip: $('ts-noclip').checked, motivo: $('ts-motivo').value });
        const s = r.resumo || {};
        $('ts-resumo').textContent = 'Feito: ' + s.corps + ' corps, ' + s.itens + ' itens, ' + s.carros + ' carros'
          + (s.carros_pulados ? ' (' + s.carros_pulados + ' ele já tinha)' : '')
          + (s.carros_pendentes ? ' · ' + s.carros_pendentes + ' carros chegam quando ele entrar' : '')
          + (s.noclip ? ' · noclip: ' + s.noclip : '')
          + ' · vence ' + fmtT(r.expira_em);
        showAlert('Tester liberado', 'success');
        TS_ITENS = []; TS_CARROS = []; tsRenderEscolhidos();
      } catch (e) { $('ts-resumo').textContent = ''; showAlert(e.message, 'error'); }
      $('ts-go').disabled = false;
      loadTesters();
    }
    function tsFalta(ms) {
      if (ms <= 0) return 'vencendo…';
      const m = Math.round(ms / 60000), h = Math.floor(m / 60), d = Math.floor(h / 24);
      return d >= 1 ? d + 'd ' + (h % 24) + 'h' : h >= 1 ? h + 'h ' + (m % 60) + 'min' : m + 'min';
    }
    function tsRenderLista() {
      const L = TST.liberacoes || [];
      if (!L.length) { $('ts-body').innerHTML = '<tr><td colspan="6" class="empty">Nenhuma liberação ainda</td></tr>'; return; }
      const SIT = { ativa: ['ok', 'Ativa'], revertendo: ['warn', 'Voltando'], encerrada: ['', 'Encerrada'] };
      $('ts-body').innerHTML = L.map(l => {
        const corps = l.corps || [], itens = l.itens || [], carros = (l.carros || []).filter(c => !c.pulado);
        const falta = itens.filter(i => i.tirar).length + carros.filter(c => c.tirar).length;
        const pendCarro = carros.filter(c => !c.entregue).length;
        const sit = SIT[l.status] || ['', l.status];
        let prazo = '';
        if (l.status === 'ativa') prazo = 'vence em <b>' + tsFalta(new Date(l.expira_em) - Date.now()) + '</b><div class="muted" style="font-size:.7rem">' + fmtT(l.expira_em) + '</div>';
        else prazo = '<span class="muted" style="font-size:.75rem">' + (l.fim_motivo === 'expirou' ? 'prazo acabou' : 'encerrada por ' + esc(l.encerrada_por || '?')) + '<br>' + (l.encerrada_em ? fmtT(l.encerrada_em) : '') + '</span>';
        const obs = l.status === 'revertendo' ? '<div class="muted" style="font-size:.7rem">falta tirar ' + falta + ' no jogo (quando ele entrar)</div>'
          : (l.status === 'ativa' && pendCarro ? '<div class="muted" style="font-size:.7rem">' + pendCarro + ' carro(s) chegam quando ele entrar</div>' : '');
        const acoes = l.status === 'ativa'
          ? '<div class="acts"><button onclick="tsEstender(' + l.id + ')">+ prazo</button><button onclick="tsNoclip(' + l.id + ',' + !(l.noclip && l.noclip.ligado) + ')">' + (l.noclip && l.noclip.ligado ? 'Tirar noclip' : 'Dar noclip') + '</button><button class="d" onclick="tsEncerrar(' + l.id + ')">Encerrar</button><button onclick="tsDetalhe(' + l.id + ')">Ver</button></div>'
          : '<div class="acts"><button onclick="tsDetalhe(' + l.id + ')">Ver</button></div>';
        let linha = '<tr><td>' + (l.online ? '<span class="ponto ok"></span>' : '') + '<b>' + esc(l.nome || '?') + '</b><div class="muted" style="font-size:.7rem">#' + l.id + (l.roblox_id ? ' · ' + l.roblox_id : '') + (l.motivo ? ' · ' + esc(l.motivo) : '') + '</div></td>' +
          '<td>' + corps.length + ' corps · ' + itens.length + ' itens · ' + carros.length + ' carros' + (l.noclip && l.noclip.ligado ? ' · <b>noclip + Deus</b>' : '') + '</td>' +
          '<td>' + prazo + '</td>' +
          '<td><span class="pill ' + sit[0] + '">' + sit[1] + '</span>' + obs + '</td>' +
          '<td>' + esc(l.dado_por_nome || '?') + '<div class="muted" style="font-size:.7rem">' + fmtT(l.criado_em) + '</div></td>' +
          '<td>' + acoes + '</td></tr>';
        if (TS_ABERTA === l.id) {
          const cps = corps.map(c => esc(c.corp) + (c.cargo ? ' (' + esc(c.cargo) + ')' : '') + (c.antes && c.antes.membro ? ' <span class="muted">já era membro</span>' : '') + (c.desfeito ? ' <span class="muted">→ ' + ({ remover: 'saiu', restaurar: 'cargo devolvido', nada: 'sem mudança' }[c.desfeito] || c.desfeito) + '</span>' : '')).join(' · ') || '—';
          const its = itens.map(i => esc(i.item) + ' ×' + i.qtd + (i.cancelado ? ' <span class="muted">(cancelado na fila)</span>' : i.tirado ? ' <span class="muted">(tirado)</span>' : i.tirar ? ' <span class="muted">(falta tirar)</span>' : '')).join(' · ') || '—';
          const crs = (l.carros || []).map(c => esc(c.carro) + (c.pulado ? ' <span class="muted">(já tinha, não deu)</span>' : !c.entregue ? ' <span class="muted">(pendente)</span>' : c.tirado ? ' <span class="muted">(tirado)</span>' : c.tirar ? ' <span class="muted">(falta tirar)</span>' : '')).join(' · ') || '—';
          const hist = (l.historico || []).map(h => fmtT(h.em) + ' · ' + esc(h.quem) + ' — ' + esc(h.texto)).join('<br>');
          linha += '<tr><td colspan="6" style="background:#F4F5F7;font-size:.78rem;line-height:1.5"><b>Corps:</b> ' + cps + '<br><b>Itens:</b> ' + its + '<br><b>Carros:</b> ' + crs + '<br><b>Registro:</b><br>' + hist + '</td></tr>';
        }
        return linha;
      }).join('');
    }
    function tsDetalhe(id) { TS_ABERTA = TS_ABERTA === id ? null : id; tsRenderLista(); }
    async function tsEstender(id) {
      const h = prompt('Estender quantas horas? (1 a ' + (TST.horas_max || 168) + ')', '24');
      if (!h) return;
      try { const r = await api('POST', '/testers/' + id + '/estender', { horas: Number(h) }); showAlert('Agora vence ' + fmtT(r.expira_em), 'success'); }
      catch (e) { showAlert(e.message, 'error'); }
      loadTesters();
    }
    async function tsNoclip(id, ativar) {
      try { const r = await api('POST', '/testers/' + id + '/noclip', { ativar }); showAlert((ativar ? 'Noclip + Modo Deus ligado' : 'Noclip desligado') + (r.online ? '' : ' (vale quando ele entrar)'), 'success'); }
      catch (e) { showAlert(e.message, 'error'); }
      loadTesters();
    }
    async function tsEncerrar(id) {
      if (!confirm('Encerrar agora?\n\nAs corps voltam na hora. Itens e carros saem no jogo assim que ele estiver online.')) return;
      try { const r = await api('POST', '/testers/' + id + '/encerrar'); showAlert(r.falta_no_jogo ? 'Encerrado — o jogo tira o resto quando ele entrar' : 'Encerrado', 'success'); }
      catch (e) { showAlert(e.message, 'error'); }
      loadTesters();
    }
    setInterval(() => { if ($('panel-testers').classList.contains('active')) loadTesters(); }, 20000);

    document.querySelectorAll('.tab').forEach(tab => tab.addEventListener('click', () => {
      document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
      document.querySelectorAll('.panel').forEach(p => p.classList.remove('active'));
      tab.classList.add('active'); $('panel-' + tab.dataset.tab).classList.add('active');
      if (tab.dataset.tab === 'registro') loadRegistro();
      if (tab.dataset.tab === 'logs') loadLogs();
      if (tab.dataset.tab === 'usuarios') loadUsers();
      if (tab.dataset.tab === 'historico') loadHist();
      if (tab.dataset.tab === 'cargos') loadCargos();
      if (tab.dataset.tab === 'analise') loadAnalise();
      if (tab.dataset.tab === 'banidos') loadBans();
      if (tab.dataset.tab === 'pds') loadPds();
      if (tab.dataset.tab === 'seguranca') loadSeg();
      if (tab.dataset.tab === 'economia') loadEcon();
      if (tab.dataset.tab === 'testers') loadTesters();
      if (tab.dataset.tab === 'royalties') loadRoy();
    }));

    // ---------------------------------------------------------------- ROYALTIES (23/10)
    let RY = { cfg: null, rid: null, nome: '' };
    async function loadRoy() {
      try { RY.cfg = await api('GET', '/royalties/config'); } catch (e) { showAlert(e.message, 'error'); return; }
      const mots = RY.cfg.motivos.filter(m => m.ativo && (!m.so_dono || RY.cfg.eh_dono));
      $('ry-motivo').innerHTML = mots.map(m => '<option value="' + esc(m.chave) + '" data-valor="' + m.valor + '" data-livre="' + (m.livre ? 1 : 0) + '">' + esc(m.nome) + (m.livre ? ' (livre)' : ' (+' + m.valor + ')') + '</option>').join('');
      ryMotivo();
      ryDesenhaTrocas(RY.cfg.trocas);
      $('ry-config').style.display = RY.cfg.eh_dono ? '' : 'none';
      if (RY.cfg.eh_dono) ryDesenhaConfig();
      if (RY.rid) ryAbrir(RY.rid, RY.nome);
    }
    function ryMotivo() {
      const o = $('ry-motivo').selectedOptions[0]; if (!o) return;
      const livre = o.dataset.livre === '1';
      $('ry-valor').readOnly = !livre;
      $('ry-valor').value = livre ? '' : o.dataset.valor;
      $('ry-valor').placeholder = livre ? 'ex.: 50 ou -20' : '';
    }
    $('ry-motivo').addEventListener('change', ryMotivo);
    let ryT = null;
    $('ry-busca').addEventListener('input', () => {
      clearTimeout(ryT);
      ryT = setTimeout(async () => {
        const q = $('ry-busca').value.trim();
        if (q.length < 2) { $('ry-lista').classList.remove('open'); return; }
        try {
          const L = await api('GET', '/royalties/busca?q=' + encodeURIComponent(q));
          $('ry-lista').innerHTML = L.length ? L.map(x => '<div data-rid="' + x.roblox_id + '" data-nome="' + esc(x.nome || '') + '"><b>' + esc(x.nome || x.roblox_id) + '</b> <span class="muted">' + x.roblox_id + (x.discord ? ' · ' + esc(x.discord) : '') + (x.verificado ? ' · verificado' : '') + ' · ' + fmtN(x.saldo) + ' Royalties</span></div>').join('') : '<div class="muted">Ninguém com esse nome</div>';
          $('ry-lista').classList.add('open');
          $('ry-lista').querySelectorAll('[data-rid]').forEach(d => d.onclick = () => { $('ry-lista').classList.remove('open'); $('ry-busca').value = d.dataset.nome || d.dataset.rid; ryAbrir(Number(d.dataset.rid), d.dataset.nome); });
        } catch (e) { showAlert(e.message, 'error'); }
      }, 220);
    });
    document.addEventListener('click', e => { if (!e.target.closest('#panel-royalties .picker')) $('ry-lista').classList.remove('open'); });
    async function ryAbrir(rid, nome) {
      RY.rid = rid; RY.nome = nome || '';
      let x; try { x = await api('GET', '/royalties/' + rid); } catch (e) { showAlert(e.message, 'error'); return; }
      $('ry-jogador').style.display = '';
      $('ry-nome').textContent = nome || ('#' + rid); $('ry-rid').textContent = rid;
      $('ry-saldo').textContent = fmtN(x.saldo);
      $('ry-semana').textContent = x.semana.usadas + ' de ' + x.semana.max + (x.semana.dinheiro ? ' · pacote de dinheiro usado' : '');
      const TIPO = { credito: 'Crédito', estorno: 'Estorno', troca: 'Troca' };
      $('ry-ext').innerHTML = x.lancamentos.length ? x.lancamentos.map(l => {
        const podeEstornar = l.tipo !== 'estorno' && !l.estornado_por && (l.tipo !== 'troca' || l.troca_status === 'pendente');
        return '<tr><td class="muted">' + l.id + '</td><td class="muted">' + fmtT(l.criado_em) + '</td><td>' + TIPO[l.tipo] + (l.troca_status ? ' <span class="pill ' + (l.troca_status === 'entregue' ? 'ok' : l.troca_status === 'cancelada' ? '' : 'warn') + '">' + esc(l.troca_status) + '</span>' : '') + '</td>'
          + '<td style="font-weight:700;color:' + (l.valor > 0 ? '#1D7A45' : '#161A1F') + '">' + (l.valor > 0 ? '+' : '') + fmtN(l.valor) + '</td><td>' + fmtN(l.saldo_depois) + '</td>'
          + '<td>' + esc(l.motivo) + '</td><td class="muted" style="font-size:.78rem;max-width:240px;overflow-wrap:anywhere">' + esc(l.comprovacao || '') + '</td>'
          + '<td>' + esc(l.por_nome || (l.tipo === 'troca' ? 'o jogador' : '')) + '</td>'
          + '<td>' + (l.estornado_por ? '<span class="muted" style="font-size:.75rem">estornado (#' + l.estornado_por + ')</span>' : podeEstornar ? '<button class="btn sec sm" onclick="ryEstornar(' + l.id + ')">Estornar</button>' : '') + '</td></tr>';
      }).join('') : '<tr><td colspan="9" class="empty">Nenhum lançamento ainda.</td></tr>';
    }
    async function ryCreditar() {
      if (!RY.rid) return showAlert('Escolha o jogador', 'error');
      const prova = $('ry-prova').value.trim();
      if (prova.length < 4) return showAlert('A comprovação é obrigatória', 'error');
      const o = $('ry-motivo').selectedOptions[0];
      const body = { roblox_id: RY.rid, motivo: $('ry-motivo').value, comprovacao: prova };
      if (o && o.dataset.livre === '1') body.valor = Number($('ry-valor').value);
      if (!confirm('Creditar ' + (body.valor != null ? body.valor : o.dataset.valor) + ' Royalties pra ' + (RY.nome || RY.rid) + '?\nMotivo: ' + o.textContent)) return;
      $('ry-go').disabled = true;
      try { const r = await api('POST', '/royalties/creditar', body); showAlert('Creditado. Saldo agora: ' + fmtN(r.saldo), 'success'); $('ry-prova').value = ''; ryAbrir(RY.rid, RY.nome); ryTrocas(); }
      catch (e) { showAlert(e.message, 'error'); }
      $('ry-go').disabled = false;
    }
    async function ryEstornar(id) {
      const m = prompt('Motivo do estorno (fica no extrato):');
      if (!m) return;
      try { const r = await api('POST', '/royalties/estornar', { lancamento_id: id, motivo: m }); showAlert('Estornado. Saldo agora: ' + fmtN(r.saldo), 'success'); ryAbrir(RY.rid, RY.nome); ryTrocas(); }
      catch (e) { showAlert(e.message, 'error'); }
    }
    async function ryTrocas() {
      const st = $('ry-filtro').value;
      try { ryDesenhaTrocas(await api('GET', '/royalties/trocas' + (st ? '?status=' + encodeURIComponent(st) : ''))); } catch (e) { showAlert(e.message, 'error'); }
    }
    function ryDesenhaTrocas(L) {
      const SIT = { pendente: ['warn', 'Esperando ele entrar'], enviando: ['info', 'Enviando'], entregue: ['ok', 'Entregue'], revisar: ['err', 'Revisar'], cancelada: ['', 'Cancelada'] };
      $('ry-trocas').innerHTML = (L || []).length ? L.map(t => { const s = SIT[t.status] || ['', t.status];
        return '<tr><td class="muted">' + t.id + '</td><td class="muted">' + fmtT(t.criado_em) + '</td><td>' + esc(t.nome || t.roblox_id) + '</td><td>' + esc(t.item_nome) + '</td><td>' + fmtN(t.custo) + '</td>'
          + '<td><span class="pill ' + s[0] + '">' + s[1] + '</span>' + (t.nota ? '<div class="muted" style="font-size:.72rem">' + esc(t.nota) + '</div>' : '') + '</td></tr>'; }).join('')
        : '<tr><td colspan="6" class="empty">Nenhuma troca.</td></tr>';
    }
    function ryDesenhaConfig() {
      $('ry-cat').innerHTML = RY.cfg.catalogo.map(i => '<tr><td>' + esc(i.nome) + (i.chave === 'carro_temporada' ? '<div class="muted" style="font-size:.72rem">modelo: ' + esc((i.conteudo || {}).carro || 'não escolhido') + '</div>' : '') + '</td><td>' + esc(i.tipo) + '</td>'
        + '<td><input type="number" min="1" value="' + i.custo + '" style="width:80px" id="ryc-' + esc(i.chave) + '"></td><td>' + (i.limite === 'temporada' ? '1 por temporada' : i.tipo === 'dinheiro' ? '1 por semana' : '—') + '</td>'
        + '<td><input type="checkbox" ' + (i.ativo ? 'checked' : '') + ' id="rya-' + esc(i.chave) + '"></td>'
        + '<td class="muted" style="font-size:.74rem;max-width:280px">' + esc(i.depende_jogo || '') + '</td>'
        + '<td><button class="btn sec sm" onclick="rySalvarItem(\'' + esc(i.chave) + '\')">Salvar</button>' + (i.chave === 'carro_temporada' ? ' <button class="btn sec sm" onclick="ryCarroTemporada()">Escolher carro</button>' : '') + '</td></tr>').join('');
      $('ry-mot').innerHTML = RY.cfg.motivos.map(m => '<tr><td>' + esc(m.nome) + (m.so_dono ? ' <span class="muted">(só Dono)</span>' : '') + '</td>'
        + '<td>' + (m.livre ? '<span class="muted">livre</span>' : '<input type="number" min="0" value="' + m.valor + '" style="width:80px" id="rym-' + esc(m.chave) + '">') + '</td>'
        + '<td><input type="checkbox" ' + (m.ativo ? 'checked' : '') + ' id="ryma-' + esc(m.chave) + '"></td>'
        + '<td><button class="btn sec sm" onclick="rySalvarMotivo(\'' + esc(m.chave) + '\',' + (m.livre ? 1 : 0) + ')">Salvar</button></td></tr>').join('');
    }
    async function rySalvarItem(chave) {
      const ativo = $('rya-' + chave).checked;
      const it = RY.cfg.catalogo.find(i => i.chave === chave);
      if (ativo && it && !it.ativo && it.depende_jogo && !confirm('Atenção: ' + it.depende_jogo + '\n\nLigar mesmo assim?')) return;
      try { await api('PUT', '/royalties/catalogo/' + chave, { custo: Number($('ryc-' + chave).value), ativo }); showAlert('Prêmio salvo', 'success'); loadRoy(); }
      catch (e) { showAlert(e.message, 'error'); }
    }
    async function ryCarroTemporada() {
      const c = prompt('Nome do carro da temporada (igual ao nome no jogo):'); if (c == null) return;
      try { await api('PUT', '/royalties/catalogo/carro_temporada', { carro: c }); showAlert('Carro da Temporada: ' + (c || 'nenhum'), 'success'); loadRoy(); }
      catch (e) { showAlert(e.message, 'error'); }
    }
    async function rySalvarMotivo(chave, livre) {
      const body = { ativo: $('ryma-' + chave).checked };
      if (!livre) body.valor = Number($('rym-' + chave).value);
      try { await api('PUT', '/royalties/motivos/' + chave, body); showAlert('Motivo salvo', 'success'); loadRoy(); }
      catch (e) { showAlert(e.message, 'error'); }
    }

    // ---------------------------------------------------------------- PDs (16/10)
    // O painel NAO decide se pode reverter: o site manda `pode_reverter` + `motivo_nao`
    // por linha (src/pd.js), e o back confere de novo no clique.
    let PDS = { pds: [], pode_reverter: false }, pdTimer = null, PD_ALVO = null;
    const PD_TIPO = { pd_faccao: ['PD · pneu', 'err'], pd_estado: ['PD · tribunal', 'err'], pd: ['PD', 'err'], reset: ['Reset (staff)', 'warn'] };
    async function loadPds() {
      try {
        const q = ($('pd-busca').value || '').trim();
        PDS = await api('GET', '/pds' + (q ? '?q=' + encodeURIComponent(q) : ''));
      } catch (e) { $('pd-body').innerHTML = '<tr><td colspan="9" class="empty">' + esc(e.message) + '</td></tr>'; return; }
      const l = PDS.pds || [];
      const ativos = l.filter(p => p.estado !== 'revertido').length;
      $('pd-conta').textContent = ativos + (ativos === 1 ? ' PD valendo' : ' PDs valendo') + ' · ' + (l.length - ativos) + ' revertido(s)';
      $('pd-body').innerHTML = l.length ? l.map(p => {
        const t = PD_TIPO[p.tipo] || [p.tipo, ''];
        const r = p.resumo || {};
        const tinha = (r.dinheiro != null || r.banco != null)
          ? 'R$ ' + fmtN(r.dinheiro) + ' + banco R$ ' + fmtN(r.banco) + '<br><span class="muted" style="font-size:.72rem">lvl ' + esc(r.level || '?') + ' · ' + fmtN(r.carros) + ' carro(s)' + (p.corps && p.corps.length ? ' · ' + esc(p.corps.join(', ')) : '') + '</span>'
          : '<span class="muted">—</span>';
        let sit;
        if (p.estado === 'revertido') {
          sit = '<span class="pill ok">REVERTIDO</span><div class="muted" style="font-size:.72rem">por ' + esc(p.rev && p.rev.por || '?') + (p.rev && p.rev.feito_em ? ' · ' + fmtT(p.rev.feito_em) : '') + '</div>'
            + (p.rev && p.rev.msg ? '<div style="font-size:.72rem">' + esc(p.rev.msg) + '</div>' : '');
        } else if (p.rev && p.rev.estado === 'pendente') {
          sit = '<span class="pill warn">NA FILA</span><div class="muted" style="font-size:.72rem">esperando um servidor do jogo (precisa de servidor aberto)</div>';
        } else if (p.rev && p.rev.estado === 'executando') {
          sit = '<span class="pill info">DEVOLVENDO…</span><div class="muted" style="font-size:.72rem">tentativa ' + (p.rev.tentativas || 1) + '</div>';
        } else if (p.rev && p.rev.estado === 'erro') {
          sit = '<span class="pill err">FALHOU</span><div style="font-size:.72rem;color:#B23227">' + esc(p.rev.msg || '') + '</div><div class="muted" style="font-size:.72rem">nada foi mudado no site — dá pra tentar de novo</div>';
        } else {
          sit = '<span class="pill">VALENDO</span>' + (p.backup ? '' : '<div class="muted" style="font-size:.72rem">sem backup</div>');
        }
        let acao = '';
        if (PDS.pode_reverter) {
          if (p.pode_reverter) acao = '<button class="d" onclick="abrirReverter(' + p.id + ')"><svg class="ic" aria-hidden="true"><use href="/icones.svg#voltar"/></svg>' + (p.rev && p.rev.estado === 'erro' ? 'Tentar de novo' : 'Reverter') + '</button>';
          else if (p.rev && p.rev.estado === 'pendente') acao = '<button onclick="cancelarReverter(' + p.id + ')"><svg class="ic" aria-hidden="true"><use href="/icones.svg#x"/></svg>Cancelar pedido</button>';
          else if (p.estado !== 'revertido' && p.motivo_nao) acao = '<span class="muted" style="font-size:.72rem">' + esc(p.motivo_nao) + '</span>';
        }
        return '<tr' + (p.estado === 'revertido' ? ' style="opacity:.6"' : '') + '>'
          + '<td class="muted" style="white-space:nowrap">' + fmtT(p.quando) + '</td>'
          + '<td><b>' + esc(p.nome || '—') + '</b><div class="muted" style="font-size:.7rem">ID ' + esc(p.roblox_id) + '</div></td>'
          + '<td><span class="pill ' + t[1] + '">' + esc(t[0]) + '</span></td>'
          + '<td>' + esc(p.por_nome || '—') + (p.corp ? '<div class="muted" style="font-size:.72rem">' + esc(p.corp) + '</div>' : '') + '</td>'
          + '<td style="font-size:.78rem">' + esc(p.motivo || '—') + '</td>'
          + '<td style="font-size:.75rem">' + (p.presentes && p.presentes.length ? esc(p.presentes.join(', ')) : '<span class="muted">—</span>') + '</td>'
          + '<td style="font-size:.78rem">' + tinha + '</td>'
          + '<td>' + sit + '</td>'
          + '<td><div class="acts">' + acao + '</div></td></tr>';
      }).join('') : '<tr><td colspan="9" class="empty">Nenhum PD registrado ainda.</td></tr>';
      // pedido andando: atualiza sozinho até terminar
      clearTimeout(pdTimer);
      if (l.some(p => p.rev && (p.rev.estado === 'pendente' || p.rev.estado === 'executando'))
          && $('panel-pds').classList.contains('active')) pdTimer = setTimeout(loadPds, 4000);
    }
    function abrirReverter(id) {
      const p = (PDS.pds || []).find(x => x.id === id); if (!p) return;
      PD_ALVO = p;
      $('pdm-title').textContent = 'Reverter PD de ' + (p.nome || p.roblox_id);
      $('pdm-sub').innerHTML = esc(fmtT(p.quando)) + ' · ' + esc(p.motivo || '') + '<br>'
        + 'O jogo devolve o personagem como estava antes do PD. Se ele estiver online vai ser desconectado pra entrar de novo já com tudo. '
        + 'O que ele ganhou com o personagem novo depois do PD <b>some</b>.';
      $('pdm-motivo').value = '';
      $('pdmodal').classList.add('active');
      setTimeout(() => $('pdm-motivo').focus(), 50);
    }
    async function confirmaReverter() {
      if (!PD_ALVO) return;
      const motivo = ($('pdm-motivo').value || '').trim();
      if (!motivo) return showAlert('Escreva o motivo', 'error');
      $('pdm-ok').disabled = true;
      try {
        const r = await api('POST', '/pds/' + PD_ALVO.id + '/reverter', { motivo });
        $('pdmodal').classList.remove('active');
        showAlert(r.servidores ? 'Pedido enviado — o jogo devolve em segundos' : 'Pedido na fila — vai rodar quando um servidor do jogo abrir', 'success');
        loadPds();
      } catch (e) { showAlert(e.message, 'error'); }
      finally { $('pdm-ok').disabled = false; }
    }
    async function cancelarReverter(id) {
      if (!confirm('Cancelar o pedido de reverter?')) return;
      try { await api('POST', '/pds/' + id + '/cancelar'); showAlert('Pedido cancelado', 'success'); loadPds(); }
      catch (e) { showAlert(e.message, 'error'); }
    }

    // ---------------------------------------------------------------- ECONOMIA (15/10, só o Dono)
    let ECON = null;
    const fR = n => n == null ? '?' : 'R$ ' + Math.round(Number(n)).toLocaleString('pt-BR');
    const fP = v => v == null ? '–' : (v * 100).toLocaleString('pt-BR', { minimumFractionDigits: v !== 0 && Math.abs(v) < 0.01 ? 2 : 1, maximumFractionDigits: 2 }) + '%';
    async function loadEcon() {
      try {
        ECON = await api('GET', '/economia?dias=' + $('ec-dias').value);
      } catch (e) { $('ec-movs').innerHTML = '<tr><td colspan="10" class="empty">' + esc(e.message) + '</td></tr>'; return; }
      const c = ECON.circulando, s = ECON.staff;
      $('ec-total').textContent = fR(c.total);
      $('ec-total-sub').textContent = fmtN(c.jogadores) + ' jogadores · ' + (c.corps || []).length + ' caixas';
      $('ec-jog').textContent = fR(c.carteira + c.banco);
      $('ec-jog-sub').textContent = 'carteira ' + fR(c.carteira) + ' · banco ' + fR(c.banco);
      $('ec-cx').textContent = fR(c.caixas);
      $('ec-cx-sub').textContent = fP(c.total ? c.caixas / c.total : 0) + ' do total';
      const teto = s.liquido + (s.semAntesValor || 0);
      $('ec-staff').textContent = fR(teto);
      $('ec-staff-sub').textContent = 'até ' + fP(c.total ? teto / c.total : 0) + ' da cidade · certo: ' + fR(s.liquido)
        + (s.desconhecidos ? ' · + até ' + fR(s.semAntesValor) + ' em ' + s.desconhecidos + ' "setar" antigos (o jogo não guardava quanto a pessoa tinha antes)' : '')
        + ' · ' + s.acoes + ' ações';
      $('ec-rank').innerHTML = ECON.ranking.length ? ECON.ranking.map(r => '<tr>'
        + '<td><b>' + esc(r.staff) + '</b></td><td>' + esc(r.cargo || '—') + '</td>'
        + '<td style="color:#B23227">' + fR(r.criado) + '</td><td>' + fR(r.tirado) + '</td>'
        + '<td>' + (r.setadoSemAntes ? fR(r.setadoSemAntes) + ' <span class="muted">(' + r.desconhecidos + 'x)</span>' : '—') + '</td>'
        + '<td><b>' + fR(r.teto) + '</b></td><td>' + fP(r.pctTeto) + '</td>'
        + '<td>' + r.acoes + '</td>'
        + '<td>' + r.alvos + '</td>'
        + '<td>' + (r.paraSi ? '<span class="pill err">' + r.paraSi + 'x · ' + (r.paraSiSetado ? 'até ' + fR(r.paraSiValor + r.paraSiSetado) : fR(r.paraSiValor)) + '</span>' : '—') + '</td>'
        + '<td class="muted">' + (r.ultimo ? fmtT(r.ultimo) : '') + '</td></tr>').join('')
        : '<tr><td colspan="11" class="empty">Nenhum dinheiro mexido pela staff no período.</td></tr>';
      $('ec-ricos').innerHTML = ECON.ricos.map(r => '<tr><td>' + esc(r.nome || r.roblox_id) + '</td><td>' + fR(r.bolso) + '</td><td>' + fR(r.banco)
        + '</td><td><b>' + fR(r.total) + '</b></td><td>' + fP(r.pct) + '</td></tr>').join('') || '<tr><td colspan="5" class="empty">—</td></tr>';
      $('ec-corps').innerHTML = (c.corps || []).map(k => '<tr><td>' + esc(k.nome) + '</td><td>' + esc(k.tipo || '') + '</td><td>' + fR(k.saldo)
        + '</td><td>' + fP(c.total ? Number(k.saldo) / c.total : 0) + '</td></tr>').join('') || '<tr><td colspan="4" class="empty">—</td></tr>';
      $('ec-roy').innerHTML = (ECON.royalties || []).map(l => '<tr><td class="muted">' + fmtT(l.criado_em) + '</td><td><b>' + esc(l.por_nome || '?') + '</b></td>'
        + '<td>' + esc(l.alvo || l.roblox_id) + '</td><td>' + (l.tipo === 'estorno' ? '<span class="pill warn">estorno</span>' : 'crédito') + '</td>'
        + '<td style="font-weight:700">' + (l.valor > 0 ? '+' : '') + fmtN(l.valor) + '</td><td>' + esc(l.motivo) + '</td>'
        + '<td class="muted" style="font-size:.78rem;max-width:260px;overflow-wrap:anywhere">' + esc(l.comprovacao || '') + '</td></tr>').join('')
        || '<tr><td colspan="7" class="empty">Nenhum Royalty lançado no período.</td></tr>';
      desenhaMovs();
    }
    function desenhaMovs() {
      if (!ECON) return;
      const f = ($('ec-filtro').value || '').toLowerCase().trim();
      const soSinal = $('ec-so-sinal').checked;
      const ACAO = { setar: 'Setou', dar: 'Deu', tirar: 'Tirou' };
      const linhas = ECON.movimentos.filter(m => (!f || String(m.staff).toLowerCase().includes(f) || String(m.alvo || '').toLowerCase().includes(f))
        && (!soSinal || m.paraSi || m.repetido));
      $('ec-movs').innerHTML = linhas.length ? linhas.map(m => {
        const cor = m.delta == null ? '' : (m.delta > 0 ? 'color:#B23227' : 'color:#1D7A45');
        const sinais = (m.paraSi ? ' <span class="pill err">PRA SI</span>' : '') + (m.repetido ? ' <span class="pill warn">REPETIDO</span>' : '');
        return '<tr' + (m.paraSi ? ' style="background:#B2322710"' : '') + '><td class="muted">' + fmtT(m.quando) + '</td>'
          + '<td><b>' + esc(m.staff) + '</b>' + (m.cargo ? '<br><span class="muted" style="font-size:.72rem">' + esc(m.cargo) + '</span>' : '') + '</td>'
          + '<td>' + esc(m.origem) + '</td><td>' + esc(m.alvo || '—') + sinais + '</td><td>' + esc(m.conta) + '</td>'
          + '<td>' + (ACAO[m.acao] || esc(m.acao)) + ' ' + fR(m.valor) + '</td>'
          + '<td>' + (m.antes != null ? fR(m.antes) + ' → ' + fR(m.depois) : '<span class="muted">sem registro</span>') + '</td>'
          + '<td style="font-weight:700;' + cor + '">' + (m.delta == null ? '<span class="muted" style="font-weight:400">até +' + fR(m.valor) + '</span>' : (m.delta > 0 ? '+' : '') + fR(m.delta)) + '</td>'
          + '<td>' + fP(m.pct) + '</td><td class="muted" style="font-size:.78rem">' + esc(m.motivo || '') + '</td></tr>';
      }).join('') : '<tr><td colspan="10" class="empty">Nada no período.</td></tr>';
    }

    // ---------- estado ao vivo ----------
    let STATE = { players: [], servers: [], catalog: null };
    async function loadState() {
      try {
        STATE = await api('GET', '/state');
        $('st-servers').textContent = STATE.servers.length;
        $('st-players').textContent = STATE.players.length;
        $('st-upd').textContent = new Date().toLocaleTimeString('pt-BR');
        renderPlayers();
        renderClima();
        if (typeof tsCatalogo === 'function' && $('panel-testers').classList.contains('active')) tsCatalogo();
        $('srv-list').innerHTML = STATE.servers.length ? STATE.servers.map(s => '<div><span class="pill info">' + esc(s.job_id.slice(0, 8)) + '</span> ' + s.n + ' jogador(es) · visto ' + fmtT(s.updated_at) + '</div>').join('') : 'Nenhum servidor mandou heartbeat nos últimos 90s. O jogo precisa estar rodando com o AdminBridge ativo.';
      } catch (e) { showAlert('Erro ao carregar estado: ' + e.message, 'error'); }
    }
    $('pl-busca').addEventListener('input', renderPlayers);
    function renderPlayers() {
      const q = $('pl-busca').value.toLowerCase().trim();
      const list = STATE.players.filter(p => !q || String(p.name).toLowerCase().includes(q) || String(p.userId).includes(q));
      if (!list.length) { $('pl-body').innerHTML = '<tr><td colspan="8" class="empty">' + (STATE.players.length ? 'Nenhum jogador bate com a busca' : 'Nenhum jogador online') + '</td></tr>'; return; }
      $('pl-body').innerHTML = list.map(p => {
        const hp = Math.max(0, Math.min(100, Number(p.health) || 0));
        const pos = p.pos ? p.pos.map(v => Math.round(v)).join(', ') : '–';
        return '<tr>' +
          '<td><b>' + esc(p.name) + '</b><div class="muted" style="font-size:.7rem">ID ' + esc(p.userId) + ' · srv ' + esc(String(p.job_id).slice(0, 6)) + (p.preso ? ' · <span class="pill err">preso</span>' : '') + '</div></td>' +
          '<td><span class="hbar"><i style="width:' + hp + '%"></i></span>' + hp + '</td>' +
          '<td>R$ ' + fmtN(p.dinheiro) + '</td><td>R$ ' + fmtN(p.banco) + '</td>' +
          '<td>' + esc(p.emprego || '—') + '</td><td>' + esc(p.level || '–') + '</td>' +
          '<td class="muted" style="font-size:.72rem">' + esc(pos) + '</td>' +
          '<td><div class="acts">' +
            btnSe('dinheiro_set', '<button onclick="openCmd(\'dinheiro_set\',' + p.userId + ')"><svg class="ic" aria-hidden="true"><use href="/icones.svg#dinheiro"/></svg>Dinheiro</button>') +
            btnSe('item_add',      '<button onclick="openCmd(\'item_add\',' + p.userId + ')"><svg class="ic" aria-hidden="true"><use href="/icones.svg#mochila"/></svg>Item</button>') +
            btnSe('emprego',       '<button onclick="openCmd(\'emprego\',' + p.userId + ')"><svg class="ic" aria-hidden="true"><use href="/icones.svg#pasta-trabalho"/></svg>Emprego</button>') +
            btnSe('tp_local',      '<button onclick="openCmd(\'tp_local\',' + p.userId + ')"><svg class="ic" aria-hidden="true"><use href="/icones.svg#pino"/></svg>TP</button>') +
            btnSe('curar',         '<button onclick="quick(\'curar\',' + p.userId + ')"><svg class="ic" aria-hidden="true"><use href="/icones.svg#cruz"/></svg>Curar</button>') +
            (p.preso ? btnSe('soltar', '<button onclick="quick(\'soltar\',' + p.userId + ')"><svg class="ic" aria-hidden="true"><use href="/icones.svg#cadeado-aberto"/></svg>Soltar</button>') : '') +
            btnSe('noclip',        '<button onclick="openCmd(\'noclip\',' + p.userId + ')"><svg class="ic" aria-hidden="true"><use href="/icones.svg#fantasma"/></svg>Noclip</button>') +
            btnSe('mensagem',      '<button onclick="openCmd(\'mensagem\',' + p.userId + ')"><svg class="ic" aria-hidden="true"><use href="/icones.svg#carta"/></svg>Msg</button>') +
            '<button onclick="openCmd(\'mais\',' + p.userId + ')"><svg class="ic" aria-hidden="true"><use href="/icones.svg#ajustes"/></svg>Mais</button>' +
            btnSe('kick',          '<button class="d" onclick="openCmd(\'kick\',' + p.userId + ')"><svg class="ic" aria-hidden="true"><use href="/icones.svg#sair"/></svg>Kick</button>') +
            btnSe('ban',           '<button class="d" onclick="openCmd(\'ban\',' + p.userId + ')"><svg class="ic" aria-hidden="true"><use href="/icones.svg#martelo"/></svg>Ban</button>') +
          '</div></td></tr>';
      }).join('');
    }
    setInterval(loadState, 5000);
    // /eu primeiro: sem o cargo em mãos a tabela de jogadores nasceria sem botão
    carregarEu().catch(e => showAlert('Não consegui ler seu cargo: ' + e.message, 'error')).finally(loadState);

    // ---------- comandos ----------
    function cat(k, fallback) { return (STATE.catalog && Array.isArray(STATE.catalog[k]) && STATE.catalog[k].length) ? STATE.catalog[k] : fallback; }
    const FORMS = {
      dinheiro_set: { t: 'Dinheiro', f: [
        { k: 'modo', l: 'Operação', type: 'select', opts: [['set', 'Definir carteira'], ['add', 'Adicionar (negativo tira)'], ['banco', 'Definir banco']] },
        { k: 'valor', l: 'Valor (R$)', type: 'number', v: 1000 }] },
      item_add: { t: 'Item', f: [
        { k: 'modo', l: 'Operação', type: 'select', opts: [['add', 'Dar item'], ['remove', 'Tirar item']] },
        { k: 'item', l: 'Item', type: 'datalist', opts: () => cat('itens', []) },
        { k: 'qtd', l: 'Quantidade', type: 'number', v: 1 }] },
      emprego: { t: 'Emprego', f: [{ k: 'emprego', l: 'Emprego (vazio = desempregado)', type: 'datalist', opts: () => cat('empregos', []) }] },
      tp_local: { t: 'Teleporte', f: [
        { k: 'modo', l: 'Destino', type: 'select', opts: [['local', 'Local do mapa'], ['jogador', 'Até um jogador'], ['coord', 'Coordenada'], ['trazer', 'Trazer outro jogador até este']] },
        { k: 'local', l: 'Local', type: 'select', opts: () => cat('locais', []).map(l => [l.nome, l.nome]) },
        { k: 'para', l: 'Jogador', type: 'datalist', opts: () => STATE.players.map(p => p.name) },
        { k: 'x', l: 'X', type: 'number', v: 0 }, { k: 'y', l: 'Y', type: 'number', v: 50 }, { k: 'z', l: 'Z', type: 'number', v: 0 }] },
      mensagem: { t: 'Mensagem privada', f: [{ k: 'texto', l: 'Texto', type: 'text' }] },
      noclip: { t: 'Noclip (voar / atravessar paredes)', f: [
        { k: 'modo', l: 'Ação', type: 'select', opts: [['on', 'Ativar'], ['off', 'Desativar']] },
        { k: 'velocidade', l: 'Velocidade (studs/s · Shift no jogo dá boost)', type: 'number', v: 80 }] },
      kick: { t: 'Expulsar', f: [{ k: 'motivo', l: 'Motivo', type: 'text', v: 'Expulso por um administrador' }], danger: true },
      ban: { t: 'Banir', f: [{ k: 'motivo', l: 'Motivo', type: 'text', v: 'Banido por um administrador' },
        { k: 'dur', l: 'Duração', type: 'number', v: 24 },
        { k: 'unid', l: 'Unidade', type: 'select', opts: [['h', 'horas'], ['d', 'dias'], ['p', 'permanente']] }], danger: true },
      mais: { t: 'Mais ações', f: [
        { k: 'modo', l: 'Ação', type: 'select', opts: [['level_set', 'Definir level'], ['slots_set', 'Definir slots da barra (1–6)'], ['carro_add', 'Dar carro'], ['carro_remove', 'Tirar carro'], ['matar', 'Matar (derrubar)'], ['corp_refresh', 'Atualizar corporação (site → jogo)'], ['resetar_dados', 'RESETAR DADOS (zera tudo)']] },
        { k: 'level', l: 'Level', type: 'number', v: 1 }, { k: 'slots', l: 'Slots', type: 'number', v: 4 },
        { k: 'carro', l: 'Carro', type: 'datalist', opts: () => cat('carros', []) }] },
    };
    let MODAL = null;
    function openCmd(kind, userId) {
      const p = STATE.players.find(x => Number(x.userId) === Number(userId));
      if (!p) return showAlert('Jogador saiu', 'error');
      const spec = FORMS[kind];
      MODAL = { kind, p, spec };
      $('m-title').textContent = spec.t + ' — ' + p.name;
      $('m-sub').textContent = 'ID ' + p.userId + ' · carteira R$ ' + fmtN(p.dinheiro) + ' · ' + (p.emprego || 'sem emprego');
      $('m-ok').className = 'btn' + (spec.danger ? ' danger' : '');
      $('m-fields').innerHTML = spec.f.map(f => {
        let inp;
        if (f.type === 'select') {
          const opts = typeof f.opts === 'function' ? f.opts() : f.opts;
          inp = '<select id="mf-' + f.k + '">' + opts.map(o => '<option value="' + esc(o[0]) + '">' + esc(o[1]) + '</option>').join('') + '</select>';
        } else if (f.type === 'datalist') {
          const opts = typeof f.opts === 'function' ? f.opts() : f.opts;
          inp = '<input id="mf-' + f.k + '" list="dl-' + f.k + '" autocomplete="off"><datalist id="dl-' + f.k + '">' + opts.map(o => '<option value="' + esc(o) + '">').join('') + '</datalist>';
        } else {
          inp = '<input id="mf-' + f.k + '" type="' + f.type + '" value="' + esc(f.v == null ? '' : f.v) + '">';
        }
        return '<div class="fg" id="mfw-' + f.k + '"><label>' + esc(f.l) + '</label>' + inp + '</div>';
      }).join('');
      $('modal').classList.add('active');
      const modo = $('mf-modo'); if (modo) { modo.addEventListener('change', toggleFields); toggleFields(); }
    }
    function toggleFields() {
      const modo = $('mf-modo') && $('mf-modo').value;
      const show = (ids) => ['local', 'para', 'x', 'y', 'z', 'level', 'slots', 'carro'].forEach(k => { const w = $('mfw-' + k); if (w) w.style.display = ids.includes(k) ? '' : 'none'; });
      if (MODAL.kind === 'tp_local') show(modo === 'local' ? ['local'] : modo === 'jogador' ? ['para'] : modo === 'trazer' ? ['para'] : ['x', 'y', 'z']);
      if (MODAL.kind === 'mais') show(modo === 'level_set' ? ['level'] : modo === 'slots_set' ? ['slots'] : (modo === 'carro_add' || modo === 'carro_remove') ? ['carro'] : []);
    }
    function closeModal() { $('modal').classList.remove('active'); MODAL = null; }
    const val = k => { const e = $('mf-' + k); return e ? e.value : undefined; };
    async function submitModal() {
      if (!MODAL) return;
      const { kind, p } = MODAL;
      let tipo = kind, payload = {};
      if (kind === 'dinheiro_set') { const m = val('modo'); tipo = m === 'add' ? 'dinheiro_add' : m === 'banco' ? 'banco_set' : 'dinheiro_set'; payload = { valor: Number(val('valor')) }; }
      else if (kind === 'item_add') { tipo = val('modo') === 'remove' ? 'item_remove' : 'item_add'; payload = { item: val('item'), qtd: Number(val('qtd')) || 1 }; }
      else if (kind === 'emprego') { payload = { emprego: val('emprego') || '' }; }
      else if (kind === 'tp_local') { const m = val('modo'); if (m === 'local') { tipo = 'tp_local'; payload = { local: val('local') }; } else if (m === 'jogador') { tipo = 'tp_jogador'; payload = { para: val('para') }; } else if (m === 'trazer') { tipo = 'trazer'; payload = { de: val('para') }; } else { tipo = 'tp_coord'; payload = { x: Number(val('x')), y: Number(val('y')), z: Number(val('z')) }; } }
      else if (kind === 'mensagem') { payload = { texto: val('texto') }; }
      else if (kind === 'noclip') { tipo = 'noclip'; payload = { ativar: val('modo') === 'on', velocidade: Number(val('velocidade')) || 80 }; }
      else if (kind === 'kick') { payload = { motivo: val('motivo') }; }
      else if (kind === 'ban') { const h = horasBan(val('dur'), val('unid')); if (h == null) return showAlert('Duração inválida', 'error'); payload = { roblox_id: p.userId, motivo: val('motivo'), horas: h }; }
      else if (kind === 'mais') { tipo = val('modo'); if (tipo === 'level_set') payload = { level: Number(val('level')) }; if (tipo === 'slots_set') payload = { slots: Number(val('slots')) }; if (tipo === 'carro_add' || tipo === 'carro_remove') payload = { carro: val('carro') }; if (tipo === 'resetar_dados' && !confirm('ZERAR todos os dados de ' + p.name + '? Dá pra desfazer depois na aba PDs.')) return; }
      try {
        await api('POST', '/command', { tipo, target_roblox_id: p.userId, target_name: p.name, payload });
        showAlert('Comando "' + tipo + '" enviado pra ' + p.name, 'success');
        closeModal();
        setTimeout(loadState, 2500);
      } catch (e) { showAlert(e.message, 'error'); }
    }
    async function quick(tipo, userId) {
      const p = STATE.players.find(x => Number(x.userId) === Number(userId)); if (!p) return;
      try { await api('POST', '/command', { tipo, target_roblox_id: p.userId, target_name: p.name, payload: {} }); showAlert(tipo + ' → ' + p.name, 'success'); } catch (e) { showAlert(e.message, 'error'); }
    }
    const CLIMA_NOMES = { '-1': 'Automático', '0': 'Sem chuva', '1': 'Chuva fraca', '2': 'Chuva média', '3': 'Tempestade' };
    function renderClima() {
      const c = STATE.config && STATE.config.clima ? Number(STATE.config.clima.chuva) : -1;
      $('clima-atual').textContent = CLIMA_NOMES[String(c)] || 'Automático';
      document.querySelectorAll('#clima-btns button').forEach(b => b.className = 'btn ' + (Number(b.dataset.chuva) === c ? '' : 'sec'));
    }
    async function setClima(chuva) {
      try {
        const r = await api('POST', '/command', { tipo: 'clima', payload: { chuva } });
        STATE.config = Object.assign({}, STATE.config, { clima: { chuva } }); renderClima();
        showAlert(r.ids.length ? 'Clima enviado pra ' + r.ids.length + ' servidor(es)' : 'Clima salvo (nenhum servidor online agora)', 'success');
      } catch (e) { showAlert(e.message, 'error'); }
    }
    async function cmdServer(tipo, payload) {
      try { const r = await api('POST', '/command', { tipo, payload }); showAlert('Enviado pra ' + r.ids.length + ' servidor(es)', 'success'); } catch (e) { showAlert(e.message, 'error'); }
    }
    // ban por tempo: devolve horas (0 = permanente) ou null se inválido
    function horasBan(dur, unid) {
      if (unid === 'p') return 0;
      const n = Number(dur);
      if (!Number.isFinite(n) || n <= 0) return null;
      const h = unid === 'd' ? n * 24 : n;
      return h > 87600 ? null : h;
    }
    function textoBan(h) { return h === 0 ? 'PERMANENTE' : (h % 24 === 0 ? (h / 24) + ' dia(s)' : h + ' hora(s)'); }
    async function banOffline() {
      const id = Number($('off-id').value); if (!id) return showAlert('Informe o Roblox ID', 'error');
      const h = horasBan($('off-dur').value, $('off-unid').value); if (h == null) return showAlert('Duração inválida', 'error');
      if (!confirm('Banir o Roblox ID ' + id + ' — ' + textoBan(h) + '?')) return;
      try { await api('POST', '/command', { tipo: 'ban', payload: { roblox_id: id, motivo: $('off-motivo').value, horas: h } }); showAlert('Ban enviado (' + textoBan(h) + ')', 'success'); } catch (e) { showAlert(e.message, 'error'); }
    }
    async function unbanOffline() {
      const id = Number($('off-id').value); if (!id) return showAlert('Informe o Roblox ID', 'error');
      try { await api('POST', '/command', { tipo: 'unban', payload: { roblox_id: id } }); showAlert('Desban enviado', 'success'); } catch (e) { showAlert(e.message, 'error'); }
    }

    // ---------- logs ----------
    async function loadLogs() {
      try {
        const tipo = $('log-tipo').value, q = $('log-q').value.trim();
        const d = await api('GET', '/logs?tipo=' + encodeURIComponent(tipo) + '&q=' + encodeURIComponent(q) + '&limit=300');
        $('log-counts').textContent = d.counts.map(c => c.tipo + ': ' + c.n).join(' · ');
        if (!d.logs.length) { $('log-body').innerHTML = '<tr><td colspan="5" class="empty">Sem registros</td></tr>'; return; }
        const cls = { abate: 'err', morte: 'err', tiro: 'warn', entrou: 'ok', saiu: '', admin: 'info', admin_jogo: 'info', kick: 'warn', ban: 'err', seguranca: 'err', acesso: 'warn' };
        $('log-body').innerHTML = d.logs.map(l => '<tr><td class="muted" style="white-space:nowrap">' + fmtT(l.quando) + '</td><td><span class="pill ' + (cls[l.tipo] || '') + '">' + esc(l.tipo) + '</span></td><td>' + esc(l.jogador || '—') + '</td><td>' + esc(l.alvo || '—') + '</td><td><pre class="det">' + esc(Object.entries(l.detalhe || {}).map(([k, v]) => k + '=' + (typeof v === 'object' ? JSON.stringify(v) : v)).join('  ')) + '</pre></td></tr>').join('');
      } catch (e) { showAlert(e.message, 'error'); }
    }
    async function resetLogs() {
      const tipo = $('log-tipo').value;
      if (!confirm('Apagar logs (' + tipo + ')? Não tem volta.')) return;
      try { const r = await api('DELETE', '/logs?tipo=' + encodeURIComponent(tipo)); showAlert(r.apagados + ' registros apagados', 'success'); loadLogs(); } catch (e) { showAlert(e.message, 'error'); }
    }

    // ---------- usuários: CARGO DE ADMIN (19/09) ----------
    // O admin deixou de ser liga/desliga. DONO é quem foi setado direto no banco
    // (is_admin com admin_cargo NULL) — o painel não concede nem tira DONO.
    let USERS = [];
    async function loadUsers() { try { USERS = (await api('GET', '/users')).users; renderUsers(); } catch (e) { showAlert(e.message, 'error'); } }

    function selo(u) {
      if (!u.cargo) return '<span class="pill">usuário</span>';
      return '<span class="pill" style="background:' + esc(u.cargo_cor) + '22;color:' + esc(u.cargo_cor) + ';border:1px solid ' + esc(u.cargo_cor) + '55">' + esc(u.cargo_nome) + '</span>';
    }

    function renderUsers() {
      const q = ($('us-busca').value || '').toLowerCase();
      const list = USERS.filter(u => !q || [u.discord_username, u.roblox_username, u.roblox_id, u.id].some(v => v != null && String(v).toLowerCase().includes(q)));
      $('us-body').innerHTML = list.map(u => {
        let acao;
        if (u.cargo === 'dono') {
          acao = '<span class="muted" style="font-size:.78rem">dono do jogo · fixo no código</span>';
        } else if (u.is_placeholder) {
          acao = '<span class="muted" style="font-size:.78rem">precisa entrar com Discord</span>';
        } else if (!u.posso_mexer) {
          acao = '<span class="muted" style="font-size:.78rem">fora do seu alcance</span>';
        } else {
          const opts = ['<option value=""' + (u.cargo ? '' : ' selected') + '>— sem cargo —</option>']
            .concat((EU.ATRIBUIVEIS || []).map(c => {
              const podeDar = EU.nivel > (EU.CARGOS[c] || {}).nivel;
              return '<option value="' + c + '"' + (u.cargo === c ? ' selected' : '') + (podeDar ? '' : ' disabled') + '>' + esc((EU.CARGOS[c] || {}).nome || c) + '</option>';
            }));
          acao = '<select class="inp sm" onchange="setCargoAdmin(' + u.id + ', this.value, this)">' + opts.join('') + '</select>';
        }
        return '<tr><td>' + (u.is_placeholder ? '<span class="muted">sem Discord</span>' : esc(u.discord_username)) + ' <span class="muted" style="font-size:.7rem">#' + u.id + '</span></td>' +
          '<td>' + (u.roblox_id ? esc(u.roblox_username || '') + ' <span class="muted" style="font-size:.7rem">' + u.roblox_id + '</span>' : '<span class="muted">não vinculado</span>') + '</td>' +
          '<td>' + selo(u) + '</td>' +
          '<td>' + acao + '</td></tr>';
      }).join('');
    }

    // NOME PROPRIO de proposito: existe outra setCargo mais abaixo, a do cargo em
    // CORPORACAO. Como as duas sao 'function' no mesmo escopo, a de baixo apagava
    // esta e o seletor de cargo de admin caia na funcao errada, reclamando
    // "Selecione um usuario". Foi o bug que o Julio pegou em 19/09.
    async function setCargoAdmin(id, cargo, el) {
      const nome = cargo ? ((EU.CARGOS[cargo] || {}).nome || cargo) : null;
      const msg = nome
        ? ('Dar o cargo ' + nome + ' a este usuário?\n\n' + ((EU.CARGOS[cargo] || {}).desc || ''))
        : 'Tirar o admin deste usuário?';
      if (!confirm(msg)) { loadUsers(); return; }
      if (el) el.disabled = true;
      try { await api('POST', '/users/' + id + '/cargo', { cargo: cargo || null }); showAlert(nome ? ('Agora é ' + nome) : 'Admin retirado', 'success'); }
      catch (e) { showAlert(e.message, 'error'); }
      loadUsers();
    }

    // legado: se alguma tela velha ainda chamar
    async function setAdmin(id, value) { return setCargoAdmin(id, value ? 'moderador' : null, null); }

    // ---------- cargos ----------
    let CORPS = { corps: [], ranks: [] }, CG_SEL = null;
    async function loadCargos() {
      try {
        if (!USERS.length) USERS = (await api('GET', '/users')).users;
        CORPS = await api('GET', '/corps');
        $('cg-corp').innerHTML = CORPS.corps.map(c => '<option value="' + c.id + '">' + esc(c.name) + '</option>').join('');
        fillRanks();
