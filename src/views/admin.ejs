    function toggleSel(rid, el) { if (el.checked) REG_SEL.add(Number(rid)); else REG_SEL.delete(Number(rid)); updateSelBar(); }
    function toggleAll(el) { (REG.players || []).forEach(p => { const rid = Number(p.roblox_id); if (el.checked) REG_SEL.add(rid); else REG_SEL.delete(rid); }); renderRegistro(); }
    function limparSel() { REG_SEL.clear(); const a = $('rg-all'); if (a) a.checked = false; renderRegistro(); }
    function updateSelBar() { const n = REG_SEL.size; $('rg-sel-n').textContent = n; $('rg-lote-bar').style.display = n ? 'flex' : 'none'; }
    function openItem(rid) {
      const p = (REG.players || []).find(x => Number(x.roblox_id) === Number(rid));
      if (!p) return;
      RITEM = p;
      $('ri-title').textContent = 'Dar item — ' + (p.nome || p.roblox_id);
      $('ri-sub').textContent = p.online ? 'Está online — o item vai na hora.' : 'Offline — entra na fila e o jogo entrega assim que ele logar.';
      $('ri-itens').innerHTML = cat('itens', []).map(it => '<option value="' + esc(it) + '">').join('');
      $('ri-item').value = ''; $('ri-qtd').value = 1;
      $('rmodal').classList.add('active');
