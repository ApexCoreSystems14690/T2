        $('aud-body').innerHTML = a.audit.map(x => '<tr><td class="muted" style="white-space:nowrap">' + fmtT(x.created_at) + '</td><td>' + esc(x.admin_nome) + '</td><td>' + esc(x.acao) + '</td><td><pre class="det">' + esc(JSON.stringify(x.detalhe)) + '</pre></td></tr>').join('') || '<tr><td colspan="4" class="empty">Nada ainda</td></tr>';
      } catch (e) { showAlert(e.message, 'error'); }
    }

    // ---------- registro (todo mundo que já entrou) ----------
    let REG = { players: [], total: 0, mostrando: 0 }, REG_SEL = new Set(), RITEM = null, rgT;
    async function loadRegistro() {
      try {
        const q = ($('rg-busca').value || '').trim();
        REG = await api('GET', '/registro?limit=1000&q=' + encodeURIComponent(q));
        $('rg-info').textContent = 'Mostrando ' + REG.mostrando + ' de ' + REG.total + ' jogador(es) no registro';
        renderRegistro();
        $('dt-itens').innerHTML = cat('itens', []).map(it => '<option value="' + esc(it) + '">').join('');
        $('dt-carros').innerHTML = cat('carros', []).map(c => '<option value="' + esc(c) + '">').join('');
      } catch (e) { showAlert(e.message, 'error'); }
    }
    $('rg-busca').addEventListener('input', () => { clearTimeout(rgT); rgT = setTimeout(loadRegistro, 350); });
    function renderRegistro() {
      const list = REG.players || [];
      if (!list.length) { $('rg-body').innerHTML = '<tr><td colspan="8" class="empty">' + (REG.total ? 'Ninguém bate com a busca' : 'Registro vazio — vai enchendo conforme os jogadores entram') + '</td></tr>'; updateSelBar(); return; }
      $('rg-body').innerHTML = list.map(p => {
        const rid = Number(p.roblox_id);
        const sel = REG_SEL.has(rid);
        const fila = p.fila ? ' · <span class="pill warn">' + p.fila.itens + ' na fila</span>' : '';
        return '<tr>' +
          '<td><input type="checkbox" ' + (sel ? 'checked' : '') + ' onclick="toggleSel(' + rid + ',this)"></td>' +
          '<td><b>' + esc(p.nome || '—') + '</b>' + fila + '</td>' +
          '<td class="muted">' + esc(p.roblox_id) + '</td>' +
          '<td>' + esc(p.visitas || 1) + '</td>' +
