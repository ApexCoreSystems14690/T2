          '<td class="muted" style="font-size:.74rem;white-space:nowrap">' + (p.ultima_vez ? fmtT(p.ultima_vez) : '—') + '</td>' +
          '<td>' + (p.online ? '<span class="pill ok">online</span>' : '<span class="pill">offline</span>') + '</td>' +
          '<td><div class="acts">' +
            '<button onclick="openItem(' + rid + ')">🎒 Dar item</button>' +
            '<button class="d" onclick="apagarUm(' + rid + ')">🗑️ Apagar</button>' +
          '</div></td></tr>';
      }).join('');
      updateSelBar();
