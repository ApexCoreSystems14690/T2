    function closeItem() { $('rmodal').classList.remove('active'); RITEM = null; }
    async function verPatrimonio(rid) {
      const p = (REG.players || []).find(x => Number(x.roblox_id) === Number(rid));
      $('pt-title').textContent = 'Patrimônio — ' + ((p && p.nome) || rid);
      $('pt-sub').textContent = 'Carregando…';
      $('pt-body').innerHTML = '';
      $('pmodal').classList.add('active');
      try {
        const r = await api('GET', '/registro/patrimonio/' + Number(rid));
        if (!r || !r.tem) { $('pt-sub').textContent = 'Sem dados ainda — o jogo grava a foto quando o jogador sai do servidor.'; return; }
        const d = r.patrimonio;
        const money = n => 'R$ ' + Number(n || 0).toLocaleString('pt-BR');
        const carros = (d.carros && typeof d.carros === 'object' && !Array.isArray(d.carros)) ? Object.keys(d.carros) : [];
        const casas = Array.isArray(d.casas) ? d.casas : [];
        const nomeCasa = c => esc(typeof c === 'object' && c ? (c.nome || c.id || JSON.stringify(c)) : String(c));
        $('pt-sub').textContent = 'Atualizado ' + (d.atualizado_em ? fmtT(d.atualizado_em) : '—') + (d.emprego ? ' · ' + d.emprego : '');
        $('pt-body').innerHTML =
          '<div class="pt-grid">' +
            '<div class="pt-box"><div class="pt-k"><svg class="ic" aria-hidden="true"><use href="/icones.svg#dinheiro"/></svg>Bolso</div><div class="pt-v">' + money(d.bolso) + '</div></div>' +
            '<div class="pt-box"><div class="pt-k"><svg class="ic" aria-hidden="true"><use href="/icones.svg#banco"/></svg>Banco</div><div class="pt-v">' + money(d.banco) + '</div></div>' +
            '<div class="pt-box"><div class="pt-k"><svg class="ic" aria-hidden="true"><use href="/icones.svg#dinheiro"/></svg>Total</div><div class="pt-v">' + money(Number(d.bolso||0)+Number(d.banco||0)) + '</div></div>' +
            '<div class="pt-box"><div class="pt-k"><svg class="ic" aria-hidden="true"><use href="/icones.svg#nivel"/></svg>Level</div><div class="pt-v">' + Number(d.level||1) + '</div></div>' +
          '</div>' +
          '<div class="pt-sec"><div class="pt-k"><svg class="ic" aria-hidden="true"><use href="/icones.svg#carro"/></svg>Carros (' + carros.length + ')</div><div class="pt-list">' + (carros.length ? carros.map(esc).join(', ') : '<span class="muted">nenhum</span>') + '</div></div>' +
          '<div class="pt-sec"><div class="pt-k"><svg class="ic" aria-hidden="true"><use href="/icones.svg#casa"/></svg>Casas (' + casas.length + ')</div><div class="pt-list">' + (casas.length ? casas.map(nomeCasa).join(', ') : '<span class="muted">nenhuma</span>') + '</div></div>';
      } catch (e) { $('pt-sub').textContent = ''; $('pt-body').innerHTML = '<div class="muted">' + esc(e.message) + '</div>'; }
    }
    function closePatrimonio() { $('pmodal').classList.remove('active'); }
    async function submitItem() {
      if (!RITEM) return;
      const item = $('ri-item').value.trim(), qtd = Number($('ri-qtd').value) || 1;
      if (!item) return showAlert('Escolha ou digite um item', 'error');
      try {
        const r = await api('POST', '/registro/item', { roblox_id: RITEM.roblox_id, item, qtd });
        showAlert(r.modo === 'online' ? (qtd + 'x ' + item + ' enviado agora') : (qtd + 'x ' + item + ' na fila — entrega quando logar'), 'success');
        closeItem();
        setTimeout(loadRegistro, 1500);
      } catch (e) { showAlert(e.message, 'error'); }
    }
    async function apagarUm(rid) {
      const p = (REG.players || []).find(x => Number(x.roblox_id) === Number(rid));
      if (!confirm('Apagar o registro de ' + ((p && p.nome) || rid) + '?')) return;
      try { const r = await api('POST', '/registro/apagar', { roblox_id: Number(rid) }); showAlert(msgApagar(r), r.online ? 'error' : 'success'); REG_SEL.delete(Number(rid)); loadRegistro(); } catch (e) { showAlert(e.message, 'error'); }
    }
    async function apagarLote() {
      const ids = Array.from(REG_SEL);
      if (!ids.length) return;
      if (!confirm('Apagar ' + ids.length + ' registro(s) selecionado(s)? Não tem volta.')) return;
      try { const r = await api('POST', '/registro/apagar', { roblox_ids: ids }); showAlert(msgApagar(r), r.online ? 'error' : 'success'); REG_SEL.clear(); loadRegistro(); } catch (e) { showAlert(e.message, 'error'); }
    }
    // Quem está DENTRO do servidor agora volta pro registro no próximo heartbeat
    // (alguns segundos). Isso é correto — ele está lá — mas tem que ser dito, senão
    // parece que o apagar não funcionou.
    function msgApagar(r) {
      let m = r.apagados + ' registro(s) apagado(s)';
      if (r.logs) m += ' · ' + r.logs + ' log(s)';
      if (r.online) m += ' — ATENÇÃO: ' + r.online + ' está(ão) online e volta(m) pro registro em segundos. Kicke antes.';
      return m;
    }

    async function wipeGeral() {
      const t = prompt(
        'WIPE GERAL — TEMPORADA NOVA. Não tem volta pelo painel.\n\n' +
        'APAGA: registro de jogadores, fila de itens, logs, comandos, auditoria,\n' +
        'celular (aparelhos, números, contatos, mensagens) e deepweb.\n\n' +
        'ZERA O SAVE DE TODO MUNDO — online, offline, quem sumiu faz meses.\n' +
        'Dinheiro, inventário, casa, carro: todo mundo recomeça do zero.\n\n' +
        'DERRUBA todo mundo que estiver no servidor agora.\n\n' +
        'MANTÉM: corporações, cargos e membros. E os admins do site.\n\n' +
        'Digite WIPE pra confirmar:');
      if (t !== 'WIPE') { if (t !== null) showAlert('Wipe cancelado (precisa digitar WIPE)', 'error'); return; }
      try {
        const r = await api('POST', '/registro/wipe', { confirm: 'WIPE' });
        const partes = [];
        const add = (rot, v) => { if (v != null) partes.push(v + ' ' + rot); };
        add('jogadores', r.jogadores); add('logs', r.logs); add('mensagens', r.mensagens); add('aparelhos', r.aparelhos);
        let m = 'Temporada ' + r.temporada + ' começou. ' + partes.join(', ') + ' apagados';
        if (r.derrubados) m += ' · ' + r.derrubados + ' jogador(es) sendo derrubado(s) em ' + r.servidores + ' servidor(es)';
        showAlert(m, 'success');
        REG_SEL.clear(); loadRegistro();
      } catch (e) { showAlert(e.message, 'error'); }
    }
    async function darItemTodos() {
      const item = ($('dt-item').value || '').trim(); const qtd = Number($('dt-qtd').value) || 1;
      if (!item) return showAlert('Escolha um item', 'error');
      const offline = $('dt-offline').checked;
      if (!confirm('Dar ' + qtd + 'x "' + item + '" pra TODOS' + (offline ? ' (online agora + offline no próximo login)' : ' os jogadores ONLINE agora') + '?')) return;
      try {
        const r = await api('POST', '/registro/dar-todos', { tipo: 'item_add', item, qtd, offline });
        showAlert('Item dado: ' + r.online + ' online' + (r.fila ? (' + ' + r.fila + ' na fila (offline)') : ''), 'success');
      } catch (e) { showAlert(e.message, 'error'); }
    }
    async function darCarroTodos() {
      const carro = ($('dt-carro').value || '').trim();
      if (!carro) return showAlert('Escolha um carro', 'error');
      if (!confirm('Dar o carro "' + carro + '" pra TODOS os jogadores ONLINE agora?\n\n(Carro só vai pros online — offline não tem fila de carro.)')) return;
      try {
        const r = await api('POST', '/registro/dar-todos', { tipo: 'carro_add', carro });
        showAlert('Carro dado a ' + r.online + ' jogador(es) online', 'success');
      } catch (e) { showAlert(e.message, 'error'); }
    }
  </script>
</body>
</html>
