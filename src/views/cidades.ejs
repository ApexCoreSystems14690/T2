<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Cidades — Santa Fé RP</title>
  <meta name="theme-color" content="#0E1116">
  <link rel="stylesheet" href="/sf.css">
  <style>
    /* ==================================================================
       TELA CIDADES (21/10) — a entrada do site.
       Rodovia à noite: a cidade no horizonte, o pórtico com as placas verdes
       de saída (uma por cidade) e a pista andando por baixo. Cada placa é
       uma cidade da rede; hoje só o Santa Fé Oficial.
       ================================================================== */
    :root {
      --noite: #0E1116; --noite-2: #151A21; --horizonte: #232B36;
      --verde-placa: #0F6B3E; --verde-placa-2: #0B5A33;
      --poste: #6E7781; --poste-2: #4A525C;
    }
    html, body { height: 100%; }
    body {
      margin: 0; min-height: 100vh; overflow-x: hidden;
      background: var(--noite) !important; color: #E9EDF1 !important;
    }
    .cena { position: relative; min-height: 100vh; display: flex; flex-direction: column; isolation: isolate; }

    /* ---------- céu e cidade no horizonte ---------- */
    .ceu {
      position: absolute; inset: 0 0 auto 0; height: 66vh; z-index: -3;
      background: linear-gradient(180deg, #0B0E13 0%, #121821 55%, #1E2631 82%, #2A2A2E 100%);
    }
    .ceu::after { /* poluição luminosa da cidade, baixa e quente */
      content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 38%;
      background: radial-gradient(60% 100% at 50% 100%, rgba(242,183,5,.13), rgba(242,183,5,0) 70%);
    }
    .skyline { position: absolute; left: 0; right: 0; top: calc(66vh - 210px); height: 210px; z-index: -2; width: 100%; }
    .skyline .predio { fill: #0A0D12; }
    .skyline .predio.tras { fill: #121720; }
    .skyline .jan { fill: #F2C14E; opacity: 0; animation: janela 9s infinite steps(1); }
    .skyline .jan.fria { fill: #BFD3E6; }
    .skyline .antena { fill: #B23227; animation: piscaAntena 1.6s infinite steps(1); }
    @keyframes janela { 0% { opacity: 0; } 8% { opacity: .85; } 62% { opacity: .85; } 70% { opacity: 0; } }
    @keyframes piscaAntena { 0% { opacity: 1; } 50% { opacity: .15; } }

    /* ---------- a pista ---------- */
    .chao { position: absolute; left: 0; right: 0; top: 66vh; bottom: 0; z-index: -2; background: #16191E; overflow: hidden; }
    .pista {
      position: absolute; left: 50%; top: 0; width: 1400px; height: 100%;
      transform: translateX(-50%) perspective(260px) rotateX(62deg); transform-origin: 50% 0;
      background:
        linear-gradient(90deg, transparent 0 calc(50% - 4px), transparent calc(50% + 4px)),
        #1B1F25;
    }
    .pista::before { /* faixa central amarela, tracejada, andando */
      content: ""; position: absolute; left: calc(50% - 6px); width: 12px; top: -40px; bottom: -40px;
      background: repeating-linear-gradient(180deg, var(--pista) 0 46px, transparent 46px 96px);
      animation: faixa 1.1s linear infinite;
    }
    .pista::after { /* bordas brancas contínuas */
      content: ""; position: absolute; top: 0; bottom: 0; left: 14%; right: 14%;
      border-left: 10px solid #D9DDE2; border-right: 10px solid #D9DDE2; opacity: .55;
    }
    @keyframes faixa { from { background-position: 0 0; } to { background-position: 0 96px; } }
    .farol { /* carro passando ao longe: dois pontos de luz cruzando */
      position: absolute; top: calc(66vh - 9px); left: -60px; width: 34px; height: 5px; z-index: -1;
      background: radial-gradient(circle at 6px 2.5px, #FFF6D8 0 2px, transparent 3px), radial-gradient(circle at 28px 2.5px, #FFF6D8 0 2px, transparent 3px);
      filter: drop-shadow(0 0 6px rgba(255,240,200,.9));
      animation: passa 14s linear infinite; animation-delay: 3s; opacity: 0;
    }
    .farol.volta { top: calc(66vh - 4px); background: radial-gradient(circle at 6px 2.5px, #FF5A4A 0 2px, transparent 3px), radial-gradient(circle at 28px 2.5px, #FF5A4A 0 2px, transparent 3px); filter: drop-shadow(0 0 5px rgba(255,80,60,.8)); animation-name: volta; animation-duration: 19s; animation-delay: 8s; }
    @keyframes passa { 0% { left: -60px; opacity: 0; } 4% { opacity: 1; } 96% { opacity: 1; } 100% { left: calc(100% + 60px); opacity: 0; } }
    @keyframes volta { 0% { left: calc(100% + 60px); opacity: 0; } 4% { opacity: 1; } 96% { opacity: 1; } 100% { left: -60px; opacity: 0; } }

    /* ---------- topo ---------- */
    .topo { display: flex; align-items: center; gap: 1rem; padding: 1.1rem clamp(16px, 4vw, 40px); }
    .topo .placa { box-shadow: 0 1px 0 #000; }
    .topo .rede { color: #9AA4AF; font-size: .8rem; letter-spacing: .02em; }
    .topo .conta { margin-left: auto; display: flex; align-items: center; gap: .8rem; font-size: .88rem; color: #AEB7C1; }
    .topo .conta strong { color: #fff; }
    .topo .conta a { color: #AEB7C1; text-decoration: none; display: inline-flex; align-items: center; gap: .3rem; }
    .topo .conta a:hover { color: var(--pista); }
    .btn-discord { background: #5865F2; color: #fff !important; padding: .5rem .85rem; border-radius: 6px; font-weight: 700; }
    .btn-discord:hover { background: #4752C4; }

    .titulo { padding: 0 clamp(16px, 4vw, 40px); margin-top: clamp(.5rem, 3vh, 2rem); }
    .titulo h1 {
      margin: 0; color: #fff; font-size: clamp(3rem, 11vw, 7.5rem); line-height: .86;
      font-stretch: 62%; font-variation-settings: "wdth" 62; font-weight: 900; letter-spacing: -.005em;
    }
    .titulo p { margin: .7rem 0 0; color: #9AA4AF; max-width: 46ch; font-size: .98rem; }

    /* ---------- o pórtico ---------- */
    .portico { position: relative; margin: clamp(1.4rem, 5vh, 3.2rem) auto 0; width: min(1080px, calc(100% - 32px)); padding-top: 26px; }
    .viga { /* treliça do pórtico */
      position: absolute; left: -10px; right: -10px; top: 0; height: 22px;
      background:
        repeating-linear-gradient(60deg, transparent 0 13px, var(--poste-2) 13px 16px),
        repeating-linear-gradient(-60deg, transparent 0 13px, var(--poste-2) 13px 16px);
      border-top: 4px solid var(--poste); border-bottom: 4px solid var(--poste);
    }
    .lampadas { position: absolute; left: 0; right: 0; top: 22px; height: 0; display: flex; justify-content: space-around; }
    .lampadas i { width: 26px; height: 6px; background: #3A424C; border-radius: 0 0 3px 3px; position: relative; }
    .lampadas i::after { /* cone de luz caindo na placa */
      content: ""; position: absolute; left: -40px; right: -40px; top: 6px; height: 120px;
      background: linear-gradient(180deg, rgba(255,244,214,.18), rgba(255,244,214,0));
      clip-path: polygon(42% 0, 58% 0, 100% 100%, 0 100%);
      pointer-events: none;
    }
    .postes { position: absolute; inset: 0 auto auto 0; width: 100%; height: 0; }
    .postes::before, .postes::after {
      content: ""; position: absolute; top: 0; width: 14px; height: 100vh;
      background: linear-gradient(90deg, var(--poste-2), var(--poste) 45%, var(--poste-2));
    }
    .postes::before { left: -24px; } .postes::after { right: -24px; }

    .placas { position: relative; display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 18px; padding-top: 14px; }
    .placas::before { /* ferragens prendendo as placas na viga */
      content: ""; position: absolute; left: 12%; right: 12%; top: -4px; height: 18px;
      background: repeating-linear-gradient(90deg, transparent 0 22%, #4A525C 22% calc(22% + 6px), transparent calc(22% + 6px) 50%);
    }

    /* uma placa verde de rodovia = uma cidade */
    .placa-saida {
      position: relative; display: block; text-decoration: none !important; color: #fff;
      background: var(--verde-placa); border-radius: 8px; padding: 8px;
      box-shadow: 0 2px 0 #062A18, 0 18px 40px rgba(0,0,0,.55);
      transition: transform .18s ease;
      transform-origin: 50% 0;
      animation: balanca 7s ease-in-out infinite;
    }
    .placa-saida .borda { display: block; border: 3px solid #F4F6F3; border-radius: 5px; padding: 18px 20px 16px; position: relative; overflow: hidden; }
    .placa-saida .borda::after { /* refletivo pegando o farol: varre quando passa o mouse */
      content: ""; position: absolute; top: -20%; bottom: -20%; width: 40%; left: -60%;
      background: linear-gradient(100deg, transparent, rgba(255,255,255,.18), transparent);
      transform: skewX(-12deg); transition: left .7s ease;
    }
    .placa-saida:hover .borda::after, .placa-saida:focus-visible .borda::after { left: 120%; }
    .placa-saida:hover { transform: translateY(2px); }
    @keyframes balanca { 0%, 100% { transform: rotate(0deg); } 50% { transform: rotate(.35deg); } }
    .placa-saida:nth-child(2) { animation-delay: -2.4s; }
    .placa-saida:nth-child(3) { animation-delay: -4.1s; }

    .ps-topo { display: flex; align-items: center; gap: .55rem; margin-bottom: .55rem; }
    .ps-oficial { background: var(--pista); color: #10131A; font-weight: 800; font-size: .72rem; padding: .22rem .45rem; border-radius: 3px; letter-spacing: .02em; }
    .ps-teste { background: #F2C230; }
    .ps-cargo { border: 1.5px solid rgba(255,255,255,.75); font-weight: 700; font-size: .72rem; padding: .16rem .42rem; border-radius: 3px; }
    .ps-seta { margin-left: auto; width: 44px; height: 44px; flex-shrink: 0; }
    .ps-nome {
      display: block; font-size: clamp(2.6rem, 6.5vw, 3.9rem); line-height: .9; font-weight: 800;
      font-stretch: 75%; font-variation-settings: "wdth" 75; letter-spacing: .01em;
    }
    .ps-desc { display: block; margin-top: .55rem; color: #D7EBDD; font-size: .92rem; max-width: 38ch; }
    .ps-base {
      display: flex; align-items: center; gap: .9rem; margin-top: 1rem; padding-top: .75rem;
      border-top: 2px solid rgba(244,246,243,.55); font-size: .9rem; font-weight: 600;
    }
    .ps-base .ponto { width: 9px; height: 9px; border-radius: 50%; background: #7CE0A3; box-shadow: 0 0 0 0 rgba(124,224,163,.6); animation: pulso 2s infinite; display: inline-block; margin-right: .4rem; vertical-align: 1px; }
    .ps-base .ponto.parado { background: #8A949E; animation: none; }
    .ps-base .ponto.cheio { background: var(--pista); animation: none; }
    .ps-vagas { font-variant-numeric: tabular-nums; color: #D7EBDD; }
    .ps-vagas b { color: #fff; font-size: 1.05rem; }
    @keyframes pulso { 0% { box-shadow: 0 0 0 0 rgba(124,224,163,.55); } 70% { box-shadow: 0 0 0 9px rgba(124,224,163,0); } 100% { box-shadow: 0 0 0 0 rgba(124,224,163,0); } }
    .ps-entrar { margin-left: auto; background: #F4F6F3; color: var(--verde-placa-2); font-weight: 800; padding: .4rem .7rem; border-radius: 4px; }
    .placa-saida:hover .ps-entrar { background: var(--pista); color: #10131A; }
    .placa-saida.atual .ps-entrar::after { content: " · você está aqui"; font-weight: 600; }

    /* [22/10] placa auxiliar branca pendurada embaixo da verde: regras da cidade */
    .placa-item { display: flex; flex-direction: column; align-items: center; }
    .placa-item .placa-saida { width: 100%; }
    .placa-item:nth-child(2) .placa-saida { animation-delay: -2.4s; }
    .placa-item:nth-child(3) .placa-saida { animation-delay: -4.1s; }
    .ps-regras {
      position: relative; margin-top: 16px; display: inline-flex; align-items: center; gap: .5rem;
      background: #F4F6F3; color: #10131A !important; text-decoration: none !important;
      border: 3px solid #10131A; outline: 3px solid #F4F6F3; border-radius: 4px;
      padding: .45rem .8rem; font-weight: 800; font-size: .95rem; letter-spacing: .01em;
      font-stretch: 85%; font-variation-settings: "wdth" 85;
      box-shadow: 0 10px 24px rgba(0,0,0,.45);
      transform-origin: 50% -16px; animation: balanca 6s ease-in-out infinite; animation-delay: -1.2s;
      transition: background .15s ease;
    }
    .ps-regras::before, .ps-regras::after { /* as duas hastes que prendem na placa de cima */
      content: ""; position: absolute; top: -19px; width: 3px; height: 16px; background: #4A525C;
    }
    .ps-regras::before { left: 22%; } .ps-regras::after { right: 22%; }
    .ps-regras .ic { width: 1.15em; height: 1.15em; }
    .ps-regras small { font-weight: 600; color: #46505C; font-size: .76rem; padding-left: .5rem; border-left: 2px solid #10131A; }
    .ps-regras:hover, .ps-regras:focus-visible { background: var(--pista); }

    /* vaga vazia no pórtico: a rede vai crescer */
    .vaga {
      background: rgba(14,17,22,.72); backdrop-filter: blur(2px);
      border: 2px dashed rgba(255,255,255,.18); border-radius: 8px; min-height: 92px; align-self: start; margin-top: 30px;
      display: grid; place-items: center; color: #6F7984; font-size: .88rem; text-align: center; padding: 1rem;
    }

    .rodape {
      margin-top: auto; padding: 1rem clamp(16px, 4vw, 40px) 1.1rem; color: #8A949E; font-size: .82rem;
      display: flex; flex-wrap: wrap; gap: .4rem 1.4rem; position: relative; z-index: 3;
      background: linear-gradient(180deg, rgba(14,17,22,0), rgba(14,17,22,.92) 35%);
      padding-top: 3rem;
    }
    .rodape strong { color: #C9D0D8; }

    @media (max-width: 640px) {
      .postes { display: none; }
      .placas { grid-template-columns: 1fr; }
      .vaga { min-height: 56px; margin-top: 0; }
      .topo .rede { display: none; }
      .skyline { top: calc(66vh - 150px); height: 150px; }
    }
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { animation: none !important; transition: none !important; }
      .skyline .jan { opacity: .7; }
    }
  </style>
</head>
<body>
<div class="cena">
  <div class="ceu" aria-hidden="true"></div>
  <%
    // Horizonte gerado aqui mesmo, sempre igual (semente fixa): prédios de
    // altura variada e janelas que acendem e apagam em tempos diferentes.
    var semente = 7; function rnd() { semente = (semente * 9301 + 49297) % 233280; return semente / 233280; }
    var W = 1600, H = 210, x = 0, predios = [], janelas = [], antenas = [];
    while (x < W) {
      var tras = rnd() < .45, w = 34 + Math.floor(rnd() * 70), h = 40 + Math.floor(rnd() * (tras ? 120 : 160));
      predios.push({ x: x, w: w, h: h, tras: tras });
      if (!tras) {
        for (var jy = H - h + 10; jy < H - 12; jy += 13) for (var jx = x + 6; jx < x + w - 8; jx += 11) {
          if (rnd() < .26) janelas.push({ x: jx, y: jy, d: (rnd() * 9).toFixed(2), f: rnd() < .22 });
        }
        if (h > 150 && rnd() < .6) antenas.push({ x: x + Math.floor(w / 2), y: H - h - 14 });
      }
      x += w - (tras ? 18 : 2);
    }
  %>
  <svg class="skyline" viewBox="0 0 <%= W %> <%= H %>" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
    <% predios.filter(function (p) { return p.tras; }).forEach(function (p) { %><rect class="predio tras" x="<%= p.x %>" y="<%= H - p.h - 18 %>" width="<%= p.w %>" height="<%= p.h + 18 %>"/><% }) %>
    <% predios.filter(function (p) { return !p.tras; }).forEach(function (p) { %><rect class="predio" x="<%= p.x %>" y="<%= H - p.h %>" width="<%= p.w %>" height="<%= p.h %>"/><% }) %>
    <% antenas.forEach(function (a) { %><rect class="predio" x="<%= a.x %>" y="<%= a.y %>" width="2" height="14"/><circle class="antena" cx="<%= a.x + 1 %>" cy="<%= a.y %>" r="2.2"/><% }) %>
    <% janelas.forEach(function (j) { %><rect class="jan<%= j.f ? ' fria' : '' %>" x="<%= j.x %>" y="<%= j.y %>" width="5" height="6" style="animation-delay:-<%= j.d %>s"/><% }) %>
  </svg>
  <div class="chao" aria-hidden="true"><div class="pista"></div></div>
  <div class="farol" aria-hidden="true"></div>
  <div class="farol volta" aria-hidden="true"></div>

  <header class="topo">
    <%- include('partials/placa') %>
    <span class="rede">Rede de cidades do Santa Fé RP</span>
    <div class="conta">
      <% if (user) { %>
        <span>Conectado como <strong><%= user.discord_username %></strong></span>
        <a href="/auth/logout"><svg class="ic" aria-hidden="true"><use href="/icones.svg#sair"/></svg>Sair</a>
      <% } else { %>
        <a class="btn-discord" href="/auth/discord"><svg class="ic" aria-hidden="true"><use href="/icones.svg#discord"/></svg>Entrar com Discord</a>
      <% } %>
    </div>
  </header>

  <section class="titulo">
    <h1>Cidades</h1>
    <p>Escolha pra onde você vai. Cada cidade tem as próprias corporações, cargos e saves.</p>
  </section>

  <main class="portico">
    <div class="postes" aria-hidden="true"></div>
    <div class="viga" aria-hidden="true"></div>
    <div class="lampadas" aria-hidden="true"><% cidades.forEach(function () { %><i></i><% }) %><i></i></div>
    <nav class="placas" aria-label="Cidades">
      <% cidades.forEach(function (c) {
           var link = '/cidade/' + c.slug + (voltar ? '?voltar=' + encodeURIComponent(voltar) : '');
      %>
      <div class="placa-item">
      <a class="placa-saida<%= atual === c.id ? ' atual' : '' %>" href="<%= link %>">
        <span class="borda">
          <span class="ps-topo">
            <% if (c.tipo === 'oficial') { %><span class="ps-oficial">Oficial</span><% } %>
            <% if (c.tipo === 'teste') { %><span class="ps-oficial ps-teste">Teste · entra com senha</span><% } %>
            <% if (c.meu_cargo_nome) { %><span class="ps-cargo">Você: <%= c.meu_cargo_nome %></span><% } %>
            <svg class="ps-seta" viewBox="0 0 44 44" aria-hidden="true"><path d="M12 32 L30 14 M17 13 H31 V27" fill="none" stroke="#F4F6F3" stroke-width="4.5" stroke-linecap="square"/></svg>
          </span>
          <span class="ps-nome"><%= c.nome %></span>
          <% if (c.descricao) { %><span class="ps-desc"><%= c.descricao %></span><% } %>
          <span class="ps-base">
            <%# [21/10] 1 cidade = 1 servidor, vagas fixas: mostra a lotação, não "servidores" %>
            <% var lot = c.online >= c.vagas; %>
            <span><span class="ponto<%= c.servidores ? (lot ? ' cheio' : '') : ' parado' %>"></span><%= c.servidores ? (lot ? 'Lotada' : 'Aberta') : 'Fechada agora' %></span>
            <span class="ps-vagas"><b><%= c.online %></b>/<%= c.vagas %></span>
            <span class="ps-entrar">Entrar</span>
          </span>
        </span>
      </a>
      <%# [22/10] placa auxiliar pendurada embaixo: o regulamento DESTA cidade (não precisa entrar nem logar) %>
      <% if (c.regras) { %>
      <a class="ps-regras" href="/cidade/<%= c.slug %>/regras">
        <svg class="ic" aria-hidden="true"><use href="/icones.svg#livro"/></svg>
        <span>Regras da cidade</span>
        <small><%= c.regras %> <%= c.regras === 1 ? 'documento' : 'documentos' %></small>
      </a>
      <% } %>
      </div>
      <% }) %>
      <div class="vaga" aria-hidden="true">Mais cidades em breve</div>
    </nav>
  </main>

  <footer class="rodape">
    <span>O que você é numa cidade <strong>não vale</strong> nas outras: corporação, cargo, staff e save são de cada uma.</span>
    <% if (user && !user.roblox_id) { %><span>Sua conta Roblox ainda não está vinculada. <a href="/dashboard/link-roblox" style="color:var(--pista)">Vincular</a></span><% } %>
  </footer>
</div>
</body>
</html>
