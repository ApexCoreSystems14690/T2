<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= corporation.name %> — Santa Fé</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: var(--sans); background: #E7E9EC; color: #161A1F; min-height: 100vh; }
    .topbar { background: #FFFFFF; border-bottom: 1px solid #D6DADF; padding: 0.75rem 1.5rem; display: flex; align-items: center; gap: 1rem; }
    .topbar a { color: #5B6573; text-decoration: none; font-size: 0.85rem; }
    .topbar a:hover { color: #1D3F94; }
    .topbar h1 { font-size: 1rem; color: #161A1F; flex: 1; }
    .main { max-width: 900px; margin: 0 auto; padding: 2rem 1.25rem; }
    .tabs { display: flex; gap: 0; border-bottom: 1px solid #D6DADF; margin-bottom: 1.5rem; overflow-x: auto; scrollbar-width: none; }
    .tabs .tab { white-space: nowrap; flex: 0 0 auto; }
    .tab { padding: 0.6rem 1.25rem; color: #5B6573; cursor: pointer; font-size: 0.85rem; font-weight: 600; border-bottom: 2px solid transparent; transition: all 0.15s; }
    .tab.active { color: #1D3F94; border-bottom-color: #1D3F94; }
    .tab:hover { color: #161A1F; }
    .panel { display: none; }
    .panel.active { display: block; }

    /* Cargos */
    .rank-list { display: flex; flex-direction: column; gap: 0.5rem; margin-bottom: 1rem; }
    .rank-item { background: #FFFFFF; border: 1px solid #D6DADF; border-radius: 6px; padding: 0.75rem 1rem; display: flex; align-items: center; justify-content: space-between; }
    .rank-info { display: flex; align-items: center; gap: 1rem; }
    .rank-level { background: #D6DADF; color: #5B6573; font-size: 0.7rem; font-weight: 700; padding: 0.2rem 0.5rem; border-radius: 3px; min-width: 2rem; text-align: center; }
    .rank-name { font-weight: 600; font-size: 0.9rem; }
    .rank-salary { color: #1D7A45; font-size: 0.8rem; }
    .rank-actions { display: flex; gap: 0.5rem; }
    .btn-sm { padding: 0.3rem 0.6rem; font-size: 0.75rem; border: 1px solid #D6DADF; background: transparent; color: #5B6573; border-radius: 4px; cursor: pointer; }
    .btn-sm:hover { border-color: #8A94A0; color: #161A1F; }
    .btn-sm.danger { border-color: #B2322733; color: #B23227; }
    .btn-sm.danger:hover { background: #B2322711; }

    /* Membros */
    .member-table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
    .member-table th { text-align: left; color: #5B6573; font-weight: 600; padding: 0.5rem 0.75rem; border-bottom: 1px solid #D6DADF; font-size: 0.75rem;  }
    .member-table td { padding: 0.6rem 0.75rem; border-bottom: 1px solid #D6DADF66; }
    .member-table tr:hover td { background: #FFFFFF; }

    /* Forms */
    .form-row { display: flex; gap: 0.75rem; margin-bottom: 1rem; flex-wrap: wrap; }
    .form-group { display: flex; flex-direction: column; gap: 0.25rem; flex: 1; min-width: 120px; }
    .form-group label { font-size: 0.75rem; color: #5B6573; font-weight: 600; }
    .form-group input, .form-group select { background: #FFFFFF; border: 1px solid #D6DADF; color: #161A1F; padding: 0.5rem 0.75rem; border-radius: 4px; font-size: 0.85rem; }
    .form-group input:focus, .form-group select:focus { outline: none; border-color: #1D3F94; }
    .btn { padding: 0.5rem 1.25rem; background: #1D3F94; color: #E7E9EC; border: none; border-radius: 4px; font-weight: 600; font-size: 0.85rem; cursor: pointer; }
    .btn:hover { opacity: 0.85; }
    .btn.secondary { background: transparent; border: 1px solid #D6DADF; color: #161A1F; }

    .alert { padding: 0.75rem 1rem; border-radius: 6px; font-size: 0.85rem; margin-bottom: 1rem; }
    .alert.success { background: #1D7A4522; color: #1D7A45; border: 1px solid #1D7A4533; }
    .alert.error { background: #B2322722; color: #B23227; border: 1px solid #B2322733; }
    .empty { color: #5B6573; font-size: 0.85rem; padding: 1.5rem; text-align: center; }

    /* Seletor de usuários */
    .picker { position: relative; }
    .picker input { width: 100%; }
    .picker-list { position: absolute; top: 100%; left: 0; right: 0; z-index: 20; max-height: 260px; overflow-y: auto; background: #FFFFFF; border: 1px solid #C1C7CF; border-radius: 6px; margin-top: 4px; display: none; }
    .picker-list.open { display: block; }
    .picker-item { padding: 0.5rem 0.75rem; cursor: pointer; display: flex; align-items: center; gap: 0.6rem; font-size: 0.85rem; border-bottom: 1px solid #D6DADF66; }
    .picker-item:hover, .picker-item.active { background: #D6DADF; }
    .picker-item .avatar { width: 24px; height: 24px; border-radius: 50%; background: #C1C7CF; flex-shrink: 0; object-fit: cover; }
    .picker-item .meta { color: #5B6573; font-size: 0.75rem; }
    .picker-item .tag { margin-left: auto; font-size: 0.65rem; padding: 0.1rem 0.4rem; border-radius: 3px; background: #C1C7CF; color: #5B6573;  }
    .picker-item .tag.ok { background: #1D7A4522; color: #1D7A45; }
    .picker-empty { padding: 0.75rem; color: #5B6573; font-size: 0.8rem; text-align: center; }
    .picked { display: flex; align-items: center; gap: 0.5rem; font-size: 0.8rem; color: #1D7A45; margin-top: 0.3rem; min-height: 1.2rem; }
    .picked button { background: none; border: none; color: #5B6573; cursor: pointer; font-size: 0.8rem; }
    .fallback { margin-top: 0.5rem; font-size: 0.8rem; color: #5B6573; }
    .fallback summary { cursor: pointer; }
    .fallback .form-row { margin-top: 0.5rem; }
    .rank-select { background: #E7E9EC; border: 1px solid #D6DADF; color: #161A1F; padding: 0.3rem 0.5rem; border-radius: 4px; font-size: 0.8rem; }
  </style>
  <link rel="stylesheet" href="/sf.css">
  <script src="/sf.js"></script>

</head>
<body>
  <div class="topbar">
    <%- include('partials/placa') %>
    <% if (corporation.tipo === 'faccao') { %><a href="/faccoes"><svg class="ic" aria-hidden="true"><use href="/icones.svg#voltar"/></svg>Facções</a><% } else { %><a href="/dashboard"><svg class="ic" aria-hidden="true"><use href="/icones.svg#voltar"/></svg>Corporações</a><% } %>
    <% if (corporation.has_icon_file) { %>
      <img src="/api/corps/<%= corporation.id %>/icon" data-nome="<%= corporation.name %>" data-cor="<%= corporation.color || '#1D3F94' %>" onerror="sfSemFoto(this)" style="width:28px;height:28px;border-radius:5px;object-fit:cover">
    <% } else if (corporation.icon_url) { %>
      <img src="<%= fotoUrl(corporation.icon_url) %>" data-nome="<%= corporation.name %>" data-cor="<%= corporation.color || '#1D3F94' %>" onerror="sfSemFoto(this)" style="width:28px;height:28px;border-radius:5px;object-fit:cover">
    <% } %>
    <h1><%= corporation.name %></h1>
    <span style="color:#8A94A0;font-size:0.8rem;margin-left:auto">slug: <%= corporation.slug %></span>
  </div>

  <div class="main">
    <%# [23/09] a view agora esconde pelo PODER, nao pelo isOwner. Quem barra
        continua sendo o back (requireCorpPoder); isto aqui e conforto. %>
    <% var P = (typeof poderes !== 'undefined' && poderes) ? poderes : {gerir_cargos:true, editar_corp:true, gerir_membros:true, gerir_gerentes:isOwner, excluir_corp:isOwner};
       var MEU_NIVEL = (typeof meuNivel !== 'undefined') ? meuNivel : null;
       var MEU_PAPEL = (typeof papel !== 'undefined') ? papel : (isOwner ? 'dono' : 'gerente');
       // [29/09, reposto em 30/09] Diretor Geral (80) e Dono do site. Esta linha
       // ja tinha sido escrita em 29/09 e SUMIU do arquivo no PC do Julio -- o
       // back tinha o ehStaffAlto e a tela continuava trancando tudo.
       var EH_STAFF_ALTO = (typeof ehStaffAlto !== 'undefined') && ehStaffAlto; %>
    <div id="alert-container"></div>

    <div style="margin-bottom:1rem;color:#5B6573;font-size:0.8rem">
      Você entra aqui como <strong style="color:#1D3F94"><%= MEU_PAPEL %></strong><% if (MEU_NIVEL !== null) { %> · seu nível de cargo: <%= MEU_NIVEL %><% } %>
    </div>

    <% var EH_FAC = corporation.tipo === 'faccao'; /* [24/10] Facções Vivas: sem caixa, sem salário, com a aba Facção */ %>
    <div class="tabs">
      <% if (EH_FAC) { %><div class="tab active" data-tab="faccao">Facção</div><% } %>
      <div class="tab<%= EH_FAC ? '' : ' active' %>" data-tab="cargos">Cargos (<%= ranks.length %>)</div>
      <div class="tab" data-tab="membros">Membros (<%= members.length %>)</div>
      <% if (P.ver_caixa && !EH_FAC) { %><div class="tab" data-tab="caixa"><%= corporation.tipo === 'governo' ? 'Tesouro' : 'Caixa' %></div><% } %>
      <% if (P.editar_corp || P.gerir_gerentes) { %><div class="tab" data-tab="config">Configurações</div><% } %>
    </div>

    <!-- CARGOS -->
    <% /* [23/10] de quanto em quanto tempo o salário sai: Governo pelo site a cada 3 dias; o resto no ponto de salário do jogo a cada 40 min */ var PERIODO_SAL = corporation.tipo === 'governo' ? '3 dias' : '40 min'; %>
<%# [10/10] CARREIRAS: o nivel e unico DENTRO da carreira (PC: Delegados, Investigacao,
        Pericia, Agentes...). Corp sem carreira = uma lista so, igual antes. %>
    <% var CARREIRAS = [], porC = {};
       ranks.forEach(function (r) { var c = r.carreira || ''; if (!porC[c]) { porC[c] = []; CARREIRAS.push(c); } porC[c].push(r); });
       var TEM_CARREIRA = CARREIRAS.some(function (c) { return c !== ''; });
       function escH(t) { return String(t == null ? '' : t).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
       // modo 'esconde': some com cargo >= o meu (form de adicionar); modo 'trava': mostra desabilitado
       function opcoesCargo(selId, modo, soId, travado) {
         var h = '';
         CARREIRAS.forEach(function (c) {
           var itens = '';
           porC[c].forEach(function (rank) {
             var acima = soId && MEU_NIVEL !== null && Number(rank.level) >= Number(MEU_NIVEL);
             if (modo === 'esconde' && acima) return;
             var dis = (modo === 'trava' && acima && !travado) ? ' disabled' : '';
             itens += '<option value="' + rank.id + '"' + (selId === rank.id ? ' selected' : '') + dis + '>' + escH(rank.name) + ' (Nv.' + rank.level + ')</option>';
           });
           if (!itens) return;
           h += TEM_CARREIRA ? ('<optgroup label="' + escH(c || 'Sem carreira') + '">' + itens + '</optgroup>') : itens;
         });
         return h;
       } %>
    <% if (EH_FAC) { %>
    <!-- [24/10] FACÇÃO — nível, ações registradas, advertências, boca e contrabandista.
         Regulamento das Facções v3.1. Dados de /api/faccao/:id/painel. -->
    <style>
      .fac-topo { display:flex; gap:1rem; align-items:center; flex-wrap:wrap; padding:1rem 1.1rem; border-radius:6px; background:#161A1F; color:#F4F1E6; border-left:8px solid var(--fac-cor, #7F1D1D); margin-bottom:1rem; }
      .fac-selo { display:inline-flex; flex-direction:column; align-items:center; justify-content:center; min-width:76px; border:2px solid #F4F1E6; border-radius:4px; overflow:hidden; background:#F4F1E6; color:#161A1F; }
      .fac-selo small { display:block; width:100%; text-align:center; background:var(--fac-cor, #7F1D1D); color:#fff; font-size:.62rem; letter-spacing:.12em; font-weight:800; padding:.1rem .4rem; }
      .fac-selo b { font-stretch:75%; font-variation-settings:"wdth" 75; font-size:1.9rem; line-height:1.1; font-weight:800; }
      .fac-selo i { font-style:normal; font-size:.7rem; font-weight:800; letter-spacing:.06em; padding:0 .4rem .2rem; text-transform:uppercase; }
      .fac-topo h2 { margin:0; font-size:1.3rem; } .fac-topo p { margin:.2rem 0 0; color:#C9C4B6; font-size:.82rem; }
      .fac-bloco { background:#fff; border:1px solid #E2E5E9; border-radius:6px; padding:1rem 1.1rem; margin-bottom:1rem; }
      .fac-bloco h3 { margin:0 0 .6rem; font-size:1rem; color:#161A1F; }
      .fac-req { display:grid; grid-template-columns:repeat(auto-fit, minmax(150px,1fr)); gap:.6rem; }
      .fac-req div { border:1px solid #E2E5E9; border-radius:5px; padding:.55rem .7rem; }
      .fac-req b { font-size:1.2rem; font-variant-numeric:tabular-nums; } .fac-req .ok { color:#15803D; } .fac-req .falta { color:#B45309; }
      .fac-req span { display:block; font-size:.75rem; color:#5B6573; }
      .fac-niveis { display:grid; grid-template-columns:repeat(auto-fit, minmax(200px,1fr)); gap:.6rem; margin-top:.8rem; }
      .fac-niveis div { border:1px dashed #C9CDD3; border-radius:5px; padding:.55rem .7rem; font-size:.8rem; color:#46505C; }
      .fac-niveis div.atual { border:2px solid var(--fac-cor, #7F1D1D); }
      .fac-form { display:grid; grid-template-columns:repeat(auto-fit, minmax(160px,1fr)); gap:.5rem; align-items:end; margin-bottom:.8rem; }
      .fac-form label { display:flex; flex-direction:column; gap:.2rem; font-size:.78rem; font-weight:600; color:#46505C; }
      .fac-form input, .fac-form select { padding:.45rem .55rem; border:1px solid #C9CDD3; border-radius:4px; font:inherit; }
      .fac-pill { display:inline-block; font-size:.7rem; font-weight:700; padding:.05rem .45rem; border-radius:4px; background:#EEF0F2; color:#46505C; }
      .fac-pill.ok { background:#DCFCE7; color:#15803D; } .fac-pill.nao { background:#FEE2E2; color:#B91C1C; } .fac-pill.esp { background:#FEF3C7; color:#92400E; }
      .fac-linha { border-top:1px solid #EEF0F2; padding:.55rem 0; font-size:.85rem; } .fac-linha:first-child { border-top:0; }
      .fac-aviso { font-size:.82rem; color:#5B6573; }
    </style>
    <div class="panel active" id="panel-faccao" style="--fac-cor: <%= /^#[0-9a-fA-F]{6}$/.test(corporation.color || '') ? corporation.color : '#7F1D1D' %>">
      <div id="fac-carregando" class="fac-aviso">Carregando…</div>
      <div id="fac-corpo" hidden>
        <div class="fac-topo">
          <span class="fac-selo"><small>NÍVEL</small><b id="fac-n"></b><i id="fac-nn"></i></span>
          <div><h2><%= corporation.name %></h2><p id="fac-sub"></p></div>
        </div>
        <div class="fac-bloco"><h3>Próximo nível</h3><div id="fac-req"></div><div class="fac-niveis" id="fac-niveis"></div></div>
        <div class="fac-bloco"><h3>Ações registradas</h3>
          <p class="fac-aviso" style="margin-top:0">Cada ação com prova conta para subir de nível depois que a organização das facções aprova (Art. 2.3).</p>
          <div class="fac-form">
            <label>Tipo<select id="fa-tipo"><option value="assalto">Assalto</option><option value="sequestro">Sequestro</option><option value="banco">Banco</option><option value="guerra">Guerra</option></select></label>
            <label>Data<input type="date" id="fa-data"></label>
            <label style="grid-column:span 2">Link da prova (print ou vídeo)<input id="fa-prova" placeholder="https://..."></label>
            <div><button class="btn" id="fa-enviar">Registrar ação</button></div>
          </div>
          <div id="fac-acoes"></div>
        </div>
        <div class="fac-bloco"><h3>Advertências</h3><div id="fac-advs"></div></div>
        <div class="fac-bloco"><h3>Boca e contrabandista</h3><div id="fac-boca"></div></div>
        <% if (corporation.owner_id === user.id) { %>
        <div class="fac-bloco"><h3>Passar a liderança</h3>
          <div class="fac-form"><label>Novo líder<select id="fl-alvo"><% members.filter(function (m) { return m.user_id !== user.id; }).forEach(function (m) { %><option value="<%= m.user_id %>"><%= m.roblox_username || m.discord_username %> (<%= m.rank_name || 'sem cargo' %>)</option><% }) %></select></label>
            <div><button class="btn" id="fl-passar">Passar liderança</button></div></div>
          <p class="fac-aviso" style="margin:0">O novo líder fica com o seu cargo e você fica com o dele.</p>
        </div>
        <% } %>
      </div>
    </div>
    <script>
    (function () {
      var ID = <%= Number(corporation.id) %>;
      var $ = function (i) { return document.getElementById(i); };
      function esc(t) { return String(t == null ? '' : t).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
      function dia(t) { return t ? new Date(t).toLocaleDateString('pt-BR') : '—'; }
      async function chamar(met, url, corpo) {
        var r = await fetch(url, { method: met, headers: { 'Content-Type': 'application/json', accept: 'application/json' }, body: corpo ? JSON.stringify(corpo) : undefined });
        var j = await r.json().catch(function () { return {}; });
        if (!r.ok) throw new Error(j.error || 'Erro'); return j;
      }
      var ST = { pendente: ['esp', 'Esperando a organização'], aprovada: ['ok', 'Aprovada'], recusada: ['nao', 'Recusada'] };
      async function carregar() {
        try {
          var d = await chamar('GET', '/api/faccao/' + ID + '/painel');
          var f = d.faccao, rq = d.requisitos;
          $('fac-n').textContent = f.nivel; $('fac-nn').textContent = f.nivel_nome;
          $('fac-sub').textContent = f.membros + ' membro(s) · ' + (f.ultima_atividade ? 'último membro no jogo em ' + dia(f.ultima_atividade) : 'nenhum membro entrou no jogo ainda')
            + (f.advertencias_ativas ? ' · ' + f.advertencias_ativas + ' advertência(s) ativa(s)' : '') + (f.inativa ? ' · 2 semanas sem membro ativo: pode descer de nível (Art. 2.5)' : '');
          $('fac-req').innerHTML = rq.proximo ? ('<p class="fac-aviso" style="margin-top:0">Para o Nível ' + rq.proximo + ' (' + esc(rq.nome) + '):</p><div class="fac-req">'
            + rq.itens.map(function (i) { var ok = i.tem >= i.precisa; return '<div><b class="' + (ok ? 'ok' : 'falta') + '">' + i.tem + ' / ' + i.precisa + '</b><span>' + esc(i.rotulo) + '</span></div>'; }).join('')
            + '</div><p class="fac-aviso">' + (rq.cumpre ? 'Os requisitos batem: a organização das facções confere e sobe o nível.' : 'Quem sobe o nível é a organização das facções, conferindo os registros e as provas.') + '</p>')
            : '<p class="fac-aviso" style="margin:0">A facção está no nível mais alto.</p>';
          $('fac-niveis').innerHTML = [1, 2, 3].map(function (n) { var N = d.niveis[n]; return '<div class="' + (n === f.nivel ? 'atual' : '') + '"><b>Nível ' + n + ' · ' + esc(N.nome) + '</b><br>' + esc(N.libera) + '</div>'; }).join('');
          $('fac-acoes').innerHTML = d.acoes.length ? d.acoes.map(function (a) { var t = ST[a.status] || ['', a.status];
            return '<div class="fac-linha"><span class="fac-pill ' + t[0] + '">' + t[1] + '</span> <b>' + esc(a.tipo) + '</b> em ' + esc(a.data.split('-').reverse().join('/')) + ' · <a href="' + esc(a.prova) + '" target="_blank" rel="noopener noreferrer">prova</a> · por ' + esc(a.enviada_nome || '?')
              + (a.motivo ? '<br><span class="fac-aviso">' + esc(a.decidido_por || '') + ': ' + esc(a.motivo) + '</span>' : '') + '</div>'; }).join('') : '<p class="fac-aviso" style="margin:0">Nenhuma ação registrada.</p>';
          $('fac-advs').innerHTML = d.advertencias.length ? d.advertencias.map(function (a) {
            var rec = a.recurso_status ? '<br><span class="fac-aviso">Recurso: ' + esc({ pendente: 'esperando a staff', aceito: 'aceito: a advertência caiu', negado: 'negado' }[a.recurso_status] || a.recurso_status) + (a.recurso_motivo ? ' (' + esc(a.recurso_motivo) + ')' : '') + '</span>'
              : (a.pode_recorrer ? '<br><button class="btn" data-recorrer="' + a.id + '" style="margin-top:.35rem">Recorrer (até 72 h)</button>' : '');
            return '<div class="fac-linha"><span class="fac-pill ' + (a.ativa ? 'nao' : '') + '">' + (a.ativa ? 'Ativa até ' + dia(a.vence_em) : 'Vencida ou anulada') + '</span> Art. ' + esc(a.artigo) + ' · ' + esc(a.motivo)
              + ' · <a href="' + esc(a.prova) + '" target="_blank" rel="noopener noreferrer">prova</a> · por ' + esc(a.aplicada_nome || '?') + ' em ' + dia(a.aplicada_em) + rec + '</div>'; }).join('')
            : '<p class="fac-aviso" style="margin:0">Nenhuma advertência. Advertência só existe com prova e vence em 30 dias (Art. 9.1 e 9.5).</p>';
          $('fac-advs').querySelectorAll('[data-recorrer]').forEach(function (b) { b.onclick = async function () {
            var t = prompt('Explique o recurso (a staff da cidade decide):'); if (!t) return;
            try { await chamar('POST', '/api/faccao/' + ID + '/advertencias/' + b.dataset.recorrer + '/recurso', { texto: t }); showAlert('Recurso enviado à staff', 'success'); carregar(); } catch (e) { showAlert(e.message, 'error'); } }; });
          $('fac-boca').innerHTML = '<div class="fac-linha"><b>Boca:</b> ' + esc(d.boca.aviso) + '</div>'
            + '<div class="fac-linha"><b>Contrabandista:</b> ' + (d.contrabandista.teto ? 'limite de ' + d.contrabandista.teto + ' armas longas por semana no seu nível. ' : 'libera no Nível 2. ') + esc(d.contrabandista.aviso) + '</div>';
          $('fac-carregando').hidden = true; $('fac-corpo').hidden = false;
        } catch (e) { $('fac-carregando').textContent = e.message; }
      }
      $('fa-data').value = new Date().toISOString().slice(0, 10);
      $('fa-enviar').onclick = async function () {
        try { await chamar('POST', '/api/faccao/' + ID + '/acoes', { tipo: $('fa-tipo').value, data: $('fa-data').value, prova: $('fa-prova').value.trim() });
              $('fa-prova').value = ''; showAlert('Ação registrada: espera a organização das facções', 'success'); carregar(); } catch (e) { showAlert(e.message, 'error'); }
      };
      if ($('fl-passar')) $('fl-passar').onclick = async function () {
        if (!confirm('Passar a liderança? Você deixa de ser o líder.')) return;
        try { await chamar('POST', '/api/faccao/' + ID + '/lideranca', { user_id: Number($('fl-alvo').value) }); showAlert('Liderança passada', 'success'); setTimeout(function () { location.reload(); }, 700); } catch (e) { showAlert(e.message, 'error'); }
      };
      window.addEventListener('DOMContentLoaded', carregar); if (document.readyState !== 'loading') carregar();
    })();
    </script>
    <% } %>
    <div class="panel<%= EH_FAC ? '' : ' active' %>" id="panel-cargos">
      <% if (!P.gerir_cargos) { %>
        <div class="empty" style="margin-bottom:1rem">Só o dono e os co-gerentes mexem em cargo e salário. Aqui você só vê a lista.</div>
      <% } %>
      <% if (P.gerir_cargos) { %>
      <div class="form-row">
        <div class="form-group">
          <label>Nome do Cargo</label>
          <input type="text" id="rank-name" placeholder="Ex: Soldado">
        </div>
        <div class="form-group" style="max-width:170px">
          <label>Carreira <span style="color:#5B6573;font-weight:400">(opcional)</span></label>
          <input type="text" id="rank-carreira" placeholder="Ex: Delegados" list="lista-carreiras">
          <datalist id="lista-carreiras"><% CARREIRAS.forEach(function (c) { if (c) { %><option value="<%= c %>"><% } }) %></datalist>
        </div>
        <div class="form-group" style="max-width:100px">
          <label>Nível</label>
          <input type="number" id="rank-level" placeholder="1" min="0">
        </div>
        <div class="form-group" style="max-width:120px<%= EH_FAC ? ';display:none' : '' %>">
          <label>Salário a cada <%= PERIODO_SAL %> (R$)</label>
          <input type="number" id="rank-salary" placeholder="500" min="0">
        </div>
        <div class="form-group" style="max-width:120px;justify-content:flex-end">
          <button class="btn" onclick="addRank()">Adicionar</button>
        </div>
      </div>
      <% } %>

      <div class="rank-list" id="rank-list">
        <% if (ranks.length === 0) { %>
          <div class="empty">Nenhum cargo criado ainda.</div>
        <% } else { %>
          <% CARREIRAS.forEach(function (carr) { %>
          <% if (TEM_CARREIRA) { %><div style="margin:.6rem 0 .1rem;color:#1D3F94;font-size:.75rem;font-weight:700;">Carreira · <%= carr || 'Sem carreira' %></div><% } %>
          <% porC[carr].forEach(rank => { %>
            <div class="rank-item" data-rank-id="<%= rank.id %>">
              <div class="rank-info">
                <span class="rank-level">Nv.<%= rank.level %></span>
                <span class="rank-name"><%= rank.name %></span>
                <% if (!EH_FAC) { %><span class="rank-salary">R$ <%= Number(rank.salary || 0).toLocaleString('pt-BR') %> <span style="color:#5B6573">a cada <%= PERIODO_SAL %></span></span><% } %>
                <% var gmOn = rank.permissions && rank.permissions.gerir_membros === true; %>
                <% if (gmOn) { %><span style="color:#1D3F94;font-size:0.75rem" title="Pode adicionar, remover e trocar o cargo de quem está ABAIXO deste cargo"><svg class="ic" aria-hidden="true"><use href="/icones.svg#check"/></svg>gere membros abaixo</span><% } %>
              </div>
              <div class="rank-actions">
                <%# [06/10] liga/desliga "gere membros abaixo" no cargo (ranks.permissions.gerir_membros) %>
                <% if (P.gerir_cargos) { %><button class="btn-sm" onclick="toggleGerir(<%= rank.id %>, <%= gmOn ? 'null' : 'true' %>)"><%= gmOn ? 'Tirar gestão de membros' : 'Dar gestão de membros' %></button><% } %>
                <% if (P.gerir_cargos) { %><button class="btn-sm" onclick='editRank(<%= rank.id %>, <%- JSON.stringify({ name: rank.name, level: rank.level, salary: rank.salary, carreira: rank.carreira || "" }).replace(/</g, "\\u003c").replace(/'/g, "\\u0027") %>)'>Editar</button><% } %>
                <% if (P.gerir_cargos) { %><button class="btn-sm danger" onclick="deleteRank(<%= rank.id %>)">Remover</button><% } %>
              </div>
            </div>
          <% }) %>
          <% }) %>
        <% } %>
      </div>
    </div>

    <!-- MEMBROS -->
    <div class="panel" id="panel-membros">
      <div class="form-row">
        <%# [06/10] chefe/cargo-gestor não lê a base de usuários (users/list é só dono/co-gerente/staff): pra ele, adiciona por Roblox ID %>
        <% var SO_ID = ((MEU_PAPEL === 'chefe' || MEU_PAPEL === 'gestor') && !EH_STAFF_ALTO); %>
        <div class="form-group" style="flex:2<%= SO_ID ? ';display:none' : '' %>">
          <label>Usuário registrado na plataforma</label>
          <div class="picker" id="member-picker">
            <input type="text" id="member-search" placeholder="Digite pra buscar por Discord, Roblox ou ID…" autocomplete="off">
            <div class="picker-list" id="member-list"></div>
          </div>
          <div class="picked" id="member-picked"></div>
        </div>
        <div class="form-group">
          <label>Cargo</label>
          <select id="member-rank">
            <option value="">Sem cargo</option>
            <%- opcoesCargo(null, 'esconde', SO_ID, false) %>
          </select>
        </div>
        <div class="form-group" style="max-width:120px;justify-content:flex-end<%= SO_ID ? ';display:none' : '' %>">
          <button class="btn" onclick="addMember()">Adicionar</button>
        </div>
      </div>
      <details class="fallback" <%= SO_ID ? 'open' : '' %>>
        <summary>O jogador ainda não entrou no site? Adicionar pelo Roblox ID</summary>
        <div class="form-row">
          <div class="form-group">
            <label>Roblox User ID</label>
            <input type="number" id="member-roblox-id" placeholder="Ex: 123456789">
          </div>
          <div class="form-group" style="max-width:160px;justify-content:flex-end">
            <button class="btn secondary" onclick="addMemberById()">Adicionar por ID</button>
          </div>
        </div>
        <div style="font-size:0.75rem">O nome é buscado no Roblox automaticamente. Quando ele logar com Discord e vincular o Roblox, o registro é unificado.</div>
      </details>

      <div style="overflow-x:auto">
        <table class="member-table">
          <thead>
            <tr>
              <th>Roblox ID</th>
              <th>Username</th>
              <th>Discord</th>
              <th>Cargo</th>
              <th>Desde</th>
              <th></th>
            </tr>
          </thead>
          <tbody id="member-tbody">
            <% if (members.length === 0) { %>
              <tr><td colspan="6" class="empty">Nenhum membro ainda.</td></tr>
            <% } else { %>
              <% members.forEach(m => { %>
                <%# [30/09 Julio] "N consigo demitir esse gb de nada, ele ta como dono".
                    `eh_dono_da_corp` e so quem CRIOU a corp no painel -- nao tem nada
                    a ver com admin. Diretor+ do site agora passa por cima de tudo aqui
                    (o back concorda: corp-poderes.podeMexerEmMembro). %>
                <% var travado = !P.gerir_membros || (!EH_STAFF_ALTO && (
                     m.eh_dono_da_corp || m.sou_eu
                     || (MEU_NIVEL !== null && m.rank_level !== null && m.rank_level !== undefined && Number(m.rank_level) >= Number(MEU_NIVEL)))); %>
                <tr>
                  <td><%= m.roblox_id || '-' %></td>
                  <td><%= m.roblox_username || '-' %></td>
                  <td><%= (m.discord_username && !String(m.discord_username).startsWith('roblox_')) ? m.discord_username : '—' %></td>
                  <td>
                    <select class="rank-select" <%= travado ? 'disabled' : '' %> onchange="changeRank(<%= m.id %>, this.value, this)">
                      <option value="" <%= !m.rank_id ? 'selected' : '' %>>Sem cargo</option>
                      <%- opcoesCargo(m.rank_id, 'trava', SO_ID, travado) %>
                    </select>
                  </td>
                  <td><%= new Date(m.joined_at).toLocaleDateString('pt-BR') %></td>
                  <td>
                    <% if (m.eh_dono_da_corp) { %><span style="color:#A86400;font-size:0.75rem;margin-right:.4rem" title="Criou esta corporação no painel. Não tem relação com admin do site.">dono</span><% } %>
                    <% if (m.sou_eu && !m.eh_dono_da_corp) { %><span style="color:#5B6573;font-size:0.75rem;margin-right:.4rem">você</span><% } %>
                    <% if (!travado) { %><button class="btn-sm danger" onclick="deleteMember(<%= m.id %>)">Remover</button><% } %>
                    <%# Passar a posse. So quem poderia apagar a corp inteira mexe nisto. %>
                    <% if (P.excluir_corp && !m.eh_dono_da_corp) { %>
                      <button class="btn-sm" onclick="tornarDono(<%= m.id %>, <%= m.user_id %>, '<%= String(m.roblox_username || m.discord_username || 'essa pessoa').replace(/'/g, "\\'") %>')">Tornar dono</button>
                    <% } %>
                    <% if (P.excluir_corp && m.eh_dono_da_corp) { %>
                      <button class="btn-sm danger" onclick="tirarDono()" title="Deixa a corporação sem dono; só staff gerencia até alguém assumir">Tirar posse</button>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- CAIXA [28/09] — dinheiro, estoque e extrato da corporação.
         O chefe VÊ (precisa saber o que a equipe tem); quem compra e paga bônus
         é dono/co-gerente, mesmo critério do salário. Aqui a view só esconde
         botão: quem barra de verdade é o requireCorpPoder nas rotas. -->
    <% if (P.ver_caixa && corporation.tipo === 'governo') { %>
    <!-- [23/10] TESOURO DO GOVERNO — não é caixa de corp: sem vestiário, aporte, bônus nem repasse.
         Entra pelas compras do jogo (x multiplicador), sai só por obra (Dono) e salário (a cada 3 dias). -->
    <div class="panel" id="panel-caixa">
      <div style="display:flex;gap:2rem;align-items:baseline;margin-bottom:1rem;flex-wrap:wrap">
        <div>
          <div style="color:#5B6573;font-size:0.75rem;">Tesouro do Governo</div>
          <div id="tg-saldo" style="color:#1D3F94;font-size:2rem;font-weight:700;font-variant-numeric:tabular-nums">—</div>
        </div>
        <div><div style="color:#5B6573;font-size:0.75rem;">Arrecadou 24h</div><div id="tg-24h" style="color:#15803D;font-weight:700">—</div></div>
        <div><div style="color:#5B6573;font-size:0.75rem;">Arrecadou 7 dias</div><div id="tg-7d" style="color:#15803D;font-weight:700">—</div></div>
        <div><div style="color:#5B6573;font-size:0.75rem;">Multiplicador</div><div id="tg-mult" style="font-weight:700">—</div></div>
      </div>
      <div style="background:#DCE6EE;border-left:4px solid #1D3F94;padding:0.75rem 1rem;border-radius:4px;font-size:0.85rem;margin-bottom:1rem" id="tg-folha">—</div>
      <p style="font-size:0.8rem;color:#5B6573;margin:0 0 1rem">Entra: toda compra honesta feita na cidade (loja, carro, casa, roupa, comida, gasolina, documento…), multiplicada. Sai: só obras retiradas pelo Dono e o salário do Governo. Sem vestiário, aporte, bônus ou repasse.</p>
      <a href="/governo" class="btn" style="display:inline-block;background:#1D3F94;color:#fff;padding:0.6rem 1.2rem;border-radius:6px;text-decoration:none;font-weight:600;margin-bottom:1.25rem">Abrir o Tesouro completo (obras, gráfico, salários)</a>

      <h3 style="color:#161A1F;font-size:0.9rem;margin:0.5rem 0">Obras (valores fixos)</h3>
      <table class="member-table">
        <thead><tr><th>Obra</th><th style="text-align:right">Custo</th></tr></thead>
        <tbody id="tg-obras"><tr><td colspan="2" class="empty">Carregando…</td></tr></tbody>
      </table>
      <h3 style="color:#161A1F;font-size:0.9rem;margin:1.5rem 0 0.5rem">Extrato do Tesouro</h3>
      <table class="member-table">
        <thead><tr><th>Quando</th><th>O quê</th><th>Quem</th><th style="text-align:right">Valor</th><th style="text-align:right">Saldo</th></tr></thead>
        <tbody id="tg-extrato"><tr><td colspan="5" class="empty">Carregando…</td></tr></tbody>
      </table>
    </div>
    <% } else if (P.ver_caixa && !EH_FAC) { %>
    <div class="panel" id="panel-caixa">
      <div style="display:flex;gap:2rem;align-items:baseline;margin-bottom:1.25rem;flex-wrap:wrap">
        <div>
          <div style="color:#5B6573;font-size:0.75rem;">Caixa da corporação</div>
          <div id="cx-saldo" style="color:#1D3F94;font-size:2rem;font-weight:700;font-variant-numeric:tabular-nums">—</div>
        </div>
        <div>
          <div style="color:#5B6573;font-size:0.75rem;">Entrou</div>
          <div id="cx-entrou" style="color:#1D7A45;font-size:1.1rem;font-weight:600;font-variant-numeric:tabular-nums">—</div>
        </div>
        <div>
          <div style="color:#5B6573;font-size:0.75rem;">Saiu</div>
          <div id="cx-saiu" style="color:#B23227;font-size:1.1rem;font-weight:600;font-variant-numeric:tabular-nums">—</div>
        </div>
        <div>
          <div style="color:#5B6573;font-size:0.75rem;">Equipamento perdido</div>
          <div id="cx-perdas" style="color:#A86400;font-size:1.1rem;font-weight:600;font-variant-numeric:tabular-nums">—</div>
        </div>
      </div>

      <!-- [28/09] REPASSE DO GOVERNO. Toda corp recebe a cada 7 dias: base fixa +
           parte por atividade. É a ÚNICA entrada da SAMU -- ela não multa, não
           apreende e não cobra dívida. O bloco some sozinho se a rota não mandar
           o resumo (banco velho, erro na leitura): painel sem bloco é melhor que
           painel quebrado. -->
      <div id="cx-folha" style="display:none;margin-bottom:1.25rem;padding:0.75rem 1rem;border-left:3px solid #1D7A45;background:rgba(29,122,69,0.06);border-radius:4px;color:#46505C;font-size:0.85rem;line-height:1.6"></div>
      <div id="cx-orcamento" style="display:none;margin-bottom:1.25rem;padding:0.75rem 1rem;border-left:3px solid #1D3F94;background:rgba(0,212,255,0.06);border-radius:4px;color:#46505C;font-size:0.85rem;line-height:1.6"></div>

      <% if (P.gerir_estoque) { %>
      <div class="form-row">
        <div class="form-group">
          <label>Comprar pro vestiário</label>
          <select id="cx-item"><option value="">Carregando preços…</option></select>
          <div style="margin-top:0.35rem;color:#5B6573;font-size:0.78rem;line-height:1.5">
            Só arma e algema gastam caixa. Colete, capacete, uniforme e acessório
            são infinitos no vestiário — não acabam, não se perdem e não aparecem aqui.
          </div>
        </div>
        <div class="form-group" style="max-width:120px">
          <label>Quantidade</label>
          <input type="number" id="cx-qtd" value="1" min="1" max="99">
        </div>
        <div class="form-group" style="max-width:160px">
          <label>&nbsp;</label>
          <button class="btn" onclick="comprarItem()">Comprar</button>
        </div>
      </div>
      <% } %>

      <% if (P.aportar_caixa) { %>
      <!-- [29/09] SÓ STAFF. Aporte é dinheiro do nada; a corp normal vive do
           repasse do governo + multa/pátio/dívida. -->
      <div class="form-row">
        <div class="form-group" style="max-width:200px">
          <label>Aporte no caixa <span style="color:#5B6573;font-weight:400">(staff)</span></label>
          <input type="number" id="cx-aporte" placeholder="R$" min="1">
        </div>
        <div class="form-group" style="max-width:160px">
          <label>&nbsp;</label>
          <button class="btn secondary" onclick="aportar()">Depositar</button>
        </div>
      </div>
      <% } %>

      <% if (P.gastar_caixa) { %>

      <%
        // Bonus so pode cair pra quem tem Roblox vinculado: a fila de entrega do
        // jogo e chaveada por roblox_id. Membro sem vinculo nem aparece na lista,
        // senao o comandante debita o caixa e o dinheiro nao chega em ninguem.
        var comRoblox = members.filter(function (m) { return m.roblox_id; });
      %>
      <div class="form-row">
        <div class="form-group">
          <label>Pagar b&ocirc;nus</label>
          <select id="cx-bonus-quem">
            <% if (comRoblox.length === 0) { %>
              <option value="">Nenhum membro com Roblox vinculado</option>
            <% } else { %>
              <% comRoblox.forEach(function (m) { %>
                <option value="<%= m.roblox_id %>" data-nome="<%= m.roblox_username || ('ID ' + m.roblox_id) %>"><%= m.roblox_username || ('ID ' + m.roblox_id) %></option>
              <% }) %>
            <% } %>
          </select>
        </div>
        <div class="form-group" style="max-width:160px">
          <label>Valor</label>
          <input type="number" id="cx-bonus-valor" placeholder="R$" min="1">
        </div>
        <div class="form-group" style="max-width:160px">
          <label>&nbsp;</label>
          <button class="btn" onclick="pagarBonus()">Pagar</button>
        </div>
      </div>
      <div style="color:#5B6573;font-size:0.75rem;margin:-0.5rem 0 1rem">
        Sai do caixa na hora. Cai na conta do jogador quando ele estiver num servidor.
      </div>
      <% } %>

      <h3 style="color:#161A1F;font-size:0.9rem;margin:1.5rem 0 0.5rem">Estoque do vestiário</h3>
      <table class="member-table">
        <thead><tr><th>Item</th><th>Na prateleira</th><th>Na rua</th><th>Perdidos</th><% if (P.gerir_estoque) { %><th></th><% } %></tr></thead>
        <tbody id="cx-estoque"><tr><td colspan="5" class="empty">Carregando…</td></tr></tbody>
      </table>
      <% if (P.gerir_estoque) { %>
      <!-- [15/10] baixa dada por engano volta aqui (até 48h, 1 vez cada) -->
      <h3 style="color:#161A1F;font-size:0.9rem;margin:1.5rem 0 0.5rem">Baixas recentes</h3>
      <div style="color:#5B6573;font-size:0.75rem;margin:-0.2rem 0 0.5rem">Deu baixa por engano? Desfaça em até 48h: a peça volta pro armário e sai de Perdidos.</div>
      <table class="member-table">
        <thead><tr><th>Quando</th><th>Item</th><th>Quem deu</th><th></th></tr></thead>
        <tbody id="cx-baixas"><tr><td colspan="4" class="empty">Carregando…</td></tr></tbody>
      </table>
      <% } %>

      <!-- [18/10] SAMU: doações de sangue (só aparece quando a corp tem banco de sangue) -->
      <div id="cx-doacoes-bloco" style="display:none">
        <h3 style="color:#161A1F;font-size:0.9rem;margin:1.5rem 0 0.5rem">Doações de sangue recentes</h3>
        <div style="color:#5B6573;font-size:0.75rem;margin:-0.2rem 0 0.5rem">Cada doação na cadeira do hospital põe 1 bolsa na geladeira (até <span id="cx-doacoes-teto">8</span>). As bolsas saem quando a equipe usa na rua ou na mesa.</div>
        <table class="member-table">
          <thead><tr><th>Quando</th><th>Doador</th></tr></thead>
          <tbody id="cx-doacoes"><tr><td colspan="2" class="empty">Carregando…</td></tr></tbody>
        </table>
      </div>

      <h3 style="color:#161A1F;font-size:0.9rem;margin:1.5rem 0 0.5rem">Com quem está agora</h3>
      <table class="member-table">
        <thead><tr><th>Policial</th><th>Item</th><th>Desde</th></tr></thead>
        <tbody id="cx-emprestimos"><tr><td colspan="3" class="empty">Carregando…</td></tr></tbody>
      </table>

      <!-- [29/09] PERDAS: só o NÚMERO, sem nome. O comandante vê quantas peças
           sumiram na rua em cada dia e cobra a equipe; quem desviou ele tem que
           descobrir. Baixa dada pelo próprio comando não entra aqui. -->
      <h3 style="color:#161A1F;font-size:0.9rem;margin:1.5rem 0 0.5rem">Equipamento perdido por dia</h3>
      <table class="member-table">
        <thead><tr><th>Dia</th><th>Item</th><th style="text-align:right">Perdidas</th></tr></thead>
        <tbody id="cx-perdas-dia"><tr><td colspan="3" class="empty">Carregando…</td></tr></tbody>
      </table>

      <h3 style="color:#161A1F;font-size:0.9rem;margin:1.5rem 0 0.5rem">Extrato do caixa</h3>
      <table class="member-table">
        <thead><tr><th>Quando</th><th>O quê</th><th>Quem</th><th>Autorizou</th><th style="text-align:right">Valor</th><th style="text-align:right">Saldo</th></tr></thead>
        <tbody id="cx-extrato"><tr><td colspan="6" class="empty">Carregando…</td></tr></tbody>
      </table>
    </div>
    <% } %>

    <!-- CONFIGURAÇÕES -->
    <div class="panel" id="panel-config">
      <% if (P.editar_corp) { %>
      <div class="form-row">
        <div class="form-group">
          <label>Nome</label>
          <input type="text" id="cfg-name" value="<%= corporation.name %>">
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label>Descrição</label>
          <input type="text" id="cfg-desc" value="<%= corporation.description || '' %>">
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label>Imagem / Logo (arquivo)</label>
          <input type="file" id="cfg-icon-file" accept="image/png,image/jpeg,image/gif,image/webp">
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label>Ou cole uma URL</label>
          <input type="text" id="cfg-icon" value="<%= corporation.icon_url || '' %>" placeholder="https://i.imgur.com/exemplo.png">
        </div>
      </div>
      <% if (corporation.has_icon_file) { %>
        <div style="margin-bottom:1rem;display:flex;align-items:center;gap:0.75rem">
          <img src="/api/corps/<%= corporation.id %>/icon" data-nome="<%= corporation.name %>" data-cor="<%= corporation.color || '#1D3F94' %>" onerror="sfSemFoto(this)" style="width:64px;height:64px;border-radius:8px;object-fit:cover;border:1px solid #D6DADF">
          <button class="btn-sm danger" onclick="removeIcon()">Remover imagem</button>
        </div>
      <% } else if (corporation.icon_url) { %>
        <div style="margin-bottom:1rem">
          <img src="<%= fotoUrl(corporation.icon_url) %>" data-nome="<%= corporation.name %>" data-cor="<%= corporation.color || '#1D3F94' %>" onerror="sfSemFoto(this)" style="width:64px;height:64px;border-radius:8px;object-fit:cover;border:1px solid #D6DADF">
        </div>
      <% } %>
      <div class="form-row">
        <div class="form-group" style="max-width:160px">
          <label>Cor</label>
          <input type="color" id="cfg-color" value="<%= corporation.color || '#2F5BBF' %>" style="height:36px;padding:2px">
        </div>
        <div class="form-group" style="max-width:160px">
          <label>Máx. Membros</label>
          <input type="number" id="cfg-max" value="<%= corporation.max_members || 100 %>" min="1">
        </div>
      </div>
      <button class="btn" onclick="saveConfig()">Salvar</button>
      <% } %>

      <% if (P.gerir_gerentes) { %>
      <div style="margin-top:2rem;padding-top:1.5rem;border-top:1px solid #D6DADF">
        <h3 style="font-size:0.9rem;margin-bottom:1rem;color:#1D3F94">Co-Gerentes</h3>
        <div class="form-row">
          <div class="form-group" style="flex:2">
            <label>Usuário registrado</label>
            <div class="picker" id="mgr-picker">
              <input type="text" id="mgr-search" placeholder="Digite pra buscar…" autocomplete="off">
              <div class="picker-list" id="mgr-list"></div>
            </div>
            <div class="picked" id="mgr-picked"></div>
          </div>
          <div class="form-group" style="max-width:140px;justify-content:flex-end">
            <button class="btn" onclick="addManager()">Adicionar</button>
          </div>
        </div>
        <div id="managers-list" style="display:flex;flex-direction:column;gap:0.5rem"></div>
      </div>
      <% } %>
    </div>

  </div>

  <script>
    const CORP_ID = '<%= corporation.id %>';

    // Tabs
    document.querySelectorAll('.tab').forEach(tab => {
      tab.addEventListener('click', () => {
        document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
        document.querySelectorAll('.panel').forEach(p => p.classList.remove('active'));
        tab.classList.add('active');
        document.getElementById('panel-' + tab.dataset.tab).classList.add('active');
      });
    });

    function showAlert(msg, type) {
      const c = document.getElementById('alert-container');
      c.innerHTML = '<div class="alert ' + type + '">' + msg + '</div>';
      setTimeout(() => c.innerHTML = '', 3000);
    }

    async function api(method, path, body) {
      const opts = { method, headers: { 'Content-Type': 'application/json' } };
      if (body) opts.body = JSON.stringify(body);
      const res = await fetch('/api/corps/' + CORP_ID + path, opts);
      return res.json();
    }

    async function addRank() {
      const name = document.getElementById('rank-name').value.trim();
      const level = document.getElementById('rank-level').value;
      const salary = document.getElementById('rank-salary').value;
      const carreira = (document.getElementById('rank-carreira') || {}).value || '';
      if (!name || level === '') return showAlert('Preencha nome e nível', 'error');
      const data = await api('POST', '/ranks', { name, level, salary: salary || 0, carreira: carreira.trim() });
      if (data.error) return showAlert(data.error, 'error');
      showAlert('Cargo criado!', 'success');
      setTimeout(() => location.reload(), 500);
    }

    async function toggleGerir(rankId, valor) {
      const data = await api('PUT', '/ranks/' + rankId, { gerir_membros: valor });
      if (data && data.error) return showAlert(data.error, 'error');
      showAlert(valor ? 'Esse cargo agora gere os membros abaixo dele' : 'Gestão de membros retirada', 'success');
      setTimeout(() => location.reload(), 500);
    }

    // [10/10] editar nome / carreira / nível / salário de um cargo existente
    async function editRank(rankId, atual) {
      const name = prompt('Nome do cargo:', atual.name); if (name === null) return;
      const carreira = prompt('Carreira (vazio = sem carreira):', atual.carreira || ''); if (carreira === null) return;
      const level = prompt('Nível (pode repetir em carreiras diferentes):', atual.level); if (level === null) return;
      const salary = <%= EH_FAC ? 'true' : 'false' %> ? 0 : prompt('Salário a cada <%= PERIODO_SAL %> (R$):', atual.salary); if (salary === null) return;
      const data = await api('PUT', '/ranks/' + rankId, { name: name.trim(), carreira: carreira.trim(), level, salary });
      if (data && data.error) return showAlert(data.error, 'error');
      showAlert('Cargo atualizado', 'success');
      setTimeout(() => location.reload(), 500);
    }

    async function deleteRank(rankId) {
      if (!confirm('Remover este cargo?')) return;
      await api('DELETE', '/ranks/' + rankId);
      location.reload();
    }

    // ---------- Seletor de usuários registrados ----------
    let ALL_USERS = null;
    async function loadUsers() {
      if (ALL_USERS) return ALL_USERS;
      const res = await fetch('/api/corps/users/list');
      const data = await res.json();
      ALL_USERS = data.users || [];
      return ALL_USERS;
    }

    function userLabel(u) {
      const disc = (u.discord_username && !u.is_placeholder) ? u.discord_username : null;
      const rbx = u.roblox_username || (u.roblox_id ? ('ID ' + u.roblox_id) : null);
      return (disc || rbx || ('Usuário #' + u.id));
    }

    function avatarUrl(u) {
      if (u.discord_avatar && u.discord_id && !u.is_placeholder) {
        return 'https://cdn.discordapp.com/avatars/' + u.discord_id + '/' + u.discord_avatar + '.png?size=32';
      }
      return null;
    }

    function makePicker(prefix) {
      const input = document.getElementById(prefix + '-search');
      const list = document.getElementById(prefix + '-list');
      const picked = document.getElementById(prefix + '-picked');
      const state = { selected: null };

      function render(filter) {
        const q = (filter || '').toLowerCase().trim();
        const users = (ALL_USERS || []).filter(u => {
          if (!q) return true;
          return [u.discord_username, u.roblox_username, u.roblox_id, u.id].some(v => v != null && String(v).toLowerCase().includes(q));
        }).slice(0, 60);
        if (users.length === 0) {
          list.innerHTML = '<div class="picker-empty">Nenhum usuário encontrado</div>';
        } else {
          list.innerHTML = users.map(u => {
            const av = avatarUrl(u);
            const disc = (u.discord_username && !u.is_placeholder) ? u.discord_username : null;
            const rbx = u.roblox_username ? (u.roblox_username + (u.roblox_id ? ' · ' + u.roblox_id : '')) : (u.roblox_id ? 'ID ' + u.roblox_id : 'sem Roblox');
            return '<div class="picker-item" data-id="' + u.id + '">' +
              (av ? '<img class="avatar" src="' + av + '">' : '<div class="avatar"></div>') +
              '<div><div>' + (disc || rbx) + '</div>' + (disc ? '<div class="meta">' + rbx + '</div>' : '') + '</div>' +
              (u.is_placeholder ? '<span class="tag">sem discord</span>' : (u.roblox_id ? '<span class="tag ok">vinculado</span>' : '<span class="tag">sem roblox</span>')) +
            '</div>';
          }).join('');
        }
        list.classList.add('open');
      }

      input.addEventListener('focus', async () => { await loadUsers(); render(input.value); });
      input.addEventListener('input', async () => { await loadUsers(); state.selected = null; picked.innerHTML = ''; render(input.value); });
      list.addEventListener('mousedown', e => {
        const item = e.target.closest('.picker-item');
        if (!item) return;
        const u = ALL_USERS.find(x => String(x.id) === item.dataset.id);
        state.selected = u;
        input.value = userLabel(u);
        picked.innerHTML = '<svg class="ic" aria-hidden="true"><use href="/icones.svg#check"/></svg>Selecionado: <strong>' + userLabel(u) + '</strong>' + (u.roblox_id ? ' (Roblox ' + u.roblox_id + ')' : ' — <span style="color:#A86400">sem Roblox vinculado, não vai funcionar no jogo ainda</span>') +
          ' <button onclick="pickers.' + prefix + '.clear()"><svg class="ic" aria-hidden="true"><use href="/icones.svg#x"/></svg></button>';
        list.classList.remove('open');
      });
      document.addEventListener('click', e => { if (!e.target.closest('#' + prefix + '-picker')) list.classList.remove('open'); });
      return {
        get: () => state.selected,
        clear: () => { state.selected = null; input.value = ''; picked.innerHTML = ''; }
      };
    }
    const pickers = { member: makePicker('member') };
    if (document.getElementById('mgr-search')) pickers.mgr = makePicker('mgr');

    async function addMember() {
      const u = pickers.member.get();
      const rank_id = document.getElementById('member-rank').value || null;
      if (!u) return showAlert('Selecione um usuário da lista (ou use "Adicionar pelo Roblox ID")', 'error');
      const data = await api('POST', '/members', { user_id: u.id, rank_id });
      if (data.error) return showAlert(data.error, 'error');
      showAlert('Membro adicionado!', 'success');
      setTimeout(() => location.reload(), 500);
    }

    async function addMemberById() {
      const roblox_id = document.getElementById('member-roblox-id').value;
      const rank_id = document.getElementById('member-rank').value || null;
      if (!roblox_id) return showAlert('Informe o Roblox ID', 'error');
      const data = await api('POST', '/members', { roblox_id, rank_id });
      if (data.error) return showAlert(data.error, 'error');
      showAlert('Membro adicionado!', 'success');
      setTimeout(() => location.reload(), 500);
    }

    async function changeRank(memberId, rankId, el) {
      const data = await api('PUT', '/members/' + memberId, { rank_id: rankId || null });
      if (data.error) { showAlert(data.error, 'error'); setTimeout(() => location.reload(), 800); return; }
      showAlert('Cargo atualizado!', 'success');
    }

    // [30/09] TRANSFERIR A POSSE. `owner_id` é quem criou a corp -- até hoje não
    // existia nenhum jeito de mudar isso fora do SQL.
    async function tornarDono(memberId, userId, nome) {
      if (!confirm('Passar a posse da corporação para ' + nome + '?\n\nQuem é dono não pode sair sozinho e responde pela corp.')) return;
      const r = await api('POST', '/dono', { user_id: userId });
      if (r !== false) location.reload();
    }

    async function tirarDono() {
      if (!confirm('Deixar a corporação SEM dono?\n\nEla continua existindo, mas só staff do site vai conseguir gerenciar até alguém assumir.')) return;
      const r = await api('POST', '/dono', { limpar: true });
      if (r !== false) location.reload();
    }

    async function deleteMember(memberId) {
      if (!confirm('Remover este membro?')) return;
      await api('DELETE', '/members/' + memberId);
      location.reload();
    }

    async function saveConfig() {
      const iconFile = document.getElementById('cfg-icon-file').files[0];
      const iconUrl = document.getElementById('cfg-icon').value.trim();

      // 1. Se tem arquivo, faz upload primeiro
      if (iconFile) {
        const form = new FormData();
        form.append('icon', iconFile);
        const upRes = await fetch('/api/corps/' + CORP_ID + '/icon', { method: 'POST', body: form });
        const upData = await upRes.json();
        if (upData.error) return showAlert(upData.error, 'error');
      }

      // 2. Salva o resto das configs
      const body = {
        name: document.getElementById('cfg-name').value.trim(),
        description: document.getElementById('cfg-desc').value.trim(),
        icon_url: iconFile ? '' : iconUrl,
        color: document.getElementById('cfg-color').value,
        max_members: parseInt(document.getElementById('cfg-max').value) || 100
      };
      const res = await fetch('/api/corps/' + CORP_ID, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body)
      });
      const data = await res.json();
      if (data.error) return showAlert(data.error, 'error');
      showAlert('Configurações salvas!', 'success');
      setTimeout(() => location.reload(), 500);
    }

    async function removeIcon() {
      if (!confirm('Remover a imagem da corporação?')) return;
      await fetch('/api/corps/' + CORP_ID + '/icon', { method: 'DELETE' });
      showAlert('Imagem removida', 'success');
      setTimeout(() => location.reload(), 500);
    }

    // Co-gerentes
    async function loadManagers() {
      const res = await fetch('/api/corps/' + CORP_ID + '/managers');
      const data = await res.json();
      const list = document.getElementById('managers-list');
      if (!data.managers || data.managers.length === 0) {
        list.innerHTML = '<div class="empty">Nenhum co-gerente adicionado.</div>';
        return;
      }
      list.innerHTML = data.managers.map(function(m) {
        return '<div class="rank-item">' +
          '<div class="rank-info">' +
            '<span class="rank-name">' + (m.discord_username || m.roblox_username || 'User #' + m.user_id) + '</span>' +
            '<span class="rank-salary" style="color:#5B6573">ID: ' + m.user_id + '</span>' +
          '</div>' +
          '<div class="rank-actions">' +
            '<button class="btn-sm danger" onclick="removeManager(' + m.id + ')">Remover</button>' +
          '</div>' +
        '</div>';
      }).join('');
    }

    async function addManager() {
      const u = pickers.mgr && pickers.mgr.get();
      if (!u) return showAlert('Selecione um usuário da lista', 'error');
      const res = await fetch('/api/corps/' + CORP_ID + '/managers', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ user_id: u.id })
      });
      const data = await res.json();
      if (data.error) return showAlert(data.error, 'error');
      showAlert('Co-gerente adicionado!', 'success');
      pickers.mgr.clear();
      loadManagers();
    }

    async function removeManager(managerId) {
      if (!confirm('Remover este co-gerente?')) return;
      await fetch('/api/corps/' + CORP_ID + '/managers/' + managerId, { method: 'DELETE' });
      showAlert('Co-gerente removido', 'success');
      loadManagers();
    }

    // Carrega co-gerentes ao abrir a aba config.
    // [23/09] COM GUARDA: quem nao tem o poder nao recebe a aba, e sem o if o
    // querySelector devolvia null aqui e MATAVA o script inteiro da pagina --
    // trocar cargo, remover membro, as abas, tudo parava de funcionar em
    // silencio. Um indice nil num script derruba todo o resto junto.
    var abaConfig = document.querySelector('[data-tab="config"]');
    if (abaConfig) {
      abaConfig.addEventListener('click', loadManagers);
      if (abaConfig.classList.contains('active')) loadManagers();
    }

    // ---------------------------------------------------------------- CAIXA
    // Recarrega a cada abertura da aba e depois de toda acao: o extrato "em
    // tempo real" que o Julio pediu e simplesmente nao mostrar dado velho.
    function dinheiro(v) {
      var n = Math.round(Number(v) || 0);
      var s = Math.abs(n).toLocaleString('pt-BR');
      return (n < 0 ? '-R$ ' : 'R$ ') + s;
    }
    function quando(iso) {
      if (!iso) return '';
      var d = new Date(iso);
      return d.toLocaleDateString('pt-BR') + ' ' + d.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' });
    }
    // [23/10] Governo: a aba mostra o Tesouro (dados de /api/governo), nunca o caixa de corp.
    var EH_GOVERNO = <%- JSON.stringify(corporation.tipo === 'governo') %>;
    function escT(t) { return String(t == null ? '' : t).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
    async function loadTesouro() {
      var res = await fetch('/api/governo');
      var d = await res.json().catch(function () { return {}; });
      if (!res.ok || d.error) return showAlert(d.error || 'Não deu pra abrir o Tesouro', 'error');
      var soma = function (l) { return (l || []).reduce(function (t, c) { return t + (Number(c.inflado) || 0); }, 0); };
      document.getElementById('tg-saldo').textContent = dinheiro(d.saldo);
      document.getElementById('tg-24h').textContent = dinheiro(soma(d.arrecadacao.h24));
      document.getElementById('tg-7d').textContent = dinheiro(soma(d.arrecadacao.d7));
      document.getElementById('tg-mult').textContent = '×' + Number(d.multiplicador).toLocaleString('pt-BR');
      var s = d.salarios;
      document.getElementById('tg-folha').innerHTML = '<b style="color:#1D3F94">Salário do Governo</b> · a cada ' + s.periodo_dias +
        ' dias · próximo pagamento <b>' + quando(s.proximo_pagamento) + '</b><br>folha do próximo pagamento <b>' + dinheiro(s.folha) +
        '</b> (só recebe quem entrar no jogo no período) · saldo ' + dinheiro(d.saldo) + ' · ' +
        (d.saldo >= s.folha ? '<b style="color:#15803D">o saldo cobre a folha</b>'
                            : '<b style="color:#B91C1C">faltam ' + dinheiro(s.folha - d.saldo) + ' pra cobrir a folha</b>');
      document.getElementById('tg-obras').innerHTML = (d.obras || []).map(function (o) {
        return '<tr><td>' + escT(o.nome) + '</td><td style="text-align:right">' + dinheiro(o.valor) + '</td></tr>';
      }).join('') || '<tr><td colspan="2" class="empty">Nenhuma obra.</td></tr>';
      document.getElementById('tg-extrato').innerHTML = (d.extrato || []).slice(0, 30).map(function (l) {
        var cor = l.valor < 0 ? '#B91C1C' : '#15803D';
        return '<tr><td>' + quando(l.criado_em) + '</td><td>' + escT(({ obra: 'Obra', salario: 'Salário', salario_emprego: 'Emprego civil' })[l.tipo] || l.tipo) + '</td><td>' + escT(l.quem || '') +
          '</td><td style="text-align:right;color:' + cor + '">' + dinheiro(l.valor) + '</td><td style="text-align:right">' + dinheiro(l.saldo_depois) + '</td></tr>';
      }).join('') || '<tr><td colspan="5" class="empty">Nada ainda.</td></tr>';
    }

    var CAIXA_PRECOS = {};

    async function loadCaixa() {
      if (EH_GOVERNO) return loadTesouro();
      var res = await fetch('/api/corps/' + CORP_ID + '/caixa');
      var d = await res.json();
      if (d.error) return showAlert(d.error, 'error');
      CAIXA_PRECOS = d.precos || {};

      document.getElementById('cx-saldo').textContent = dinheiro(d.saldo);
      document.getElementById('cx-entrou').textContent = dinheiro(d.balanco.entrou);
      document.getElementById('cx-saiu').textContent = dinheiro(d.balanco.saiu);
      document.getElementById('cx-perdas').textContent =
        (d.itens || []).reduce(function (a, i) { return a + (i.perdido || 0); }, 0) + ' peça(s)';

      // [28/09] REPASSE DO GOVERNO. A rota já pagou o que estava pendente antes de
      // montar isto, então o "último" aqui pode ser o que acabou de cair.
      var orc = d.orcamento;
      var elOrc = document.getElementById('cx-orcamento');
      if (elOrc) {
        if (!orc) {
          elOrc.style.display = 'none';
        } else {
          elOrc.style.display = '';
          var faltaMs = Math.max(0, Number(orc.proximo_em) - Date.now());
          var dd = Math.floor(faltaMs / 86400000);
          var hh = Math.floor((faltaMs % 86400000) / 3600000);
          var falta = dd > 0 ? (dd + 'd ' + hh + 'h') : (hh + 'h');
          var ult = orc.ultimo
            ? ('último: ' + dinheiro(orc.ultimo.valor) + ' em ' + quando(orc.ultimo.em))
            : 'nenhum repasse ainda';
          elOrc.innerHTML =
            '<b style="color:#1D3F94">Repasse do governo</b> · a cada ' + orc.dias + ' dias · próximo em <b>' + falta + '</b><br>' +
            'previsto <b>' + dinheiro(orc.previsto.total) + '</b> = base ' + dinheiro(orc.previsto.base) +
            ' + ' + orc.atividade_periodo + ' ocorrência(s) no período · ' + ult;
        }
      }

      // [23/10] FOLHA: o salario inteiro dos membros sai do caixa (ponto de salario do jogo)
      var elF = document.getElementById('cx-folha');
      if (elF && d.folha) {
        var f = d.folha;
        elF.style.display = '';
        var cobre = f.cobre_dias === null ? 'ninguém recebeu salário nos últimos 7 dias'
          : (f.cobre_dias < 1 ? '<b style="color:#B91C1C">o caixa cobre menos de 1 dia de salário</b>'
          : 'o caixa cobre <b>' + String(f.cobre_dias).replace('.', ',') + ' dia(s)</b> de salário nesse ritmo');
        elF.innerHTML = '<b style="color:#1D7A45">Folha de salário</b> · últimos 7 dias <b>' + dinheiro(f.semana) + '</b> · ' +
          f.pagamentos + ' pagamento(s) para ' + f.pessoas + ' pessoa(s)<br>' + cobre +
          '. Caixa vazio: o membro recebe só o piso de R$ 500, que não sai do caixa.';
      }

      // [29/09] o seletor lista SO arma e algema -- o resto do vestiario e
      // infinito e nao tem preco de proposito. Vazio tem dois motivos bem
      // diferentes, e o painel agora diz qual e: ou o jogo nao publicou o
      // catalogo ainda, ou esta corp realmente nao compra nada (SAMU, Pavuna).
      var sel = document.getElementById('cx-item');
      if (sel) {
        var nomes = Object.keys(CAIXA_PRECOS).sort();
        sel.innerHTML = nomes.length
          ? nomes.map(function (n) { return '<option value="' + n + '">' + n + ' — ' + dinheiro(CAIXA_PRECOS[n]) + '</option>'; }).join('')
          : (d.catalogo_publicado
              ? '<option value="">Esta corporação não compra nada — o vestiário dela só tem item infinito</option>'
              : '<option value="">O jogo ainda não publicou os preços</option>');
      }

      var tb = document.getElementById('cx-estoque');
      var bs = d.banco_sangue;   // [18/10] SAMU: a geladeira do banco de sangue (só doação, sem compra nem baixa)
      tb.innerHTML = (d.itens && d.itens.length)
        ? d.itens.map(function (i) {
            if (bs && i.item === bs.item) {
              return '<tr><td><b>Banco de sangue</b> <span style="color:#5B6573">· ' + i.prateleira + '/' + bs.teto + ' bolsas · enche só com doação na cadeira do hospital</span></td>' +
                '<td style="font-variant-numeric:tabular-nums">' + i.prateleira + '</td>' +
                '<td style="font-variant-numeric:tabular-nums">' + i.rua + '</td>' +
                '<td style="font-variant-numeric:tabular-nums;color:#5B6573">—</td>' +
                (d.pode_estoque ? '<td></td>' : '') + '</tr>';
            }
            return '<tr><td>' + i.item + '</td>' +
              '<td style="font-variant-numeric:tabular-nums">' + i.prateleira + '</td>' +
              '<td style="font-variant-numeric:tabular-nums">' + i.rua + '</td>' +
              '<td style="font-variant-numeric:tabular-nums;color:' + (i.perdido ? '#A86400' : '#5B6573') + '">' + i.perdido + '</td>' +
              (d.pode_estoque ? '<td><button class="btn-sm danger" onclick="darBaixa(\'' + i.item.replace(/'/g, "\\'") + '\')">Dar baixa</button></td>' : '') +
              '</tr>';
          }).join('')
        : '<tr><td colspan="5" class="empty">Estoque vazio — compre equipamento acima.</td></tr>';

      var tbx = document.getElementById('cx-baixas');
      if (tbx) {
        tbx.innerHTML = (d.baixas && d.baixas.length)
          ? d.baixas.map(function (b) {
              return '<tr><td style="color:#5B6573;white-space:nowrap">' + quando(b.criado_em) + '</td><td>' + b.item + '</td><td>' + (b.por || '—') + '</td>' +
                '<td>' + (b.desfeita ? '<span style="color:#5B6573">Desfeita</span>' : '<button class="btn-sm" onclick="desfazerBaixa(' + b.id + ', \'' + String(b.item).replace(/'/g, "\\'") + '\')">Desfazer</button>') + '</td></tr>';
            }).join('')
          : '<tr><td colspan="4" class="empty">Nenhuma baixa nas últimas 48h.</td></tr>';
      }

      // [18/10] doações de sangue: só a SAMU tem o bloco
      var bd = document.getElementById('cx-doacoes-bloco');
      if (bd) {
        bd.style.display = bs ? '' : 'none';
        if (bs) {
          document.getElementById('cx-doacoes-teto').textContent = bs.teto;
          document.getElementById('cx-doacoes').innerHTML = (d.doacoes && d.doacoes.length)
            ? d.doacoes.map(function (x) {
                return '<tr><td style="color:#5B6573;white-space:nowrap">' + quando(x.criado_em) + '</td><td>Doação de sangue (' + (x.quem || '—') + ')</td></tr>';
              }).join('')
            : '<tr><td colspan="2" class="empty">Ninguém doou ainda. A geladeira está com ' + bs.prateleira + '/' + bs.teto + '.</td></tr>';
        }
      }

      var te = document.getElementById('cx-emprestimos');
      te.innerHTML = (d.emprestimos && d.emprestimos.length)
        ? d.emprestimos.map(function (e) {
            return '<tr><td>' + e.nome + '</td><td>' + e.item + '</td><td style="color:#5B6573">' + quando(e.pego_em) + '</td></tr>';
          }).join('')
        : '<tr><td colspan="3" class="empty">Ninguém está com equipamento da corp agora.</td></tr>';

      // [29/09] perdas agregadas: dia, item, quantidade. Nenhum nome -- de propósito.
      var tp = document.getElementById('cx-perdas-dia');
      if (tp) {
        tp.innerHTML = (d.perdas_dia && d.perdas_dia.length)
          ? d.perdas_dia.map(function (p) {
              var dia = new Date(p.dia).toLocaleDateString('pt-BR');
              return '<tr><td style="color:#5B6573;white-space:nowrap">' + dia + '</td>' +
                '<td>' + p.item + '</td>' +
                '<td style="text-align:right;font-variant-numeric:tabular-nums;color:#A86400">' + p.qtd + '</td></tr>';
            }).join('')
          : '<tr><td colspan="3" class="empty">Nenhuma peça perdida ainda.</td></tr>';
      }

      // O extrato é só DINHEIRO: a rota já filtra `tipo <> 'estoque'`.
      var tx = document.getElementById('cx-extrato');
      tx.innerHTML = (d.extrato && d.extrato.length)
        ? d.extrato.map(function (l) {
            var desc = l.tipo + (l.item ? ' · ' + l.item + (l.qtd > 1 ? ' x' + l.qtd : '') : '');
            var cor = l.valor > 0 ? '#1D7A45' : (l.valor < 0 ? '#B23227' : '#5B6573');
            return '<tr><td style="color:#5B6573;white-space:nowrap">' + quando(l.criado_em) + '</td>' +
              '<td>' + desc + '</td>' +
              '<td>' + (l.quem || '—') + '</td><td style="color:#5B6573">' + (l.por || '—') + '</td>' +
              '<td style="text-align:right;font-variant-numeric:tabular-nums;color:' + cor + '">' + (l.valor ? dinheiro(l.valor) : '—') + '</td>' +
              '<td style="text-align:right;font-variant-numeric:tabular-nums;color:#5B6573">' + (l.saldo_depois === null ? '—' : dinheiro(l.saldo_depois)) + '</td></tr>';
          }).join('')
        : '<tr><td colspan="6" class="empty">Nenhum movimento ainda.</td></tr>';
    }

    async function comprarItem() {
      var item = document.getElementById('cx-item').value;
      var qtd = parseInt(document.getElementById('cx-qtd').value) || 1;
      if (!item) return showAlert('Escolha o item', 'error');
      var d = await api('POST', '/caixa/comprar', { item: item, qtd: qtd });
      if (d.error) return showAlert(d.error, 'error');
      showAlert('Comprado por ' + dinheiro(d.total) + ' · ' + d.prateleira + ' na prateleira', 'success');
      loadCaixa();
    }

    async function darBaixa(item) {
      if (!confirm('Dar baixa em 1 ' + item + '?\n\nATENÇÃO: arma perdida na rua (morte ou revista) JÁ SAI SOZINHA do estoque e já aparece em Perdidos. Não precisa dar baixa nela.\n\nA baixa tira 1 ' + item + ' que AINDA ESTÁ NO ARMÁRIO e conta como perda, sem devolver dinheiro. Só use se ela sumiu de verdade de lá.')) return;
      var d = await api('POST', '/caixa/baixa', { item: item });
      if (d.error) return showAlert(d.error, 'error');
      showAlert('Baixa registrada', 'success');
      loadCaixa();
    }

    async function desfazerBaixa(id, item) {
      if (!confirm('Desfazer a baixa de 1 ' + item + '? Ela volta pro armário e sai de Perdidos.')) return;
      var d = await api('POST', '/caixa/baixa/' + id + '/desfazer', {});
      if (d.error) return showAlert(d.error, 'error');
      showAlert('Baixa desfeita: 1 ' + item + ' voltou pro armário', 'success');
      loadCaixa();
    }

    async function aportar() {
      var v = parseInt(document.getElementById('cx-aporte').value);
      if (!(v > 0)) return showAlert('Valor inválido', 'error');
      var d = await api('POST', '/caixa/aporte', { valor: v });
      if (d.error) return showAlert(d.error, 'error');
      document.getElementById('cx-aporte').value = '';
      showAlert('Depositado', 'success');
      loadCaixa();
    }

    async function pagarBonus() {
      var sel = document.getElementById('cx-bonus-quem');
      var robloxId = sel && sel.value;
      var valor = parseInt(document.getElementById('cx-bonus-valor').value, 10);
      if (!robloxId) return showAlert('Escolha quem recebe', 'error');
      if (!(valor > 0)) return showAlert('Informe um valor', 'error');
      var nome = sel.options[sel.selectedIndex].getAttribute('data-nome') || '';
      var d = await api('POST', '/caixa/bonus', { roblox_id: robloxId, nome: nome, valor: valor });
      if (!d || d.error) return;
      document.getElementById('cx-bonus-valor').value = '';
      showAlert('B\u00f4nus de ' + dinheiro(valor) + ' pago pra ' + nome, 'success');
      loadCaixa();
    }

    var abaCaixa = document.querySelector('[data-tab="caixa"]');
    if (abaCaixa) abaCaixa.addEventListener('click', loadCaixa);
  </script>
</body>
</html>
