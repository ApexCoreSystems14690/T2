<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Governo — <%= cidade.nome %></title>
  <meta name="theme-color" content="#1C2127">
  <style>
    /* [23/10] TESOURO DO GOVERNO. Faixa de cima: o caixa em número grande, como um painel de
       obra pública (asfalto + faixa zebrada). Embaixo, papel: arrecadação, obras, salários, extrato. */
    body { margin: 0; }
    .topbar { display: flex; align-items: center; justify-content: space-between; }
    .topbar nav { display: flex; gap: 1rem; align-items: center; }
    .tesouro { position: relative; background: linear-gradient(180deg, #0F1217, #1B1F25); color: #E9EDF1; isolation: isolate; overflow: hidden; }
    .tesouro::after { content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 10px; z-index: -1;
      background: repeating-linear-gradient(-45deg, var(--pista) 0 14px, #10131A 14px 28px); }
    .tesouro .dentro { max-width: 1080px; margin: 0 auto; padding: 1.6rem clamp(16px, 3vw, 28px) 2.2rem; display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 1rem 2rem; align-items: end; }
    .kicker { font-size: .78rem; color: #AEB7C1; margin: 0 0 .4rem; letter-spacing: .04em; }
    .saldo { font-stretch: 75%; font-variation-settings: "wdth" 75; font-weight: 800; color: #fff; font-size: clamp(2.8rem, 9vw, 5.6rem); line-height: .9; font-variant-numeric: tabular-nums; }
    .saldo small { font-size: .38em; color: var(--pista); margin-right: .25rem; vertical-align: .55em; }
    .saldo-cheio { color: #8A949E; font-size: .85rem; margin-top: .4rem; font-variant-numeric: tabular-nums; }
    .resumo { display: grid; grid-template-columns: repeat(3, auto); gap: .3rem 1.4rem; text-align: right; }
    .resumo div span { display: block; color: #8A949E; font-size: .74rem; }
    .resumo div b { color: #fff; font-size: 1.15rem; font-variant-numeric: tabular-nums; }
    .resumo div b.pista { color: var(--pista); }

    .casa { max-width: 1080px; margin: 0 auto; padding: 1rem clamp(16px, 3vw, 28px) 4rem; }
    .abas { display: flex; gap: .2rem; border-bottom: 1px solid var(--linha); margin-bottom: 1rem; overflow-x: auto; }
    .abas button { border: 0; background: transparent; padding: .7rem .9rem; font: inherit; font-weight: 700; color: var(--tinta-3); border-bottom: 3px solid transparent; cursor: pointer; white-space: nowrap; display: inline-flex; gap: .4rem; align-items: center; }
    .abas button.on { color: var(--tinta); border-bottom-color: var(--pista); }
    .prop { background: var(--papel); border: 1px solid var(--linha); border-radius: var(--r); padding: .9rem 1.1rem; margin-bottom: .8rem; }
    .prop-top { display: flex; gap: .6rem; align-items: baseline; flex-wrap: wrap; }
    .prop-top b.n { font-stretch: 75%; font-variation-settings: "wdth" 75; font-weight: 800; font-size: 1.15rem; }
    .prop .mud { margin: .35rem 0; font-variant-numeric: tabular-nums; }
    .prop .votos { display: flex; flex-wrap: wrap; gap: .3rem; margin-top: .45rem; }
    .prop .acoes { display: flex; gap: .4rem; flex-wrap: wrap; margin-top: .6rem; }
    .camf { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: .6rem; align-items: end; }
    .camf label { display: flex; flex-direction: column; gap: .2rem; font-size: .8rem; color: var(--tinta-2); font-weight: 600; }
    .camf input, .camf select, .camf textarea { padding: .45rem .6rem; border: 1px solid var(--linha-2); border-radius: var(--rs); font: inherit; }
    .camf .tudo { grid-column: 1 / -1; }
    .camf [hidden] { display: none; }
    .btn.mini { margin-top: .3rem; padding: .2rem .6rem; font-size: .78rem; }
    details.corp-sal { border-top: 1px solid var(--linha); padding: .5rem 0; }
    details.corp-sal summary { cursor: pointer; }
    details.corp-sal table { margin-top: .4rem; }
    .bloco { background: var(--papel); border: 1px solid var(--linha); border-radius: var(--r); padding: 1rem 1.1rem; margin-bottom: 1rem; }
    .bloco h3 { margin: 0 0 .7rem; font-size: 1.05rem; display: flex; gap: .6rem; align-items: baseline; flex-wrap: wrap; }
    .bloco h3 small { color: var(--tinta-3); font-weight: 500; font-size: .8rem; }
    .expl { color: var(--tinta-2); font-size: .88rem; margin: 0 0 .8rem; }
    .cat { display: grid; grid-template-columns: minmax(120px, 200px) minmax(0, 1fr) auto; gap: .6rem; align-items: center; padding: .4rem 0; border-top: 1px solid var(--linha); font-size: .9rem; }
    .cat:first-of-type { border-top: 0; }
    .barra { height: 10px; background: var(--papel-2); border-radius: 5px; overflow: hidden; }
    .barra i { display: block; height: 100%; background: var(--placa); border-radius: 5px; }
    .cat b { font-variant-numeric: tabular-nums; text-align: right; white-space: nowrap; }
    .cat .r { color: var(--tinta-3); font-size: .74rem; display: block; font-weight: 500; }
    .dias { display: flex; align-items: flex-end; gap: 6px; height: 120px; padding-top: .4rem; }
    .dias div { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; gap: 4px; height: 100%; justify-content: flex-end; }
    .dias i { width: 100%; max-width: 34px; background: var(--placa); border-radius: 4px 4px 0 0; min-height: 2px; }
    .dias span { font-size: .66rem; color: var(--tinta-3); }
    .lista { border: 1px solid var(--linha); border-radius: var(--r); overflow: hidden; background: var(--papel); }
    .obra { display: grid; grid-template-columns: 44px minmax(0, 1fr) auto auto; gap: .2rem 1rem; align-items: center; padding: .85rem 1rem; border-top: 1px solid var(--linha); }
    .obra:first-child { border-top: 0; }
    .obra .n { width: 44px; height: 44px; border-radius: var(--rs); background: #10131A; color: var(--pista); display: grid; place-items: center; font-weight: 800; font-stretch: 75%; font-variation-settings: "wdth" 75; font-size: 1.2rem; }
    .obra .t { font-weight: 700; }
    .obra .v { text-align: right; line-height: 1.1; }
    .obra .v b { font-stretch: 75%; font-variation-settings: "wdth" 75; font-weight: 800; font-size: 1.4rem; color: var(--asfalto); }
    .obra .v small { display: block; color: var(--tinta-3); font-size: .72rem; font-variant-numeric: tabular-nums; }
    .obra .acoes { display: flex; gap: .4rem; }
    table { width: 100%; }
    th { text-align: left; }
    td, th { padding: .5rem .6rem; font-size: .88rem; vertical-align: top; }
    .num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
    .pill { display: inline-block; font-size: .72rem; font-weight: 700; padding: .08rem .45rem; border-radius: 4px; }
    .sim { background: var(--ok-bg); color: var(--ok); } .nao { background: var(--papel-2); color: var(--tinta-3); } .alerta { background: var(--alerta-bg); color: var(--alerta); }
    .mais { color: var(--ok); font-weight: 700; } .menos { color: var(--perigo); font-weight: 700; }
    .config { display: flex; gap: .6rem; flex-wrap: wrap; align-items: flex-end; }
    .config label { display: flex; flex-direction: column; gap: .2rem; font-size: .8rem; color: var(--tinta-2); font-weight: 600; }
    .config input { padding: .45rem .6rem; border: 1px solid var(--linha-2); border-radius: var(--rs); width: 160px; }
    .fundo { position: fixed; inset: 0; background: rgba(16,19,26,.55); display: none; align-items: center; justify-content: center; padding: 16px; z-index: 80; }
    .fundo.on { display: flex; }
    .modal { background: var(--papel); border-radius: var(--r); max-width: 460px; width: 100%; overflow: hidden; box-shadow: var(--sombra-modal); }
    .modal .faixa { height: 8px; background: repeating-linear-gradient(-45deg, var(--pista) 0 12px, #10131A 12px 24px); }
    .modal .corpo { padding: 1.1rem 1.2rem; }
    .modal h3 { margin: 0 0 .4rem; }
    .modal textarea { width: 100%; min-height: 90px; padding: .6rem; border: 1px solid var(--linha-2); border-radius: var(--rs); font: inherit; }
    .modal .acoes { display: flex; gap: .5rem; justify-content: flex-end; margin-top: .8rem; }
    .toast { position: fixed; left: 50%; bottom: 18px; transform: translateX(-50%); background: var(--asfalto); color: #fff; padding: .7rem 1rem; border-radius: var(--rs); font-weight: 700; display: none; z-index: 90; max-width: calc(100% - 32px); }
    .toast.on { display: block; } .toast.err { background: var(--perigo); }
    .rolar { overflow-x: auto; }
    @media (max-width: 700px) {
      .tesouro .dentro { grid-template-columns: 1fr; }
      .resumo { text-align: left; grid-template-columns: repeat(3, 1fr); }
      .cat { grid-template-columns: minmax(0, 1fr) auto; }
      .cat .barra { grid-column: 1 / -1; grid-row: 2; }
      .obra { grid-template-columns: 40px minmax(0, 1fr); }
      .obra .n { width: 40px; height: 40px; }
      .dias { gap: 3px; }
      .dias span { font-size: .55rem; }
      .dias div:nth-child(even) span { visibility: hidden; }
      .obra .v { grid-column: 1 / -1; text-align: left; display: flex; gap: .6rem; align-items: baseline; }
      .obra .acoes { grid-column: 1 / -1; }
      .topbar h1 { display: none !important; }
      .topbar nav .txt { display: none; }
    }
  </style>
  <link rel="stylesheet" href="/sf.css">
</head>
<body>
  <div class="topbar">
    <div style="display:flex;align-items:center;gap:1rem">
      <%- include('partials/placa') %>
      <h1>Governo</h1>
    </div>
    <nav>
      <a href="/painel"><svg class="ic" aria-hidden="true"><use href="/icones.svg#casa"/></svg><span class="txt">Painel</span></a>
      <a href="/auth/logout"><svg class="ic" aria-hidden="true"><use href="/icones.svg#sair"/></svg><span class="txt">Sair</span></a>
    </nav>
  </div>

  <section class="tesouro">
    <div class="dentro">
      <div>
        <p class="kicker">Tesouro do Governo de <%= cidade.nome %></p>
        <div class="saldo" id="saldo"><small>R$</small>–</div>
        <div class="saldo-cheio" id="saldo-cheio"></div>
      </div>
      <div class="resumo">
        <div><span>Arrecadou em 24 h</span><b id="r24">–</b></div>
        <div><span>Em 7 dias</span><b id="r7">–</b></div>
        <div><span>Próximo salário</span><b class="pista" id="rsal">–</b></div>
      </div>
    </div>
  </section>

  <main class="casa">
    <div class="abas" role="tablist">
      <button class="on" data-aba="arrecadacao"><svg class="ic" aria-hidden="true"><use href="/icones.svg#moedas"/></svg>Arrecadação</button>
      <button data-aba="obras"><svg class="ic" aria-hidden="true"><use href="/icones.svg#martelo"/></svg>Obras</button>
      <button data-aba="salarios"><svg class="ic" aria-hidden="true"><use href="/icones.svg#pasta-trabalho"/></svg>Salários</button>
      <button data-aba="camara"><svg class="ic" aria-hidden="true"><use href="/icones.svg#urna"/></svg>Câmara</button>
      <button data-aba="extrato"><svg class="ic" aria-hidden="true"><use href="/icones.svg#pasta"/></svg>Extrato</button>
    </div>

    <section data-painel="arrecadacao">
      <div class="bloco">
        <h3>De onde vem o dinheiro <small>últimos 30 dias</small></h3>
        <p class="expl" id="mult-nota"></p>
        <div id="cats"></div>
      </div>
      <div class="bloco">
        <h3>Por dia <small>últimos 14 dias</small></h3>
        <div class="dias" id="dias"></div>
      </div>
      <% if (ehDono) { %>
      <div class="bloco">
        <h3>Configuração <small>só o Dono</small></h3>
        <div class="config">
          <label>Multiplicador (cada R$ 1 gasto vira)<input type="number" id="cfg-mult" min="1"></label>
          <button class="btn sec" type="button" id="cfg-salvar">Salvar</button>
        </div>
      </div>
      <% } %>
    </section>

    <section data-painel="obras" hidden>
      <p class="expl">O Governo vota a obra; o Dono retira o valor fixo do caixa com a descrição do que foi aprovado. Fica no extrato pra sempre.</p>
      <div class="lista" id="obras"></div>
    </section>

    <section data-painel="salarios" hidden>
      <div class="bloco">
        <h3>Folha do Governo <small id="sal-sub"></small></h3>
        <p class="expl">A cada 3 dias, quem tem cargo com salário e entrou no jogo nesses 3 dias recebe. O dinheiro sai do caixa e cai na carteira no próximo login. Ninguém precisa bater ponto no jogo.<% if (ehDono) { %> O salário de cada cargo se define na tela de cargos da corporação.<% } %></p>
        <div class="rolar"><table><thead><tr><th>Membro</th><th>Cargo</th><th class="num">Salário</th><th>Entrou neste período</th></tr></thead><tbody id="membros"></tbody></table></div>
        <% if (ehDono) { %><p style="margin:.8rem 0 0"><a class="btn sec" id="link-cargos" href="#">Cargos e salários</a></p><% } %>
      </div>
      <div class="bloco">
        <h3>Salários das corporações <small id="corp-sub"></small></h3>
        <p class="expl">O que cada cargo de cada corporação da cidade ganha por 40 minutos trabalhados (sai do caixa da própria corporação). Mudar um valor é projeto na Câmara: clique em <b>Propor</b> no cargo.</p>
        <div id="corps-sal"></div>
      </div>
      <div class="bloco">
        <h3>Repasse semanal das corporações <small id="rep-sub"></small></h3>
        <p class="expl">O dinheiro que cai no caixa de cada corporação a cada 7 dias (mais um extra por ocorrência registrada na semana). Empresa não recebe repasse. Mudar o valor é projeto na Câmara: clique em <b>Propor</b>. Vale a partir do próximo repasse.</p>
        <div class="rolar"><table style="display:table;white-space:normal"><thead><tr><th>Corporação</th><th class="num">Por semana</th><th class="num">Padrão</th></tr></thead><tbody id="repasses"></tbody></table></div>
      </div>
      <div class="bloco">
        <h3>Empregos civis pagos pelo tesouro</h3>
        <p class="expl">Gari, repositor, pizzaiolo, carteiro, mecânico e uber de passageiro bot recebem do tesouro do Governo. O jogo diz quanto cada tarefa pagou; pedido acima do teto é recusado inteiro. Tesouro vazio: o emprego não paga.</p>
        <div class="rolar"><table style="display:table;white-space:normal"><thead><tr><th>Emprego</th><th class="num">Teto por tarefa</th></tr></thead><tbody id="empregos"></tbody></table></div>
      </div>
      <div class="bloco">
        <h3>Últimos pagamentos</h3>
        <div class="rolar"><table><thead><tr><th>Período</th><th>Membro</th><th>Cargo</th><th class="num">Valor</th><th>Situação</th></tr></thead><tbody id="pagos"></tbody></table></div>
      </div>
    </section>

    <section data-painel="camara" hidden>
      <div class="bloco">
        <h3>Câmara <small id="cam-sub"></small></h3>
        <p class="expl">Regulamento, Cap. 10: Parlamentar, o Presidente da Câmara ou o Presidente da República abre a proposta: salário de cargo do Governo, salário de cargo de corporação, teto de emprego civil ou obra do tesouro. Ela fica <b>48 h em debate</b> e depois <b>24 h em votação</b>. Passa com mais SIM que NÃO entre quem votou; no empate, o Presidente da Câmara desempata. Aprovada, o Presidente da República tem <b>24 h</b> pra sancionar ou vetar (sem resposta, é sancionada sozinha). O veto volta pra Câmara e só cai com 2/3 dos votos. Sancionada, a mudança entra sozinha. Aumento do salário de Parlamentar só vale no próximo mandato (Art. 10.12A). Teto: cargo do Governo, 2x o salário padrão; corporação e emprego civil, 2x o valor de hoje.</p>
        <div id="cam-form"></div>
      </div>
      <div id="cam-lista"></div>
    </section>

    <section data-painel="extrato" hidden>
      <div class="bloco rolar">
        <table><thead><tr><th>Quando</th><th>O quê</th><th>Detalhe</th><th class="num">Valor</th><th class="num">Saldo depois</th></tr></thead><tbody id="extrato"></tbody></table>
        <p class="expl" style="margin:.6rem 0 0">A arrecadação entra somada por hora na aba Arrecadação; aqui ficam as saídas (obras e salários) e ajustes.</p>
      </div>
    </section>
  </main>

  <div class="fundo" id="fundo" role="dialog" aria-modal="true" aria-labelledby="m-t">
    <div class="modal"><div class="faixa"></div><div class="corpo">
      <h3 id="m-t">Retirar</h3>
      <p class="expl" id="m-v"></p>
      <textarea id="m-desc" maxlength="300" placeholder="O que foi aprovado: ex. Projeto 12/2026, alargar a Av. Astorga, aprovado na Câmara em 22/10"></textarea>
      <div class="acoes"><button class="btn sec" type="button" id="m-nao">Voltar</button><button class="btn" type="button" id="m-sim">Retirar do caixa</button></div>
    </div></div>
  </div>
  <div class="toast" id="toast" role="status"></div>

<script>
(function () {
  var $ = function (id) { return document.getElementById(id); };
  var D = null, obraSel = null;
  var DONO = <%- JSON.stringify(!!ehDono) %>;
  function esc(s) { var d = document.createElement('div'); d.textContent = s == null ? '' : String(s); return d.innerHTML; }
  function cheio(v) { return 'R$ ' + Number(v || 0).toLocaleString('pt-BR'); }
  function curto(v) {
    var n = Number(v || 0), a = Math.abs(n), s = n < 0 ? '-' : '';
    var f = function (x, u) { return s + x.toLocaleString('pt-BR', { maximumFractionDigits: x < 10 ? 2 : 1 }) + ' ' + u; };
    if (a >= 1e12) return f(a / 1e12, 'tri'); if (a >= 1e9) return f(a / 1e9, 'bi'); if (a >= 1e6) return f(a / 1e6, 'mi'); if (a >= 1e4) return f(a / 1e3, 'mil');
    return s + a.toLocaleString('pt-BR');
  }
  function data(t) { var d = new Date(t); return d.toLocaleDateString('pt-BR') + ' ' + d.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' }); }
  function toast(t, err) { var x = $('toast'); x.textContent = t; x.className = 'toast on' + (err ? ' err' : ''); clearTimeout(x._t); x._t = setTimeout(function () { x.className = 'toast'; }, 3800); }
  function soma(l) { return (l || []).reduce(function (t, c) { return t + c.inflado; }, 0); }

  async function carregar() {
    var r = await fetch('/api/governo', { headers: { accept: 'application/json' } });
    var j = await r.json().catch(function () { return {}; });
    if (!r.ok) { $('cats').innerHTML = '<p class="expl">' + esc(j.error || 'Erro') + '</p>'; return; }
    D = j; desenhar();
  }
  function desenhar() {
    $('saldo').innerHTML = '<small>R$</small>' + esc(curto(D.saldo));
    $('saldo-cheio').textContent = cheio(D.saldo);
    $('r24').textContent = curto(soma(D.arrecadacao.h24));
    $('r7').textContent = curto(soma(D.arrecadacao.d7));
    $('rsal').textContent = new Date(D.salarios.proximo_pagamento).toLocaleDateString('pt-BR');
    $('mult-nota').innerHTML = 'Cada compra feita na cidade (carro, casa, loja, gasolina, documentos…) entra aqui multiplicada por <b>' + Number(D.multiplicador).toLocaleString('pt-BR') + '</b>: é o imposto de uma cidade de verdade, bem maior que os jogadores online.';
    if ($('cfg-mult')) $('cfg-mult').value = D.multiplicador;
    var c30 = D.arrecadacao.d30, max = Math.max.apply(null, c30.map(function (c) { return c.inflado; }).concat([1]));
    $('cats').innerHTML = c30.length ? c30.map(function (c) {
      return '<div class="cat"><span>' + esc(c.nome) + '</span><span class="barra"><i style="width:' + Math.max(2, Math.round(c.inflado / max * 100)) + '%"></i></span>'
        + '<b>' + esc(curto(c.inflado)) + '<span class="r">' + c.compras + ' compras · ' + esc(cheio(c.real)) + ' gastos</span></b></div>';
    }).join('') : '<p class="expl">Nenhuma compra registrada ainda.</p>';
    var dm = Math.max.apply(null, D.porDia.map(function (d) { return d.inflado; }).concat([1]));
    $('dias').innerHTML = D.porDia.length ? D.porDia.map(function (d) {
      return '<div title="' + esc(d.dia + ': ' + cheio(d.inflado) + ' · ' + d.compras + ' compras') + '"><i style="height:' + Math.max(2, Math.round(d.inflado / dm * 100)) + '%"></i><span>' + d.dia.slice(8) + '/' + d.dia.slice(5, 7) + '</span></div>';
    }).join('') : '<p class="expl">Sem dados ainda.</p>';

    $('obras').innerHTML = D.obras.map(function (o, i) {
      var falta = D.saldo < o.valor;
      return '<div class="obra"><span class="n">' + (i + 1) + '</span><span class="t">' + esc(o.nome) + '</span>'
        + '<span class="v"><b>' + esc(curto(o.valor)) + '</b><small>' + esc(cheio(o.valor)) + '</small></span>'
        + '<span class="acoes">' + (DONO ? '<button class="btn" type="button" data-obra="' + esc(o.chave) + '"' + (falta ? ' disabled title="Caixa insuficiente"' : '') + '>Retirar</button>'
          + '<button class="btn sec" type="button" data-editar="' + esc(o.chave) + '">Valor</button>' : (falta ? '<span class="pill nao">caixa insuficiente</span>' : '<span class="pill sim">dá pra pagar</span>')) + '</span></div>';
    }).join('');
    $('obras').querySelectorAll('[data-obra]').forEach(function (b) { b.onclick = function () { abrir(b.dataset.obra); }; });
    $('obras').querySelectorAll('[data-editar]').forEach(function (b) { b.onclick = function () { editarValor(b.dataset.editar); }; });

    var s = D.salarios;
    $('sal-sub').textContent = 'período atual desde ' + new Date(s.inicio).toLocaleDateString('pt-BR') + ' · próximo pagamento ' + new Date(s.proximo_pagamento).toLocaleDateString('pt-BR') + ' · folha ' + cheio(s.folha) + ' · ' + (D.saldo >= s.folha ? 'o saldo cobre a folha' : 'faltam ' + cheio(s.folha - D.saldo) + ' pra cobrir a folha');
    $('membros').innerHTML = s.membros.length ? s.membros.map(function (m) {
      return '<tr><td><b>' + esc(m.nome || '?') + '</b>' + (m.roblox_id ? '' : ' <span class="pill alerta">sem Roblox vinculado</span>') + '</td><td>' + esc(m.cargo || '—') + '</td>'
        + '<td class="num">' + (m.salario ? cheio(m.salario) : '<span class="pill nao">sem salário</span>') + '</td>'
        + '<td>' + (m.entrou_no_periodo ? '<span class="pill sim">entrou</span>' : '<span class="pill nao">ainda não</span>') + '</td></tr>';
    }).join('') : '<tr><td colspan="4" class="expl">O Governo ainda não tem membros. Adicione pela tela da corporação.</td></tr>';
    $('empregos').innerHTML = (D.empregos || []).map(function (e) {
      return '<tr><td>' + esc(e.nome) + '</td><td class="num">' + cheio(e.teto)
        + (D.eh_dono ? '<br><button class="btn sec mini" data-teto="' + esc(e.emprego) + '">Mudar</button>' : '')
        + (D.pode_propor ? ' <button class="btn sec mini" data-propor-emp="' + esc(e.emprego) + '">Propor</button>' : '') + '</td></tr>';
    }).join('') || '<tr><td colspan="3" class="expl">Nenhum emprego configurado.</td></tr>';
    $('empregos').querySelectorAll('[data-propor-emp]').forEach(function (b) { b.onclick = function () { irPropor({ tipo: 'emprego', emprego: b.dataset.proporEmp }); }; });
    // [24/10] salários de todas as corporações (só leitura; mudar = projeto na Câmara)
    var CS = D.corporacoes || [];
    $('corp-sub').textContent = CS.length + ' corporaç' + (CS.length === 1 ? 'ão' : 'ões');
    var CSc = CS.filter(function (c) { return c.cargos.length; });   // corp sem cargo aparece só no repasse
    $('corps-sal').innerHTML = CSc.length ? CSc.map(function (c) {
      return '<details class="corp-sal"><summary><b>' + esc(c.nome) + '</b> <span class="expl">· ' + c.membros + ' membro(s) · folha ' + cheio(c.folha40) + ' a cada 40 min se todos trabalharem</span></summary>'
        + '<div class="rolar"><table style="display:table;white-space:normal"><thead><tr><th>Cargo</th><th class="num">Por 40 min</th><th class="num">Membros</th>' + (D.pode_propor ? '<th></th>' : '') + '</tr></thead><tbody>'
        + c.cargos.map(function (r) {
            return '<tr><td>' + esc(r.nome) + '</td><td class="num">' + (r.salario ? cheio(r.salario) : '<span class="pill nao">sem salário</span>') + '</td><td class="num">' + r.membros + '</td>'
              + (D.pode_propor ? '<td class="num"><button class="btn sec mini" data-propor-rank="' + r.id + '">Propor</button></td>' : '') + '</tr>';
          }).join('') + '</tbody></table></div></details>';
    }).join('') : '<p class="expl">Nenhuma corporação com cargos nesta cidade.</p>';
    // [24/10] repasse semanal de cada corporação (o "fundo que cai nas corporações")
    var RP = CS.filter(function (c) { return c.repasse; });
    $('rep-sub').textContent = RP.length ? 'total ' + cheio(RP.reduce(function (t, c) { return t + c.repasse.atual; }, 0)) + ' por semana' : '';
    $('repasses').innerHTML = RP.length ? RP.map(function (c) {
      return '<tr><td><b>' + esc(c.nome) + '</b>' + (c.repasse.definido ? ' <span class="pill sim">definido pelo Governo</span>' : '') + '</td>'
        + '<td class="num">' + (c.repasse.atual ? cheio(c.repasse.atual) : '<span class="pill nao">sem repasse</span>')
        + (D.eh_dono ? '<br><button class="btn sec mini" data-repasse="' + c.id + '">Mudar</button>' : '')
        + (D.pode_propor ? ' <button class="btn sec mini" data-propor-rep="' + c.id + '">Propor</button>' : '') + '</td>'
        + '<td class="num">' + cheio(c.repasse.padrao) + '</td></tr>';
    }).join('') : '<tr><td colspan="3" class="expl">Nenhuma corporação recebe repasse nesta cidade.</td></tr>';
    $('repasses').querySelectorAll('[data-propor-rep]').forEach(function (b) { b.onclick = function () { irPropor({ tipo: 'repasse_corp', corp_id: Number(b.dataset.proporRep) }); }; });
    $('repasses').querySelectorAll('[data-repasse]').forEach(function (b) { b.onclick = function () { editarRepasse(Number(b.dataset.repasse)); }; });
    $('corps-sal').querySelectorAll('[data-propor-rank]').forEach(function (b) { b.onclick = function () { irPropor({ tipo: 'salario_corp', rank_id: Number(b.dataset.proporRank) }); }; });
    $('empregos').querySelectorAll('[data-teto]').forEach(function (b) { b.onclick = function () { editarTeto(b.dataset.teto); }; });
    var ST = { pago: ['sim', 'Pago'], nao_entrou: ['nao', 'Não entrou no jogo'], sem_saldo: ['alerta', 'Caixa sem saldo'], sem_roblox: ['alerta', 'Sem Roblox vinculado'] };
    $('pagos').innerHTML = s.ultimos.length ? s.ultimos.map(function (p) { var t = ST[p.status] || ['nao', p.status];
      return '<tr><td>' + (p.periodo + 1) + 'º</td><td>' + esc(p.nome || '?') + '</td><td>' + esc(p.cargo || '') + '</td><td class="num">' + cheio(p.valor) + '</td><td><span class="pill ' + t[0] + '">' + t[1] + '</span></td></tr>';
    }).join('') : '<tr><td colspan="5" class="expl">Nenhum pagamento ainda. O primeiro sai quando o primeiro período de 3 dias fechar.</td></tr>';
    if ($('link-cargos')) $('link-cargos').href = '/dashboard/corp/' + D.corporation_id;

    var TIPO = { obra: 'Obra', salario: 'Salário', salario_emprego: 'Emprego civil' };
    $('extrato').innerHTML = D.extrato.length ? D.extrato.map(function (l) {
      var det = l.detalhe || {};
      var txt = l.tipo === 'obra' ? (det.descricao || '') + ' <span class="expl">(' + esc(l.por || '') + ')</span>' : l.tipo === 'salario' ? esc((l.quem || '') + ' · ' + (det.cargo || '')) : esc(l.quem || '');
      return '<tr><td>' + data(l.criado_em) + '</td><td>' + esc(TIPO[l.tipo] || l.tipo) + (l.tipo === 'obra' ? ': ' + esc(det.obra || l.quem) : '') + '</td><td>' + (l.tipo === 'obra' ? esc(det.descricao || '') + ' <span style="color:var(--tinta-3)">· ' + esc(l.por || '') + '</span>' : txt) + '</td>'
        + '<td class="num ' + (l.valor < 0 ? 'menos' : 'mais') + '" title="' + esc(cheio(l.valor)) + '">' + esc(curto(l.valor)) + '</td><td class="num">' + esc(curto(l.saldo_depois)) + '</td></tr>';
    }).join('') : '<tr><td colspan="5" class="expl">Nenhuma saída ainda.</td></tr>';
  }
  function abrir(chave) {
    obraSel = D.obras.find(function (o) { return o.chave === chave; }); if (!obraSel) return;
    $('m-t').textContent = obraSel.nome;
    $('m-v').innerHTML = 'Sai <b>' + esc(cheio(obraSel.valor)) + '</b> do caixa. Fica ' + esc(curto(D.saldo - obraSel.valor)) + '.';
    $('m-desc').value = ''; $('fundo').classList.add('on'); $('m-desc').focus();
  }
  function fechar() { $('fundo').classList.remove('on'); obraSel = null; }
  $('m-nao').onclick = fechar;
  $('fundo').addEventListener('click', function (e) { if (e.target === $('fundo')) fechar(); });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') fechar(); });
  async function enviar(met, url, body) {
    var r = await fetch(url, { method: met, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
    var j = await r.json().catch(function () { return {}; });
    if (!r.ok) throw new Error(j.error || 'Erro'); return j;
  }
  $('m-sim').onclick = async function () {
    if (!obraSel) return;
    var b = $('m-sim'); b.disabled = true;
    try { var j = await enviar('POST', '/api/governo/obra', { obra: obraSel.chave, descricao: $('m-desc').value }); fechar(); toast('Retirado: ' + j.obra); await carregar(); }
    catch (e) { toast(e.message, true); }
    b.disabled = false;
  };
  async function editarValor(chave) {
    var o = D.obras.find(function (x) { return x.chave === chave; });
    var v = prompt('Novo valor de "' + o.nome + '" (só números):', String(o.valor)); if (v == null) return;
    try { await enviar('PUT', '/api/governo/obras/' + chave, { valor: Number(String(v).replace(/\D/g, '')) }); toast('Valor salvo'); carregar(); } catch (e) { toast(e.message, true); }
  }
  async function editarRepasse(id) {
    var c = (D.corporacoes || []).find(function (x) { return x.id === id; }); if (!c || !c.repasse) return;
    var v = prompt('Repasse semanal de "' + c.nome + '" (R$). Padrão: ' + c.repasse.padrao, c.repasse.atual); if (v === null) return;
    try { await enviar('PUT', '/api/governo/repasse/' + id, { valor: Number(String(v).replace(/\D/g, '')) }); toast('Repasse salvo: vale a partir do próximo'); carregar(); } catch (er) { toast(er.message, true); }
  }
  async function editarTeto(emp) {
    var e = (D.empregos || []).find(function (x) { return x.emprego === emp; }); if (!e) return;
    var v = prompt('Teto por tarefa de "' + e.nome + '" (R$):', e.teto); if (v === null) return;
    try { await enviar('PUT', '/api/governo/empregos/' + encodeURIComponent(emp), { teto: Number(String(v).replace(/\D/g, '')) }); toast('Teto salvo'); carregar(); } catch (er) { toast(er.message, true); }
  }
  if ($('cfg-salvar')) $('cfg-salvar').onclick = async function () {
    try { await enviar('PUT', '/api/governo/config', { multiplicador: Number($('cfg-mult').value) }); toast('Multiplicador salvo: vale pras próximas compras'); carregar(); } catch (e) { toast(e.message, true); }
  };

  // ---------------------------------------------------------------- CÂMARA [23/10]
  var CAM = null;
  var PROPOR = null;   // [24/10] o "Propor" da aba Salários abre a Câmara já com o cargo escolhido
  function irPropor(o) {
    PROPOR = o;
    var b = document.querySelector('.abas button[data-aba="camara"]'); if (b) b.click();
  }
  var PILL = { debate: 'nao', votacao: 'alerta', aguardando_sancao: 'alerta', sancionada: 'sim', aguarda_mandato: 'sim', vetada: 'alerta', veto_mantido: 'nao', recusada: 'nao', sem_saldo: 'alerta' };
  async function carregarCamara() {
    var r = await fetch('/api/governo/camara', { headers: { accept: 'application/json' } });
    var j = await r.json().catch(function () { return {}; });
    if (!r.ok) { $('cam-lista').innerHTML = '<p class="expl">' + esc(j.error || 'Erro') + '</p>'; return; }
    CAM = j; desenharCamara();
  }
  function quando(t) { return t ? data(t) : '—'; }
  function desenharCamara() {
    var eu = CAM.meu_cargo;
    $('cam-sub').textContent = CAM.parlamentares + ' parlamentar(es)' + (eu ? ' · você: ' + eu : '');
    var podeAbrir = !!CAM.pode_abrir;
    var optCorp = (CAM.corporacoes || []).map(function (c) {
      return '<optgroup label="' + esc(c.nome) + '">' + c.cargos.map(function (r) {
        return '<option value="' + r.id + '">' + esc(r.nome) + ' (hoje ' + cheio(r.salario) + ', teto ' + cheio(r.teto) + ')</option>'; }).join('') + '</optgroup>'; }).join('');
    var optRep = (CAM.repasses || []).map(function (c) {
      return '<option value="' + c.id + '">' + esc(c.nome) + ' (hoje ' + cheio(c.atual) + ', teto ' + cheio(c.teto) + ')</option>'; }).join('');
    var optEmp = (CAM.empregos || []).map(function (e) {
      return '<option value="' + esc(e.emprego) + '">' + esc(e.nome) + ' (hoje ' + cheio(e.teto) + ', teto ' + cheio(e.teto_max) + ')</option>'; }).join('');
    $('cam-form').innerHTML = podeAbrir ? (
      '<div class="camf">'
      + '<label>Tipo<select id="cf-tipo"><option value="salario">Salário de cargo do Governo</option><option value="salario_corp">Salário de cargo de corporação</option><option value="emprego">Teto de emprego civil</option><option value="repasse_corp">Repasse semanal de corporação</option><option value="obra">Aprovar obra</option></select></label>'
      + '<label data-cf="salario">Cargo do Governo<select id="cf-cargo">' + CAM.cargos.filter(function (c) { return c.teto; }).map(function (c) {
          return '<option value="' + c.id + '">' + esc(c.nome) + ' (hoje ' + cheio(c.salario) + ', teto ' + cheio(c.teto) + ')</option>'; }).join('') + '</select></label>'
      + '<label data-cf="salario_corp" hidden>Cargo da corporação<select id="cf-rank">' + optCorp + '</select></label>'
      + '<label data-cf="emprego" hidden>Emprego civil<select id="cf-emp">' + optEmp + '</select></label>'
      + '<label data-cf="repasse_corp" hidden>Corporação<select id="cf-corp">' + optRep + '</select></label>'
      + '<label data-cf="salario salario_corp emprego repasse_corp" id="cf-l-valor"><span id="cf-l-valor-t">Novo salário a cada 3 dias (R$)</span><input id="cf-valor" inputmode="numeric" placeholder="só números"></label>'
      + '<label data-cf="obra" hidden>Obra<select id="cf-obra">' + (D && D.obras ? D.obras.map(function (o) { return '<option value="' + esc(o.chave) + '">' + esc(o.nome) + ' (' + cheio(o.valor) + ')</option>'; }).join('') : '') + '</select></label>'
      + '<label class="tudo">Justificativa<textarea id="cf-desc" rows="2" maxlength="500" placeholder="O que a proposta muda e por quê"></textarea></label>'
      + '<div><button class="btn" id="cf-abrir">Abrir proposta</button></div></div>'
    ) : '<p class="expl" style="margin:0">Só Parlamentar, o Presidente da Câmara e o Presidente da República abrem proposta. Votam os Parlamentares.</p>';
    if (podeAbrir) {
      var VALOR_T = { salario: 'Novo salário a cada 3 dias (R$)', salario_corp: 'Novo salário por 40 min (R$)', emprego: 'Novo teto por tarefa (R$)', repasse_corp: 'Novo repasse por semana (R$)' };
      $('cf-tipo').onchange = function () {
        var t = this.value;
        document.querySelectorAll('#cam-form [data-cf]').forEach(function (l) { l.hidden = l.dataset.cf.split(' ').indexOf(t) < 0; });
        if (VALOR_T[t]) $('cf-l-valor-t').textContent = VALOR_T[t];
      };
      if (PROPOR) {
        $('cf-tipo').value = PROPOR.tipo; $('cf-tipo').onchange.call($('cf-tipo'));
        if (PROPOR.rank_id) $('cf-rank').value = String(PROPOR.rank_id);
        if (PROPOR.emprego) $('cf-emp').value = PROPOR.emprego;
        if (PROPOR.corp_id) $('cf-corp').value = String(PROPOR.corp_id);
        PROPOR = null; $('cf-valor').focus();
      }
      $('cf-abrir').onclick = async function () {
        var tipo = $('cf-tipo').value, corpo = { tipo: tipo, descricao: $('cf-desc').value };
        var val = Number(String($('cf-valor').value).replace(/\D/g, ''));
        if (tipo === 'obra') corpo.obra = $('cf-obra').value;
        else if (tipo === 'salario') { corpo.rank_id = Number($('cf-cargo').value); corpo.valor = val; }
        else if (tipo === 'salario_corp') { corpo.rank_id = Number($('cf-rank').value); corpo.valor = val; }
        else if (tipo === 'emprego') { corpo.emprego = $('cf-emp').value; corpo.valor = val; }
        else if (tipo === 'repasse_corp') { corpo.corp_id = Number($('cf-corp').value); corpo.valor = val; }
        try { var j = await enviar('POST', '/api/governo/camara', corpo); toast('Proposta nº ' + j.id + ' aberta: 48 h de debate'); carregarCamara(); } catch (e) { toast(e.message, true); }
      };
    }
    $('cam-lista').innerHTML = CAM.propostas.length ? CAM.propostas.map(function (p) {
      var mud = p.tipo === 'salario'
        ? 'Salário de <b>' + esc(p.cargo) + '</b>: ' + cheio(p.valor_atual) + ' → <b>' + cheio(p.valor) + '</b> a cada 3 dias'
        : p.tipo === 'salario_corp'
        ? 'Salário de <b>' + esc(p.cargo) + '</b>: ' + cheio(p.valor_atual) + ' → <b>' + cheio(p.valor) + '</b> por 40 min'
        : p.tipo === 'repasse_corp'
        ? 'Repasse semanal de <b>' + esc(p.cargo) + '</b>: ' + cheio(p.valor_atual) + ' → <b>' + cheio(p.valor) + '</b> por semana'
        : p.tipo === 'emprego'
        ? 'Teto de <b>' + esc(p.cargo) + '</b>: ' + cheio(p.valor_atual) + ' → <b>' + cheio(p.valor) + '</b> por tarefa'
        : 'Obra <b>' + esc(p.cargo) + '</b>: ' + cheio(p.valor) + ' do tesouro';
      var prazo = p.status === 'debate' ? 'votação abre ' + quando(p.votacao_em)
        : p.status === 'votacao' ? 'votação fecha ' + quando(p.fecha_em)
        : p.status === 'aguardando_sancao' ? 'sanção até ' + quando(p.sancao_ate)
        : p.status === 'vetada' ? 'Câmara pode derrubar até ' + quando(p.derrubada_ate)
        : (p.decidida_em ? 'decidida ' + quando(p.decidida_em) : '');
      var vs = p.votos.filter(function (v) { return v.fase !== 'desempate'; }).map(function (v) {
        return '<span class="pill ' + (v.voto ? 'sim' : 'nao') + '">' + (v.fase === 'derrubada' ? 'derrubada · ' : '') + esc(v.nome) + ': ' + (v.voto ? 'SIM' : 'NÃO') + '</span>'; }).join('');
      var dsp = p.votos.find(function (v) { return v.fase === 'desempate'; });
      var ac = '';
      if (CAM.meu_cargo === 'Parlamentar' && (p.status === 'votacao' || p.status === 'vetada') && !p.ja_votei)
        ac += '<button class="btn" data-voto="sim" data-id="' + p.id + '">' + (p.status === 'vetada' ? 'Derrubar o veto' : 'Votar SIM') + '</button><button class="btn sec" data-voto="nao" data-id="' + p.id + '">' + (p.status === 'vetada' ? 'Manter o veto' : 'Votar NÃO') + '</button>';
      if (CAM.meu_cargo === 'Presidente da Câmara' && p.status === 'votacao' && !p.ja_desempatei)
        ac += '<button class="btn sec" data-desempate="sim" data-id="' + p.id + '">Desempate: SIM</button><button class="btn sec" data-desempate="nao" data-id="' + p.id + '">Desempate: NÃO</button>';
      if (CAM.meu_cargo === 'Presidente da República' && p.status === 'aguardando_sancao')
        ac += '<button class="btn" data-sancao="sancionar" data-id="' + p.id + '">Sancionar</button><button class="btn sec" data-sancao="vetar" data-id="' + p.id + '">Vetar</button>';
      return '<div class="prop"><div class="prop-top"><b class="n">Nº ' + p.id + '</b><span class="pill ' + (PILL[p.status] || 'nao') + '">' + esc(p.status_nome) + '</span><small class="expl">' + esc(prazo) + '</small></div>'
        + '<div class="mud">' + mud + '</div>'
        + '<div class="expl">' + esc(p.descricao) + ' · aberta por ' + esc(p.autor_nome || '?') + ' em ' + quando(p.criada_em) + '</div>'
        + '<div class="expl" style="margin-top:.35rem">Placar: <b>' + p.placar.sim + ' SIM</b> × <b>' + p.placar.nao + ' NÃO</b>'
        + (dsp ? ' · desempate do Presidente da Câmara: ' + (dsp.voto ? 'SIM' : 'NÃO') : '')
        + (p.placar_derrubada.sim + p.placar_derrubada.nao ? ' · derrubada do veto: ' + p.placar_derrubada.sim + ' × ' + p.placar_derrubada.nao : '')
        + (p.sancao ? ' · sanção: ' + esc({ sancionou: 'sancionada', vetou: 'vetada', automatica: 'automática (24 h)', derrubada: 'veto derrubado' }[p.sancao] || p.sancao) + (p.sancao_por ? ' (' + esc(p.sancao_por) + ')' : '') : '')
        + (p.nota ? ' · ' + esc(p.nota) : '') + '</div>'
        + (vs ? '<div class="votos">' + vs + '</div>' : '')
        + (ac ? '<div class="acoes">' + ac + '</div>' : '') + '</div>';
    }).join('') : '<div class="bloco"><p class="expl" style="margin:0">Nenhuma proposta ainda.</p></div>';
    $('cam-lista').querySelectorAll('[data-voto]').forEach(function (b) { b.onclick = function () { acao('/voto', b.dataset.id, { voto: b.dataset.voto }, 'Voto registrado'); }; });
    $('cam-lista').querySelectorAll('[data-desempate]').forEach(function (b) { b.onclick = function () { acao('/voto', b.dataset.id, { voto: b.dataset.desempate, desempate: true }, 'Desempate registrado'); }; });
    $('cam-lista').querySelectorAll('[data-sancao]').forEach(function (b) { b.onclick = function () {
      if (!confirm(b.dataset.sancao === 'vetar' ? 'Vetar a proposta nº ' + b.dataset.id + '?' : 'Sancionar a proposta nº ' + b.dataset.id + '? A mudança entra na hora.')) return;
      acao('/sancao', b.dataset.id, { acao: b.dataset.sancao }, b.dataset.sancao === 'vetar' ? 'Vetada' : 'Sancionada'); }; });
  }
  async function acao(rota, id, corpo, ok) {
    try { await enviar('POST', '/api/governo/camara/' + id + rota, corpo); toast(ok); carregarCamara(); carregar(); } catch (e) { toast(e.message, true); }
  }
  document.querySelectorAll('.abas button').forEach(function (b) {
    b.onclick = function () {
      document.querySelectorAll('.abas button').forEach(function (x) { x.classList.toggle('on', x === b); });
      document.querySelectorAll('[data-painel]').forEach(function (p) { p.hidden = p.dataset.painel !== b.dataset.aba; });
      if (b.dataset.aba === 'camara') carregarCamara();
    };
  });
  carregar();
})();
</script>
</body>
</html>
