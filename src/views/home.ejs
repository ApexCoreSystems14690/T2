<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Santa Fé — Corporações</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background: #0a0e17; color: #f0f4f8; min-height: 100vh; display: flex; align-items: center; justify-content: center; }
    .container { text-align: center; padding: 2rem; }
    h1 { font-size: 2.5rem; font-weight: 800; letter-spacing: 0.04em; color: #00d4ff; margin-bottom: 0.5rem; }
    .subtitle { color: #7a8ba5; font-size: 1rem; margin-bottom: 2rem; }
    .btn { display: inline-block; padding: 0.75rem 2rem; background: #5865F2; color: white; text-decoration: none; border-radius: 6px; font-weight: 600; font-size: 0.95rem; transition: opacity 0.15s; }
    .btn:hover { opacity: 0.85; }
    .user-info { margin-top: 1.5rem; }
    .user-info a { color: #00d4ff; text-decoration: none; margin: 0 0.5rem; }
    .opcoes { display: flex; gap: 1rem; justify-content: center; margin: 1.5rem 0 1rem; flex-wrap: wrap; }
    .card { width: 240px; background: #131a2b; border: 1px solid #1e2a40; border-radius: 10px; padding: 1.25rem 1rem; text-decoration: none; color: #f0f4f8; text-align: left; transition: border-color .15s, transform .15s; }
    .card:hover { border-color: #00d4ff; transform: translateY(-2px); }
    .card .ic { font-size: 1.4rem; margin-bottom: .5rem; }
    .card .t { font-weight: 700; font-size: .95rem; }
    .card .d { color: #7a8ba5; font-size: .78rem; margin-top: .25rem; line-height: 1.35; }
    .card.adm { border-color: #ef444455; }
    .card.adm:hover { border-color: #ef4444; }
    .card.adm .t { color: #ef4444; }
    .card.off { opacity: .45; pointer-events: none; }
  </style>
</head>
<body>
  <div class="container">
    <h1>SANTA FÉ</h1>
    <p class="subtitle">Sistema de Corporações</p>
    <% if (!user) { %>
      <a href="/auth/discord" class="btn">Entrar com Discord</a>
    <% } else { %>
      <div class="user-info">
        <p>Olá, <strong><%= user.discord_username %></strong></p>
      </div>
      <div class="opcoes">
        <a class="card" href="/dashboard">
          <div class="ic">🏛️</div>
          <div class="t">Painel de Corporações</div>
          <div class="d">Cargos, membros e configurações das corporações que você gerencia.</div>
        </a>
        <% if (user.is_admin) { %>
        <a class="card adm" href="/admin">
          <div class="ic">🛡️</div>
          <div class="t">Painel Admin</div>
          <div class="d">Controle total do servidor: jogadores, dinheiro, itens, teleporte, logs, hora e banimentos.</div>
        </a>
        <% } else { %>
        <div class="card adm off" title="Somente administradores">
          <div class="ic">🛡️</div>
          <div class="t">Painel Admin</div>
          <div class="d">Somente administradores.</div>
        </div>
        <% } %>
      </div>
      <div class="user-info"><a href="/auth/logout">Sair</a></div>
    <% } %>
  </div>
</body>
</html>
