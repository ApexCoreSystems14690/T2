<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= cidade ? cidade.nome : 'Santa Fé' %> — Sistema da cidade</title>
  <meta name="theme-color" content="#1C2127">
  <style>
    body { margin: 0; min-height: 100vh; }
    .faixa-topo { height: 6px; background: var(--placa); }
    .casa { max-width: 760px; margin: 0 auto; padding: 4.5rem 1.25rem 3rem; }
    /* a placa grande: a única peça "alta" do site inteiro */
    .placa-grande { display: inline-flex; flex-direction: column; background: #fff; border: 3px solid #10131A; border-radius: 10px; overflow: hidden; box-shadow: 0 2px 0 #10131A, 0 14px 30px rgba(22,26,31,.16); }
    .placa-grande .faixa { background: var(--placa); color: #fff; display: flex; justify-content: space-between; align-items: center; padding: 6px 14px; font-size: 12px; font-weight: 700; letter-spacing: .2em; }
    .placa-grande .bandeirinha { width: 18px; height: 12px; border-radius: 2px; background: linear-gradient(#1D7A45 0 50%, #F2B705 50% 100%); }
    .placa-grande .chars { font-stretch: 75%; font-variation-settings: "wdth" 75; font-weight: 800; color: #10131A; font-size: clamp(48px, 11vw, 84px); letter-spacing: .06em; line-height: 1; padding: 10px 26px 12px; }
    h1 { font-size: clamp(2rem, 5.2vw, 3.1rem); line-height: 1.02; margin: 2.2rem 0 .8rem; color: var(--asfalto); max-width: 16ch; }
    .lede { color: var(--tinta-2); font-size: 1.05rem; max-width: 52ch; margin: 0 0 2rem; }
    .entrar { min-height: 46px !important; padding: .6rem 1.2rem !important; font-size: .98rem !important; background: #5865F2 !important; border-color: #5865F2 !important; }
    .entrar:hover { background: #4752C4 !important; }
    .entrar .ic { width: 1.3em; height: 1.3em; }
    .quem { display: flex; align-items: center; gap: .8rem; flex-wrap: wrap; color: var(--tinta-2); font-size: .92rem; margin: 0 0 1.1rem; }
    .quem strong { color: var(--tinta); }
    .quem a { color: var(--tinta-2); text-decoration: none; display: inline-flex; align-items: center; gap: .3rem; }
    .quem a.trocar { margin-left: auto; }
    .quem a.trocar:hover { color: var(--placa); }
    .quem a.sair:hover { color: var(--perigo); }
    .lista { background: var(--papel); border: 1px solid var(--linha); border-radius: var(--r); overflow: hidden; }
    .item { display: grid; grid-template-columns: 44px 1fr; gap: .2rem 1rem; align-items: center; padding: 1rem 1.1rem; text-decoration: none; color: var(--tinta); border-top: 1px solid var(--linha); }
    .item:first-child { border-top: 0; }
    a.item:hover { background: var(--papel-2); }
    a.item:hover .t { color: var(--placa); }
    .item .selo { grid-row: span 2; width: 44px; height: 44px; border-radius: var(--rs); display: grid; place-items: center; color: #fff; }
    .item .selo .ic { width: 22px; height: 22px; margin: 0; }
    .item .t { font-weight: 700; font-size: 1.02rem; }
    .item .d { color: var(--tinta-3); font-size: .88rem; line-height: 1.4; }
    .corp .selo { background: var(--placa); }
    .emp .selo { background: var(--ok); }
    .fac .selo { background: var(--faccao); }
    .adm .selo { background: var(--asfalto); }
    .tudo .selo { background: var(--alerta); }
    .elei .selo { background: var(--asfalto-2); }
    .regra .selo { background: #10131A; color: var(--pista); }
    .roy .selo { background: var(--placa); }
    .gov .selo { background: #10131A; color: #fff; }
    .saldo-roy { display: inline-block; margin-left: .35rem; padding: .05rem .45rem; border: 1.5px solid #10131A; border-radius: 4px; background: #fff; font-stretch: 75%; font-variation-settings: "wdth" 75; font-weight: 800; font-size: .95rem; color: #10131A; vertical-align: 1px; }
    .item.off { color: var(--tinta-3); }
    .item.off .selo { background: var(--linha-2); }
    .rodape { margin-top: 2.5rem; color: var(--tinta-3); font-size: .82rem; }
    @media (max-width: 560px) { .casa { padding-top: 2.5rem; } }
  </style>
  <link rel="stylesheet" href="/sf.css">
</head>
<body>
  <div class="faixa-topo"></div>
  <main class="casa">
    <div class="placa-grande" aria-label="Placa Santa Fé RP">
      <div class="faixa"><span><%= cidade ? String(cidade.nome).toUpperCase() : 'SANTA FÉ' %></span><span class="bandeirinha"></span></div>
      <div class="chars"><%= cidade ? String(cidade.sigla || 'SFE').toUpperCase() : 'SFE' %>·RP</div>
    </div>

    <h1>Sistema da cidade de <%= cidade ? cidade.nome : 'Santa Fé' %></h1>
    <% if (!user) { %>
      <p class="lede">Cargos, membros, caixa e salários das corporações, facções e empresas do Santa Fé RP. Entre com a mesma conta do Discord do servidor.</p>
      <a href="/auth/discord" class="btn entrar"><svg class="ic" aria-hidden="true"><use href="/icones.svg#discord"/></svg>Entrar com Discord</a>
      <% if (cidade) { %><p style="margin-top:1rem"><a href="/cidade/<%= cidade.slug %>/regras">Ler as regras da cidade</a></p><% } %>
    <% } else { %>
      <p class="lede">Escolha o que você vai gerenciar hoje.</p>
      <div class="quem">
        <span>Conectado como <strong><%= user.discord_username %></strong></span>
        <%# [21/10 Cidades] tudo nesta tela é da cidade escolhida %>
        <a href="/" class="trocar"><svg class="ic" aria-hidden="true"><use href="/icones.svg#voltar"/></svg>Trocar de cidade</a>
        <a href="/auth/logout" class="sair"><svg class="ic" aria-hidden="true"><use href="/icones.svg#sair"/></svg>Sair</a>
      </div>
      <nav class="lista" aria-label="Painéis">
        <a class="item corp" href="/dashboard">
          <span class="selo"><svg class="ic" aria-hidden="true"><use href="/icones.svg#predio"/></svg></span>
          <span class="t">Corporações</span>
          <span class="d">Cargos, membros, caixa e configurações das corporações que você faz parte ou gerencia.</span>
        </a>
        <%# [30/09, pedido do Julio] Empresas Oficiais (tipo = 'empresa') %>
        <a class="item emp" href="/empresas">
          <span class="selo"><svg class="ic" aria-hidden="true"><use href="/icones.svg#loja"/></svg></span>
          <span class="t">Empresas oficiais</span>
          <span class="d">Caixa, estoque, cargos e CNPJ. Empresa não recebe repasse do governo.</span>
        </a>
        <%# [20/09] faccoes (corporations com tipo = 'faccao') %>
        <a class="item fac" href="/faccoes">
          <span class="selo"><svg class="ic" aria-hidden="true"><use href="/icones.svg#bandeira"/></svg></span>
          <span class="t">Facções</span>
          <span class="d">Cargos, membros e salários das facções.</span>
        </a>
        <%# [23/10] Loja de Royalties: saldo da pessoa nesta cidade %>
        <a class="item roy" href="/royalties">
          <span class="selo"><svg class="ic" aria-hidden="true"><use href="/icones.svg#moedas"/></svg></span>
          <span class="t">Royalties<% if (typeof royalties !== 'undefined' && royalties !== null) { %> <span class="saldo-roy"><%= Number(royalties).toLocaleString('pt-BR') %></span><% } %></span>
          <span class="d">Pontos que a staff credita pelo que você faz na cidade. Troque por prêmios dentro do jogo.</span>
        </a>
        <%# [23/10] Governo: tesouro, obras e salários (membros do Governo, staff e Dono) %>
        <% if (typeof verGoverno !== 'undefined' && verGoverno) { %>
        <a class="item gov" href="/governo">
          <span class="selo"><svg class="ic" aria-hidden="true"><use href="/icones.svg#banco"/></svg></span>
          <span class="t">Governo</span>
          <span class="d">Tesouro da cidade: arrecadação, obras aprovadas e salário do Governo.</span>
        </a>
        <% } %>
        <%# [22/10] regulamento DESTA cidade %>
        <% if (cidade) { %>
        <a class="item regra" href="/cidade/<%= cidade.slug %>/regras">
          <span class="selo"><svg class="ic" aria-hidden="true"><use href="/icones.svg#livro"/></svg></span>
          <span class="t">Regras da cidade</span>
          <span class="d">Os regulamentos de <%= cidade.nome %>, com busca e link direto pra cada artigo.</span>
        </a>
        <% } %>
        <%# [14/10] eleicao: qualquer um logado ve a apuracao %>
        <a class="item elei" href="/apuracao">
          <span class="selo"><svg class="ic" aria-hidden="true"><use href="/icones.svg#urna"/></svg></span>
          <span class="t">Apuração</span>
          <span class="d">Resultado da eleição de Santa Fé, zona por zona, com presidência e parlamento.</span>
        </a>
        <%# [30/09, pedido do Julio] atalho de todas as organizacoes, so Diretor Geral pra cima %>
        <% if (typeof ehDiretor !== 'undefined' && ehDiretor) { %>
        <a class="item tudo" href="/organizacoes">
          <span class="selo"><svg class="ic" aria-hidden="true"><use href="/icones.svg#pasta"/></svg></span>
          <span class="t">Todas as organizações</span>
          <span class="d">Corporações, facções e empresas numa lista só, com dono, membros e caixa.</span>
        </a>
        <% } %>
        <%# [25/10] Rede: senha, place e dono de cada cidade (só a conta da plataforma) %>
        <% if (typeof plataforma !== 'undefined' && plataforma) { %>
        <a class="item adm" href="/rede">
          <span class="selo"><svg class="ic" aria-hidden="true"><use href="/icones.svg#escudo"/></svg></span>
          <span class="t">Rede de cidades</span>
          <span class="d">Dono, senha de entrada e place do Roblox de cada cidade. Só a sua conta vê.</span>
        </a>
        <% } %>
        <% if (user.is_admin) { %>
        <a class="item adm" href="/admin">
          <span class="selo"><svg class="ic" aria-hidden="true"><use href="/icones.svg#escudo"/></svg></span>
          <span class="t">Painel admin</span>
          <span class="d">Jogadores, dinheiro, itens, teleporte, logs, horário do servidor, banimentos e segurança.</span>
        </a>
        <% } else { %>
        <div class="item adm off" title="Somente administradores">
          <span class="selo"><svg class="ic" aria-hidden="true"><use href="/icones.svg#cadeado"/></svg></span>
          <span class="t">Painel admin</span>
          <span class="d">Só para a staff do servidor.</span>
        </div>
        <% } %>
      </nav>
      <% if (!user.roblox_id) { %>
      <p class="rodape">Sua conta Roblox ainda não está vinculada. <a href="/dashboard/link-roblox">Vincular agora</a></p>
      <% } %>
    <% } %>
  </main>
</body>
</html>
