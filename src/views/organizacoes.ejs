<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Todas as Organizações — Santa Fé</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: var(--sans); background: #E7E9EC; color: #161A1F; min-height: 100vh; }
    .topbar { background: #FFFFFF; border-bottom: 1px solid #D6DADF; padding: 0.75rem 1.5rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem; }
    .topbar h1 { font-size: 1rem; color: #A86400;  }
    .topbar .user { display: flex; align-items: center; gap: 0.75rem; font-size: 0.85rem; color: #5B6573; flex-wrap: wrap; }
    .topbar a { color: #5B6573; text-decoration: none; font-size: 0.8rem; }
    .topbar a:hover { color: #A86400; }
    .main { max-width: 1040px; margin: 0 auto; padding: 2rem 1.25rem; }
    .nota { background: #D6DADF; border: 1px solid #C1C7CF; border-left: 3px solid #A86400; border-radius: 6px; padding: 0.9rem 1rem; margin-bottom: 1.25rem; font-size: 0.82rem; color: #46505C; line-height: 1.5; }
    .resumo { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 1.25rem; }
    .pill { background: #FFFFFF; border: 1px solid #D6DADF; border-radius: 8px; padding: 0.35rem 0.85rem; font-size: 0.78rem; color: #46505C; }
    .pill strong { color: #161A1F; }
    .ferramentas { display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: center; margin-bottom: 1rem; }
    .ferramentas input { flex: 1; min-width: 180px; background: #E7E9EC; border: 1px solid #C1C7CF; border-radius: 6px; padding: 0.5rem 0.7rem; color: #161A1F; font-size: 0.85rem; }
    .ferramentas button { background: none; border: 1px solid #C1C7CF; color: #5B6573; padding: 0.45rem 0.8rem; border-radius: 6px; font-size: 0.78rem; cursor: pointer; }
    .ferramentas button.on { border-color: #A86400; color: #A86400; }
    table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
    thead th { text-align: left; color: #5B6573; font-size: 0.72rem;  padding: 0.5rem 0.6rem; border-bottom: 1px solid #D6DADF; white-space: nowrap; }
    tbody tr { border-bottom: 1px solid #E6E9ED; }
    tbody tr:hover { background: #F7F8FA; }
    td { padding: 0.65rem 0.6rem; vertical-align: middle; }
    .nome { display: flex; align-items: center; gap: 0.6rem; font-weight: 600; }
    .bolinha { width: 11px; height: 11px; border-radius: 3px; flex-shrink: 0; }
    .ico { width: 26px; height: 26px; border-radius: 5px; object-fit: cover; background: #E7E9EC; flex-shrink: 0; }
    .sub { color: #6B7480; font-size: 0.78rem; font-stretch: 75%; font-variation-settings: "wdth" 75; font-weight: 600; }
    .tag { font-size: 0.7rem; padding: 0.15rem 0.5rem; border-radius: 8px; font-weight: 700;  white-space: nowrap; }
    .t-empresa { background: #1D7A4522; color: #1D7A45; }
    .t-corp    { background: #2F5BBF22; color: #2F5BBF; }
    .t-faccao  { background: #B2322722; color: #B23227; }
    .btn { color: #A86400; text-decoration: none; font-size: 0.78rem; font-weight: 600; padding: 0.32rem 0.7rem; border: 1px solid #A8640033; border-radius: 4px; white-space: nowrap; }
    .btn:hover { background: #A8640011; }
    .vazio { color: #5B6573; text-align: center; padding: 2rem; font-size: 0.9rem; }
    .num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
    @media (max-width: 720px) { .esconde-mob { display: none; } }
  </style>
  <link rel="stylesheet" href="/sf.css">
  <script src="/sf.js"></script>

</head>
<body>
  <div class="topbar">
    <div style="display:flex;align-items:center;gap:1rem">
      <%- include('partials/placa') %>
      <h1>Todas as organizações</h1>
    </div>
    <div class="user">
      <a href="/dashboard">Corporações</a>
      <a href="/faccoes">Facções</a>
      <a href="/empresas">Empresas</a>
      <a href="/admin">Painel Admin</a>
      <span><%= user.discord_username %> · <%= cargo %></span>
      <a href="/auth/logout">Sair</a>
    </div>
  </div>

  <div class="main">
    <div class="nota">
      Lista completa: corporações, facções e empresas juntas, sem filtro de participação.
      <strong>Gerenciar</strong> abre a mesma tela de sempre, e como você é
      <strong>Diretor Geral ou Dono</strong> entra nela sem teto — dá pra trocar cargo,
      entrar, sair e mexer em qualquer uma. Página restrita ao Diretor pra cima.
    </div>

    <div class="resumo">
      <span class="pill"><strong><%= resumo.total %></strong> no total</span>
      <span class="pill"><strong><%= resumo.empresa %></strong> empresas</span>
      <span class="pill"><strong><%= resumo.corp %></strong> corporações</span>
      <span class="pill"><strong><%= resumo.faccao %></strong> facções</span>
    </div>

    <div class="ferramentas">
      <input id="busca" placeholder="buscar por nome, slug, dono ou CNPJ..." oninput="filtrar()">
      <button class="on" data-t="" onclick="tipo(this,'')">Tudo</button>
      <button data-t="empresa" onclick="tipo(this,'empresa')">Empresas</button>
      <button data-t="corp" onclick="tipo(this,'corp')">Corporações</button>
      <button data-t="faccao" onclick="tipo(this,'faccao')">Facções</button>
    </div>

    <% if (orgs.length === 0) { %>
      <div class="vazio">Não existe nenhuma organização cadastrada ainda.</div>
    <% } else { %>
    <table>
      <thead>
        <tr>
          <th>Organização</th>
          <th>Tipo</th>
          <th class="esconde-mob">Dono</th>
          <th class="num">Membros</th>
          <th class="num esconde-mob">Cargos</th>
          <th class="num">Caixa</th>
          <th></th>
        </tr>
      </thead>
      <tbody id="corpo">
        <% orgs.forEach(o => { %>
        <tr data-tipo="<%= o.tipo %>" data-busca="<%= (o.name + ' ' + o.slug + ' ' + (o.dono_nome || '') + ' ' + (o.cnpj || '')).toLowerCase() %>">
          <td>
            <div class="nome">
              <% if (o.has_icon_file) { %><img src="/api/corps/<%= o.id %>/icon" data-nome="<%= o.name %>" data-cor="<%= o.color || '#1D3F94' %>" onerror="sfSemFoto(this)" class="ico" alt="">
              <% } else if (o.icon_url) { %><img src="<%= fotoUrl(o.icon_url) %>" data-nome="<%= o.name %>" data-cor="<%= o.color || '#1D3F94' %>" onerror="sfSemFoto(this)" class="ico" alt="">
              <% } else { %><span class="bolinha" style="background:<%= o.color %>"></span><% } %>
              <span><%= o.name %><% if (o.is_active === false) { %> <span style="color:#B23227;font-size:0.72rem">(inativa)</span><% } %></span>
            </div>
            <div class="sub"><%= o.slug %><% if (o.cnpj) { %> · CNPJ <%= o.cnpj %><% } %></div>
          </td>
          <td><span class="tag t-<%= o.tipo %>"><%= o.rotulo %></span></td>
          <td class="esconde-mob"><%= o.dono_nome || '—' %></td>
          <td class="num"><%= o.membros %></td>
          <td class="num esconde-mob"><%= o.cargos %></td>
          <td class="num" style="color:<%= Number(o.saldo) > 0 ? '#1D7A45' : '#6B7480' %>">R$ <%= Number(o.saldo).toLocaleString('pt-BR') %></td>
          <td><a class="btn" href="<%= o.tipo === 'empresa' ? ('/empresas/' + o.id) : ('/dashboard/corp/' + o.id) %>">Gerenciar</a></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    <div class="vazio" id="semResultado" style="display:none">Nada bateu com a busca.</div>
    <% } %>
  </div>

  <script>
    var filtroTipo = '';
    function tipo(btn, t) {
      filtroTipo = t;
      document.querySelectorAll('.ferramentas button').forEach(function (b) { b.classList.remove('on'); });
      btn.classList.add('on');
      filtrar();
    }
    function filtrar() {
      var q = (document.getElementById('busca').value || '').trim().toLowerCase();
      var linhas = document.querySelectorAll('#corpo tr');
      var vistos = 0;
      linhas.forEach(function (tr) {
        var okT = !filtroTipo || tr.dataset.tipo === filtroTipo;
        var okQ = !q || (tr.dataset.busca || '').indexOf(q) !== -1;
        var mostra = okT && okQ;
        tr.style.display = mostra ? '' : 'none';
        if (mostra) vistos++;
      });
      var sem = document.getElementById('semResultado');
      if (sem) sem.style.display = vistos === 0 ? '' : 'none';
    }
  </script>
</body>
</html>
