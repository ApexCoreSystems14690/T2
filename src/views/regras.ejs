<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= modo === 'doc' ? d.titulo : 'Regras' %> — <%= c.nome %></title>
  <meta name="theme-color" content="#1C2127">
  <meta name="description" content="<%= modo === 'doc' ? (d.titulo + (d.versao ? ' v' + d.versao : '') + ' — ' + c.nome) : ('Regras da cidade ' + c.nome) %>">
  <style>
    /* [22/10] REGULAMENTO NATIVO. Papel de documento oficial em cima do concreto do site.
       Sumário fixo do lado, busca, cada artigo com endereço próprio (#art-2-5). */
    body { margin: 0; }
    .rg-topo { display: flex; align-items: center; gap: .9rem; padding: .55rem clamp(16px, 3vw, 28px); background: var(--asfalto); border-bottom: 3px solid var(--placa); position: sticky; top: 0; z-index: 40; flex-wrap: wrap; }
    .rg-topo .placa { color: inherit; }
    .rg-topo .onde { color: #C9D0D8; font-size: .88rem; display: flex; align-items: center; gap: .45rem; min-width: 0; }
    .rg-topo .onde b { color: #fff; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .rg-topo .of { background: var(--pista); color: #10131A; font-size: .62rem; font-weight: 800; padding: .15rem .3rem; border-radius: 2px; }
    .rg-topo .dir { margin-left: auto; display: flex; gap: .9rem; align-items: center; }
    .rg-topo .dir a { color: #AEB7C2; text-decoration: none; font-size: .86rem; display: inline-flex; gap: .35rem; align-items: center; }
    .rg-topo .dir a:hover { color: #fff; }

    .rg-docs { display: flex; gap: .4rem; flex-wrap: wrap; padding: .9rem clamp(16px, 3vw, 28px) 0; max-width: 1180px; margin: 0 auto; }
    .rg-docs a { text-decoration: none; color: var(--tinta-2); background: var(--papel); border: 1px solid var(--linha); border-radius: 999px; padding: .35rem .8rem; font-size: .85rem; font-weight: 600; display: inline-flex; align-items: center; gap: .4rem; }
    .rg-docs a.on { background: var(--asfalto); color: #fff; border-color: var(--asfalto); }
    .rg-docs a .mini { font-size: .68rem; font-weight: 800; padding: .05rem .3rem; border-radius: 3px; background: var(--alerta-bg); color: var(--alerta); }
    .rg-docs a.on .mini { background: var(--pista); color: #10131A; }

    .rg-casa { max-width: 1180px; margin: 0 auto; padding: 1rem clamp(16px, 3vw, 28px) 4rem; display: grid; grid-template-columns: 270px minmax(0, 1fr); gap: 1.6rem; align-items: start; }

    /* ---------- cabeçalho do documento ---------- */
    .rg-cabeca { grid-column: 1 / -1; background: var(--papel); border: 1px solid var(--linha); border-radius: var(--r); overflow: hidden; }
    .rg-cabeca .faixa { height: 8px; background: var(--placa); }
    .rg-cabeca.rascunho .faixa { background: repeating-linear-gradient(-45deg, var(--pista) 0 14px, #10131A 14px 28px); }
    .rg-cabeca .dentro { padding: 1.4rem clamp(16px, 3vw, 2rem) 1.3rem; display: grid; grid-template-columns: 1fr auto; gap: 1rem 2rem; align-items: end; }
    .rg-kicker { font-size: .74rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; color: var(--tinta-3); margin: 0 0 .5rem; }
    .rg-cabeca h1 { margin: 0; font-size: clamp(2.1rem, 5.6vw, 3.6rem); line-height: .95; color: var(--asfalto); }
    .rg-cabeca .sub { margin: .55rem 0 0; color: var(--tinta-2); font-size: 1.02rem; }
    .rg-selos { display: flex; flex-direction: column; align-items: flex-end; gap: .5rem; }
    .rg-versao { display: inline-flex; flex-direction: column; border: 1.5px solid #10131A; border-radius: 4px; overflow: hidden; background: #fff; line-height: 1; }
    .rg-versao span:first-child { background: var(--placa); color: #fff; font-size: 8px; font-weight: 700; letter-spacing: .16em; padding: 3px 8px; }
    .rg-versao span:last-child { font-stretch: 75%; font-variation-settings: "wdth" 75; font-weight: 800; font-size: 26px; padding: 4px 12px; text-align: center; color: #10131A; }
    .rg-status { font-size: .82rem; font-weight: 700; padding: .3rem .6rem; border-radius: 4px; display: inline-flex; align-items: center; gap: .4rem; }
    .rg-status.vigente { background: var(--ok-bg); color: var(--ok); }
    .rg-status.rascunho { background: #10131A; color: var(--pista); }
    .rg-meta { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: .4rem 1.6rem; margin: .2rem 0 0; padding-top: .9rem; border-top: 1px dashed var(--linha-2); font-size: .86rem; }
    .rg-meta div { display: flex; gap: .4rem; }
    .rg-meta dt { color: var(--tinta-3); }
    .rg-meta dd { margin: 0; color: var(--tinta); font-weight: 600; }
    .rg-acoes { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: .5rem; }
    .rg-acoes .btn { text-decoration: none; display: inline-flex; align-items: center; gap: .4rem; }

    /* ---------- sumário ---------- */
    .rg-lado { position: sticky; top: 76px; max-height: calc(100vh - 92px); display: flex; flex-direction: column; gap: .7rem; }
    .rg-busca { position: relative; }
    .rg-busca .ic { position: absolute; left: .7rem; top: 50%; transform: translateY(-50%); color: var(--tinta-3); }
    .rg-busca input { width: 100%; padding: .6rem .7rem .6rem 2.1rem; border: 1px solid var(--linha-2); border-radius: var(--rs); background: var(--papel); font-size: .92rem; }
    .rg-busca kbd { position: absolute; right: .55rem; top: 50%; transform: translateY(-50%); font: inherit; font-size: .7rem; color: var(--tinta-3); border: 1px solid var(--linha-2); border-radius: 3px; padding: 0 .3rem; }
    .rg-achados { font-size: .8rem; color: var(--tinta-3); min-height: 1.1em; }
    .rg-sumario { background: var(--papel); border: 1px solid var(--linha); border-radius: var(--r); overflow: auto; padding: .4rem 0; }
    .rg-sumario a { display: grid; grid-template-columns: 26px 1fr; gap: .4rem; padding: .42rem .9rem; color: var(--tinta-2); text-decoration: none; font-size: .88rem; border-left: 3px solid transparent; line-height: 1.25; }
    .rg-sumario a span:first-child { color: var(--tinta-3); font-variant-numeric: tabular-nums; font-weight: 700; }
    .rg-sumario a:hover { background: var(--papel-2); color: var(--tinta); }
    .rg-sumario a.on { border-left-color: var(--pista); color: var(--tinta); font-weight: 700; background: var(--papel-2); }
    .rg-sumario a.vazio { opacity: .35; }
    .rg-lado details { display: none; }

    /* ---------- o texto ---------- */
    .rg-papel { background: var(--papel); border: 1px solid var(--linha); border-radius: var(--r); padding: clamp(1rem, 3vw, 2.2rem) clamp(1rem, 3.4vw, 2.6rem); min-width: 0; }
    .rg-papel > .rg-nota:first-child { margin-top: 0; }
    .rg-nota { background: var(--papel-2); border-left: 3px solid var(--placa); border-radius: 0 var(--rs) var(--rs) 0; padding: .7rem .9rem; margin: 0 0 .8rem; color: var(--tinta-2); font-size: .92rem; }
    .rg-cap { padding-top: 1.6rem; margin-top: 1.4rem; border-top: 2px solid var(--asfalto); scroll-margin-top: 80px; }
    .rg-papel > .rg-cap:first-of-type { border-top: 0; margin-top: .4rem; padding-top: .4rem; }
    .rg-cap h2 { margin: 0 0 1rem; font-size: clamp(1.5rem, 3.4vw, 2.1rem); line-height: 1; color: var(--asfalto); display: flex; flex-direction: column; gap: .35rem; }
    .rg-capn { font-size: .72rem; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; color: var(--placa); font-stretch: 100%; font-variation-settings: "wdth" 100; }
    .rg-sub { margin: 1.4rem 0 .6rem; font-size: 1.02rem; color: var(--asfalto); display: flex; align-items: center; gap: .6rem; }
    .rg-sub::after { content: ""; flex: 1; height: 1px; background: var(--linha); }
    .rg-art { position: relative; padding: .5rem .7rem .5rem .8rem; margin: 0 -.7rem 0 -.8rem; border-left: 3px solid transparent; border-radius: 0 var(--rs) var(--rs) 0; scroll-margin-top: 84px; }
    .rg-art p { margin: 0; line-height: 1.6; font-size: .98rem; }
    .rg-artn { font-weight: 800; color: var(--placa); text-decoration: none; white-space: nowrap; margin-right: .2rem; }
    .rg-artn:hover { text-decoration: underline; }
    .rg-art:target, .rg-art.piscar { background: #FFF8DC; border-left-color: var(--pista); }
    .rg-art .copiar { position: absolute; right: .3rem; top: .45rem; opacity: 0; border: 0; background: transparent; color: var(--tinta-3); cursor: pointer; padding: .2rem; border-radius: 4px; }
    .rg-art:hover .copiar, .rg-art .copiar:focus-visible { opacity: 1; }
    .rg-art .copiar:hover { color: var(--placa); background: var(--papel-2); }
    .rg-lista { margin: .35rem 0 .1rem 1.1rem; padding: 0; }
    .rg-lista li { margin: .2rem 0; line-height: 1.5; }
    .rg-p { line-height: 1.6; margin: .4rem 0; }
    .rg-tag { display: inline-block; font-size: .66rem; font-weight: 800; letter-spacing: .04em; text-transform: uppercase; padding: .1rem .35rem; border-radius: 3px; vertical-align: .12em; margin-right: .15rem; }
    .rg-novo { background: var(--placa); color: #fff; }
    .rg-alterado { background: var(--pista); color: #10131A; }
    .rg-ref { color: var(--placa); text-decoration: none; border-bottom: 1px dotted currentColor; }
    .rg-ref:hover { border-bottom-style: solid; }
    .rg-tabela { overflow-x: auto; margin: .6rem 0 1rem; border: 1px solid var(--linha); border-radius: var(--rs); }
    .rg-tabela table { font-size: .9rem; }
    .rg-tabela th { background: var(--asfalto) !important; color: #fff !important; text-align: left; padding: .55rem .75rem; font-size: .78rem; letter-spacing: .04em; }
    .rg-tabela td { padding: .55rem .75rem; vertical-align: top; line-height: 1.45; }
    .rg-tabela tr:nth-child(even) td { background: #FAFBFC; }
    .rg-tabela ul { margin: 0; padding-left: 1rem; }
    .rg-tabela li { margin: .18rem 0; }
    .rg-vv th:first-child { background: var(--ok) !important; }
    .rg-vv th:last-child { background: var(--perigo) !important; }
    .rg-vv td { width: 50%; }
    .rg-oculto { display: none !important; }
    mark { background: #FFE58A; color: inherit; padding: 0 1px; border-radius: 2px; }
    .rg-nada { display: none; text-align: center; color: var(--tinta-3); padding: 2rem 0; }

    /* ---------- lista de documentos ---------- */
    .rg-lista-docs { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1rem; }
    .rg-cartao { display: block; text-decoration: none; color: var(--tinta); background: var(--papel); border: 1px solid var(--linha); border-radius: var(--r); overflow: hidden; transition: transform .15s ease, box-shadow .15s ease; }
    .rg-cartao:hover { transform: translateY(-2px); box-shadow: 0 10px 24px rgba(22,26,31,.1); }
    .rg-cartao .faixa { height: 6px; background: var(--placa); }
    .rg-cartao.rascunho .faixa { background: repeating-linear-gradient(-45deg, var(--pista) 0 10px, #10131A 10px 20px); }
    .rg-cartao .dentro { padding: 1.1rem 1.2rem 1.2rem; }
    .rg-cartao h2 { margin: 0 0 .3rem; font-size: 1.6rem; line-height: 1; color: var(--asfalto); }
    .rg-cartao p { margin: 0 0 .9rem; color: var(--tinta-2); font-size: .92rem; }
    .rg-cartao .pe { display: flex; gap: .6rem; align-items: center; font-size: .82rem; color: var(--tinta-3); }
    .rg-cartao .pe .ir { margin-left: auto; color: var(--placa); font-weight: 700; }
    .rg-titulo-lista { grid-column: 1 / -1; }
    .rg-titulo-lista h1 { margin: .4rem 0 .2rem; font-size: clamp(2.2rem, 6vw, 3.4rem); color: var(--asfalto); }
    .rg-titulo-lista p { margin: 0; color: var(--tinta-2); }

    @media (max-width: 900px) {
      .rg-casa { grid-template-columns: 1fr; }
      .rg-lado { position: static; max-height: none; }
      .rg-lado .rg-sumario { display: none; }
      .rg-lado details { display: block; background: var(--papel); border: 1px solid var(--linha); border-radius: var(--r); }
      .rg-lado details summary { padding: .7rem .9rem; font-weight: 700; cursor: pointer; }
      .rg-lado details .rg-sumario { display: block; border: 0; border-top: 1px solid var(--linha); border-radius: 0; max-height: 50vh; }
      .rg-cabeca .dentro { grid-template-columns: 1fr; }
      .rg-selos { flex-direction: row; align-items: center; justify-content: flex-start; flex-wrap: wrap; }
      .rg-busca kbd { display: none; }
    }
    @media (max-width: 560px) {
      .rg-topo .dir .txt { display: none; }
      .rg-vv td { width: auto; }
    }
    @media print {
      .rg-topo, .rg-docs, .rg-lado, .rg-acoes, .copiar { display: none !important; }
      .rg-casa { display: block; padding: 0; }
      .rg-papel, .rg-cabeca { border: 0; }
      body { background: #fff !important; }
    }
  </style>
  <link rel="stylesheet" href="/sf.css">
</head>
<body>
  <%
    var base = '/cidade/' + c.slug + '/regras';
    var naCidade = !!cidade;
  %>
  <header class="rg-topo">
    <%- include('partials/placa') %>
    <%# com a cidade na sessão a placa já traz o chip da cidade; sem ela, mostra de qual cidade é a regra %>
    <% if (!naCidade) { %><span class="onde"><svg class="ic" aria-hidden="true"><use href="/icones.svg#livro"/></svg><b><%= c.nome %></b><% if (c.tipo === 'oficial') { %><span class="of">Oficial</span><% } %></span><% } %>
    <nav class="dir" aria-label="Navegação">
      <a href="/"><svg class="ic" aria-hidden="true"><use href="/icones.svg#voltar"/></svg><span class="txt">Cidades</span></a>
      <% if (naCidade && user) { %>
        <a href="/painel"><svg class="ic" aria-hidden="true"><use href="/icones.svg#casa"/></svg><span class="txt">Painel</span></a>
      <% } else { %>
        <a href="/cidade/<%= c.slug %>"><svg class="ic" aria-hidden="true"><use href="/icones.svg#casa"/></svg><span class="txt">Entrar na cidade</span></a>
      <% } %>
    </nav>
  </header>

  <% if (docs.length > 1 || modo === 'doc') { %>
  <nav class="rg-docs" aria-label="Documentos desta cidade">
    <a href="<%= base %>" class="<%= modo === 'lista' ? 'on' : '' %>">Todos</a>
    <% docs.forEach(function (x) { %>
      <a href="<%= base %>/<%= x.slug %>" class="<%= (d && d.slug === x.slug) ? 'on' : '' %>"><%= x.titulo %><% if (x.status === 'rascunho') { %><span class="mini">Rascunho</span><% } %></a>
    <% }) %>
  </nav>
  <% } %>

  <main class="rg-casa">
  <% if (modo === 'lista') { %>
    <section class="rg-titulo-lista">
      <p class="rg-kicker">Documentos oficiais · <%= c.nome %></p>
      <h1>Regras da cidade</h1>
      <p>Valem só nesta cidade. Ao entrar no servidor ou no jogo, você declara que leu e aceitou.</p>
    </section>
    <div class="rg-lista-docs">
      <% if (!docs.length) { %>
        <p class="muted">Esta cidade ainda não publicou o regulamento.</p>
      <% } %>
      <% docs.forEach(function (x) { %>
      <a class="rg-cartao <%= x.status %>" href="<%= base %>/<%= x.slug %>">
        <span class="faixa" style="display:block"></span>
        <span class="dentro" style="display:block">
          <h2><%= x.titulo %></h2>
          <% if (x.subtitulo) { %><p><%= x.subtitulo %></p><% } %>
          <span class="pe">
            <% if (x.versao) { %><b>v<%= x.versao %></b><% } %>
            <span><%= x.status === 'vigente' ? (x.vigente_desde ? 'Vigente desde ' + dataBR(x.vigente_desde) : 'Vigente') : (x.aviso || 'Rascunho') %></span>
            <span class="ir">Ler</span>
          </span>
        </span>
      </a>
      <% }) %>
    </div>
    <% if (podeEditar) { %><p style="grid-column:1/-1"><a class="btn sec" href="/painel/regras"><svg class="ic" aria-hidden="true"><use href="/icones.svg#lapis"/></svg>Editar regras</a></p><% } %>
  <% } else { %>
    <section class="rg-cabeca <%= d.status %>">
      <div class="faixa"></div>
      <div class="dentro">
        <div>
          <p class="rg-kicker">Documento oficial · <%= c.nome %></p>
          <h1><%= d.titulo %></h1>
          <% if (d.subtitulo) { %><p class="sub"><%= d.subtitulo %></p><% } %>
        </div>
        <div class="rg-selos">
          <% if (d.versao) { %><span class="rg-versao" aria-label="Versão <%= d.versao %>"><span>VERSÃO</span><span><%= d.versao %></span></span><% } %>
          <% if (d.status === 'vigente') { %>
            <span class="rg-status vigente"><svg class="ic" aria-hidden="true"><use href="/icones.svg#check"/></svg><%= d.vigente_desde ? 'Vigente desde ' + dataBR(d.vigente_desde) : 'Vigente' %></span>
          <% } else { %>
            <span class="rg-status rascunho"><svg class="ic" aria-hidden="true"><use href="/icones.svg#alerta"/></svg><%= d.aviso || 'Rascunho: ainda não vale' %></span>
          <% } %>
        </div>
        <% var meta = Array.isArray(d.meta) ? d.meta : []; if (meta.length) { %>
        <dl class="rg-meta">
          <% meta.forEach(function (m) { %><div><dt><%= m.k %></dt><dd><%= m.v %></dd></div><% }) %>
          <div><dt>Artigos</dt><dd><%= r.artigos %></dd></div>
        </dl>
        <% } %>
        <div class="rg-acoes">
          <% if (d.tem_pdf) { %><a class="btn sec" href="<%= base %>/<%= d.slug %>/pdf" target="_blank" rel="noopener"><svg class="ic" aria-hidden="true"><use href="/icones.svg#baixar"/></svg>Baixar PDF</a><% } %>
          <button class="btn sec" type="button" id="rg-copiar-doc"><svg class="ic" aria-hidden="true"><use href="/icones.svg#elo"/></svg>Copiar link</button>
          <% if (podeEditar) { %><a class="btn sec" href="/painel/regras?doc=<%= d.slug %>"><svg class="ic" aria-hidden="true"><use href="/icones.svg#lapis"/></svg>Editar</a><% } %>
        </div>
      </div>
    </section>

    <aside class="rg-lado">
      <label class="rg-busca">
        <svg class="ic" aria-hidden="true"><use href="/icones.svg#busca"/></svg>
        <input id="rg-q" type="search" placeholder="Buscar: RDM, mandado, 4.5…" autocomplete="off" aria-label="Buscar no regulamento">
        <kbd>/</kbd>
      </label>
      <div class="rg-achados" id="rg-achados" aria-live="polite"></div>
      <% var sumario = r.capitulos.map(function (x) { return '<a href="#' + x.id + '" data-cap="' + x.id + '"><span>' + x.n + '</span><span>' + x.titulo.replace(/\*\*/g, '') + '</span></a>'; }).join(''); %>
      <nav class="rg-sumario" aria-label="Capítulos"><%- sumario %></nav>
      <details><summary>Capítulos (<%= r.capitulos.length %>)</summary><nav class="rg-sumario"><%- sumario %></nav></details>
    </aside>

    <article class="rg-papel" id="rg-texto">
      <%- r.html %>
      <p class="rg-nada" id="rg-nada">Nada encontrado com essa busca.</p>
    </article>
  <% } %>
  </main>

<% if (modo === 'doc') { %>
<script>
(function () {
  var texto = document.getElementById('rg-texto');
  var q = document.getElementById('rg-q');
  var achados = document.getElementById('rg-achados');
  var nada = document.getElementById('rg-nada');
  var links = Array.prototype.slice.call(document.querySelectorAll('.rg-sumario a'));
  var caps = Array.prototype.slice.call(texto.querySelectorAll('.rg-cap'));
  var unidades = Array.prototype.slice.call(texto.querySelectorAll('.rg-art, .rg-tabela, .rg-nota, .rg-p, .rg-sub, .rg-lista'))
    .filter(function (el) { return !el.parentElement.closest('.rg-art'); });
  // copiar link de um artigo
  texto.querySelectorAll('.rg-art').forEach(function (a) {
    var b = document.createElement('button');
    b.type = 'button'; b.className = 'copiar'; b.title = 'Copiar link deste artigo';
    b.innerHTML = '<svg class="ic" aria-hidden="true"><use href="/icones.svg#elo"/></svg>';
    b.onclick = function () { copiar(location.origin + location.pathname + '#' + a.id, b); history.replaceState(null, '', '#' + a.id); };
    a.appendChild(b);
  });
  var original = new Map();
  unidades.forEach(function (el) { original.set(el, el.innerHTML); });

  function copiar(t, el) {
    var ok = function () { var o = el.title; el.title = 'Copiado!'; el.classList.add('ok'); setTimeout(function () { el.title = o; }, 1500); };
    if (navigator.clipboard) navigator.clipboard.writeText(t).then(ok, function () {}); else ok();
  }
  var bd = document.getElementById('rg-copiar-doc');
  if (bd) bd.onclick = function () { copiar(location.origin + location.pathname, bd); bd.lastChild.textContent = 'Link copiado'; setTimeout(function () { bd.lastChild.textContent = 'Copiar link'; }, 1600); };

  // busca
  function semAcento(s) { return s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase(); }
  function marcar(el, termo) {
    var w = document.createTreeWalker(el, NodeFilter.SHOW_TEXT, null);
    var nos = []; while (w.nextNode()) nos.push(w.currentNode);
    nos.forEach(function (n) {
      var t = n.nodeValue, ts = semAcento(t), i = ts.indexOf(termo);
      if (i < 0 || n.parentElement.closest('button')) return;
      var frag = document.createDocumentFragment(), pos = 0;
      while (i >= 0) {
        frag.appendChild(document.createTextNode(t.slice(pos, i)));
        var m = document.createElement('mark'); m.textContent = t.slice(i, i + termo.length); frag.appendChild(m);
        pos = i + termo.length; i = ts.indexOf(termo, pos);
      }
      frag.appendChild(document.createTextNode(t.slice(pos)));
      n.parentNode.replaceChild(frag, n);
    });
  }
  var timer;
  function buscar() {
    var termo = semAcento(q.value.trim());
    var n = 0;
    unidades.forEach(function (el) {
      el.innerHTML = original.get(el);
      if (!termo) { el.classList.remove('rg-oculto'); return; }
      var bate = semAcento(el.textContent).indexOf(termo) >= 0;
      el.classList.toggle('rg-oculto', !bate);
      if (bate) { n++; marcar(el, termo); }
    });
    // os botões de copiar foram junto no innerHTML: religa
    if (termo) {}
    caps.forEach(function (cap) {
      var vis = !termo || cap.querySelector('.rg-art:not(.rg-oculto), .rg-tabela:not(.rg-oculto), .rg-nota:not(.rg-oculto), .rg-p:not(.rg-oculto)');
      cap.classList.toggle('rg-oculto', !vis);
      links.forEach(function (l) { if (l.dataset.cap === cap.id) l.classList.toggle('vazio', !vis); });
    });
    achados.textContent = termo ? (n ? n + (n === 1 ? ' trecho encontrado' : ' trechos encontrados') : '') : '';
    nada.style.display = termo && !n ? 'block' : 'none';
    religarCopiar();
  }
  function religarCopiar() {
    texto.querySelectorAll('.rg-art .copiar').forEach(function (b) {
      var a = b.closest('.rg-art');
      b.onclick = function () { copiar(location.origin + location.pathname + '#' + a.id, b); history.replaceState(null, '', '#' + a.id); };
    });
  }
  q.addEventListener('input', function () { clearTimeout(timer); timer = setTimeout(buscar, 120); });
  q.addEventListener('keydown', function (e) { if (e.key === 'Escape') { q.value = ''; buscar(); } });
  document.addEventListener('keydown', function (e) {
    if (e.key === '/' && document.activeElement !== q && !/input|textarea/i.test(document.activeElement.tagName)) { e.preventDefault(); q.focus(); }
  });

  // capítulo atual no sumário
  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function (es) {
      es.forEach(function (e) {
        if (e.isIntersecting) links.forEach(function (l) { l.classList.toggle('on', l.dataset.cap === e.target.id); });
      });
    }, { rootMargin: '-90px 0px -70% 0px' });
    caps.forEach(function (c) { io.observe(c); });
  }
  // fecha o sumário do celular ao escolher
  document.querySelectorAll('.rg-lado details a').forEach(function (a) { a.addEventListener('click', function () { a.closest('details').open = false; }); });
  // chegou por link de artigo: pisca
  function piscar() {
    var el = location.hash && document.getElementById(location.hash.slice(1));
    if (el && el.classList.contains('rg-art')) { el.classList.add('piscar'); setTimeout(function () { el.classList.remove('piscar'); }, 2200); }
  }
  window.addEventListener('hashchange', piscar); piscar();
})();
</script>
<% } %>
</body>
</html>
